{
  "name": "cworkplace",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
