{
  "name": "cworkplace",
  "version": "1.1.6",
  "private": true,
  "description": "Self-hosted Workplace for one company: groups, feed, chat, calls, calendar and notifications.",
  "keywords": [
    "workplace",
    "intranet",
    "chat",
    "groups",
    "video-calls",
    "calendar",
    "self-hosted",
    "bun",
    "elysia",
    "zenstack"
  ],
  "homepage": "https://github.com/cuongboi/cworkspace#readme",
  "bugs": {
    "url": "https://github.com/cuongboi/cworkspace/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cuongboi/cworkspace.git"
  },
  "license": "UNLICENSED",
  "author": "Cuong Nguyen",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "bun run --filter @app/web build && bun run --filter @app/api build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "typecheck": "bun run check-types",
    "test": "bun --cwd apps/api run test",
    "release": "bumpp package.json apps/api/package.json --commit \"chore: release v%s\" --tag \"v%s\" --push",
    "docker:build": "docker build -t cworkplace ."
  },
  "devDependencies": {
    "bumpp": "^12.3.0",
    "dotenv-cli": "^11.0.0",
    "oxfmt": "^0.73.0",
    "oxlint": "^1.88.0",
    "prettier": "3.9.6",
    "turbo": "^2.11.8",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": ">=24"
  },
  "devEngines": {
    "packageManager": {
      "name": "bun",
      "version": "1.4.3"
    }
  }
}