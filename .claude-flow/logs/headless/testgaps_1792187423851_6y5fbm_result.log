        "language": "ts",
        "code": "// In apps/api/tests/conversations.test.ts  (integration — needs real DB)\nimport { describe, it, expect, beforeAll } from \"bun:test\";\n// ... setup: create org, alice, bob using helpers from policies.test.ts\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"returns 400 when userId is the caller's own id\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie: aliceCookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgA.id, userId: alice.id }),\n      })\n    );\n    expect(res.status).toBe(400);\n    const json = await res.json();\n    expect(json.error.message).toBe(\"Cannot message yourself\");\n  });\n\n  it(\"creates a new direct conversation and returns 201\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie: aliceCookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgA.id, userId: bob.id }),\n      })\n    );\n    expect(res.status).toBe(201);\n    const { data } = await res.json();\n    expect(data.id).toBeTruthy();\n    conversationId = data.id;\n  });\n\n  it(\"returns existing conversation and 200 on second call (idempotent)\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie: aliceCookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgA.id, userId: bob.id }),\n      })\n    );\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.id).toBe(conversationId); // same id\n  });\n\n  it(\"rejects cross-org messaging (carol is in org B)\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie: aliceCookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgA.id, userId: carol.id }),\n      })\n    );\n    expect(res.status).toBe(403);\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/uploads.test.ts\ndescribe(\"POST /api/uploads content-type blocking\", () => {\n  const BLOCKED_TYPES = [\n    \"text/html\",\n    \"application/javascript\",\n    \"application/x-javascript\",\n    \"application/ecmascript\",\n    \"image/svg+xml\",\n    \"application/xhtml+xml\",\n  ];\n  const ALLOWED_TYPES = [\"image/png\", \"image/jpeg\", \"application/pdf\", \"video/mp4\"];\n\n  for (const mimeType of BLOCKED_TYPES) {\n    it(`blocks ${mimeType}`, async () => {\n      const res = await upload({ mimeType });\n      expect(res.status).toBe(400);\n      const json = await res.json();\n      expect(json.error.code).toBe(\"INVALID_INPUT\");\n    });\n  }\n\n  for (const mimeType of ALLOWED_TYPES) {\n    it(`allows ${mimeType}`, async () => {\n      // storage not configured in test env → 502, but gets past the type check\n      const res = await upload({ mimeType });\n      expect(res.status).not.toBe(400);\n    });\n  }\n\n  it(\"rejects orgVisible:true on non-image types\", async () => {\n    const res = await upload({ mimeType: \"application/pdf\", orgVisible: true });\n    expect(res.status).toBe(400);\n    const { error } = await res.json();\n    expect(error.message).toMatch(/images/i);\n  });\n\n  it(\"allows orgVisible:true on image types\", async () => {\n    const res = await upload({ mimeType: \"image/png\", orgVisible: true });\n    // gets past validation; fails at storage (502) in test env\n    expect(res.status).not.toBe(400);\n  });\n});\n\n// Note: test the BLOCKED regex directly as a unit test since storage needs S3:\nimport { describe, it, expect } from \"bun:test\";\nconst BLOCKED = /^(text\\/html|application\\/(x-)?(javascript|ecmascript)|image\\/svg\\+xml|application\\/xhtml\\+xml)$/i;\ndescribe(\"BLOCKED mime type regex\", () => {\n  it(\"blocks application/JavaScript (case-insensitive)\", () =>\n    expect(BLOCKED.test(\"application/JavaScript\")).toBe(true));\n  it(\"blocks application/x-javascript\", () =>\n    expect(BLOCKED.test(\"application/x-javascript\")).toBe(true));\n  it(\"does not block application/json\", () =>\n    expect(BLOCKED.test(\"application/json\")).toBe(false));\n  it(\"does not block image/png\", () =>\n    expect(BLOCKED.test(\"image/png\")).toBe(false));\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/rtc.test.ts\nimport { describe, it, expect } from \"bun:test\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  it(\"returns 401 without auth\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  it(\"returns STUN server without TURN when TURN_SECRET is unset\", async () => {\n    // env.TURN_SECRET = \"\" → TURN block skipped\n    const res = await app.handle(\n      new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie: aliceCookie } })\n    );\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.iceServers).toHaveLength(1);\n    expect(data.iceServers[0].urls).toContain(\"stun:stun.l.google.com:19302\");\n    expect(data.iceServers[0].username).toBeUndefined();\n    expect(res.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n  });\n\n  it(\"returns STUN + TURN with HMAC credential when TURN_SECRET is set\", async () => {\n    // Temporarily set env or use a test app instance with TURN_SECRET set\n    // ...\n    const { data } = await res.json();\n    expect(data.iceServers).toHaveLength(2);\n    const turn = data.iceServers[1];\n    expect(turn.username).toMatch(/^\\d+:/);       // timestamp:userId\n    expect(turn.credential).toBeTruthy();           // base64 HMAC\n    expect(data.ttl).toBe(6 * 60 * 60);           // 6h\n  });\n});\n\n// Unit test HMAC computation in isolation:\nimport { createHmac } from \"node:crypto\";\ndescribe(\"TURN credential HMAC\", () => {\n  it(\"credential is sha1-hmac of username with TURN_SECRET\", () => {\n    const secret = \"test-secret\";\n    const username = \"9999999999:user-id-123\";\n    const expected = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    // re-compute same way as rtcRoute does\n    expect(expected).toMatch(/^[A-Za-z0-9+/=]+$/); // valid base64\n  });\n});"
      },
