        "content": "\n```ts\n// apps/api/tests/uploads.test.ts\ndescribe(\"POST /api/uploads content-type blocking\", () => {\n  const BLOCKED_TYPES = [\n    \"text/html\",\n    \"application/javascript\",\n    \"application/x-javascript\",\n    \"application/ecmascript\",\n    \"image/svg+xml\",\n    \"application/xhtml+xml\",\n  ];\n  const ALLOWED_TYPES = [\"image/png\", \"image/jpeg\", \"application/pdf\", \"video/mp4\"];\n\n  for (const mimeType of BLOCKED_TYPES) {\n    it(`blocks ${mimeType}`, async () => {\n      const res = await upload({ mimeType });\n      expect(res.status).toBe(400);\n      const json = await res.json();\n      expect(json.error.code).toBe(\"INVALID_INPUT\");\n    });\n  }\n\n  for (const mimeType of ALLOWED_TYPES) {\n    it(`allows ${mimeType}`, async () => {\n      // storage not configured in test env → 502, but gets past the type check\n      const res = await upload({ mimeType });\n      expect(res.status).not.toBe(400);\n    });\n  }\n\n  it(\"rejects orgVisible:true on non-image types\", async () => {\n    const res = await upload({ mimeType: \"application/pdf\", orgVisible: true });\n    expect(res.status).toBe(400);\n    const { error } = await res.json();\n    expect(error.message).toMatch(/images/i);\n  });\n\n  it(\"allows orgVisible:true on image types\", async () => {\n    const res = await upload({ mimeType: \"image/png\", orgVisible: true });\n    // gets past validation; fails at storage (502) in test env\n    expect(res.status).not.toBe(400);\n  });\n});\n\n// Note: test the BLOCKED regex directly as a unit test since storage needs S3:\nimport { describe, it, expect } from \"bun:test\";\nconst BLOCKED = /^(text\\/html|application\\/(x-)?(javascript|ecmascript)|image\\/svg\\+xml|application\\/xhtml\\+xml)$/i;\ndescribe(\"BLOCKED mime type regex\", () => {\n  it(\"blocks application/JavaScript (case-insensitive)\", () =>\n    expect(BLOCKED.test(\"application/JavaScript\")).toBe(true));\n  it(\"blocks application/x-javascript\", () =>\n    expect(BLOCKED.test(\"application/x-javascript\")).toBe(true));\n  it(\"does not block application/json\", () =>\n    expect(BLOCKED.test(\"application/json\")).toBe(false));\n  it(\"does not block image/png\", () =>\n    expect(BLOCKED.test(\"image/png\")).toBe(false));\n});\n```\n\n---\n\n",
