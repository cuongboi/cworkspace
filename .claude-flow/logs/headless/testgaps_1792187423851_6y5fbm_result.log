        "language": "ts",
        "code": "// apps/api/tests/hub.test.ts\nimport { describe, it, expect, beforeEach } from \"bun:test\";\nimport { Conn, emitTo, emitToUsers, emitToRoom, joinUserToRoom, removeUserFromRoom,\n         connectionCount, onlineUserIds, register, unregister, rooms, clearRoom } from \"../src/websocket/hub\";\n\nfunction makeSocket() {\n  const sent: string[] = [];\n  return {\n    raw: { send: (d: string) => sent.push(d), close: () => {} } as any,\n    sent,\n  };\n}\n\nfunction makeUser(id = crypto.randomUUID()) {\n  return { id, name: \"Test\", email: \"t@t.com\", image: null, role: \"user\" } as any;\n}\n\ndescribe(\"Conn.dispatch\", () => {\n  it(\"calls the registered handler with a plain-object payload\", () => {\n    const { raw } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    let received: unknown;\n    conn.on(\"typing\", (payload) => { received = payload; });\n    conn.dispatch(\"typing\", { conversationId: \"abc\" });\n    expect(received).toEqual({ conversationId: \"abc\" });\n  });\n\n  it(\"coerces non-object payloads to {}\", () => {\n    const { raw } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    let received: unknown;\n    conn.on(\"typing\", (payload) => { received = payload; });\n    conn.dispatch(\"typing\", \"not-an-object\");\n    expect(received).toEqual({});\n  });\n\n  it(\"sends ack for unknown event when reqId is set\", () => {\n    const { raw, sent } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    conn.dispatch(\"no:such:event\", {}, 42);\n    const frame = JSON.parse(sent[0]);\n    expect(frame.ack).toBe(42);\n    expect(frame.res.ok).toBe(false);\n  });\n\n  it(\"sends ack on handler throw\", () => {\n    const { raw, sent } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    conn.on(\"typing\", () => { throw new Error(\"boom\"); });\n    conn.dispatch(\"typing\", {}, 7);\n    const frame = JSON.parse(sent[0]);\n    expect(frame.ack).toBe(7);\n    expect(frame.res.ok).toBe(false);\n  });\n\n  it(\"does not ack fire-and-forget (no reqId)\", () => {\n    const { raw, sent } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    conn.on(\"typing\", () => {});\n    conn.dispatch(\"typing\", {});\n    expect(sent).toHaveLength(0);\n  });\n});\n\ndescribe(\"Conn.join / leave / rooms\", () => {\n  it(\"join adds connection to room\", () => {\n    const conn = new Conn(makeSocket().raw, makeUser());\n    conn.join(\"test-room\");\n    expect(conn.rooms.has(\"test-room\")).toBe(true);\n  });\n\n  it(\"leave removes connection and cleans empty room from map\", () => {\n    const conn = new Conn(makeSocket().raw, makeUser());\n    conn.join(\"solo-room\");\n    conn.leave(\"solo-room\");\n    expect(conn.rooms.has(\"solo-room\")).toBe(false);\n    // emitTo to now-empty room should send nothing (no throw)\n    expect(() => emitTo([\"solo-room\"], \"presence\", { userId: \"x\", online: true })).not.toThrow();\n  });\n});\n\ndescribe(\"Conn.dispose\", () => {\n  it(\"calls all close handlers once\", () => {\n    const conn = new Conn(makeSocket().raw, makeUser());\n    let count = 0;\n    conn.onClose(() => { count++; });\n    conn.onClose(() => { count++; });\n    conn.dispose();\n    expect(count).toBe(2);\n  });\n\n  it(\"leaves all rooms on dispose\", () => {\n    const conn = new Conn(makeSocket().raw, makeUser());\n    conn.join(\"r1\"); conn.join(\"r2\");\n    conn.dispose();\n    expect(conn.rooms.size).toBe(0);\n  });\n});\n\ndescribe(\"Conn.broadcast\", () => {\n  it(\"sends to room members except self\", () => {\n    const user1 = makeUser(); const user2 = makeUser();\n    const { raw: raw1, sent: sent1 } = makeSocket();\n    const { raw: raw2, sent: sent2 } = makeSocket();\n    const c1 = new Conn(raw1, user1); const c2 = new Conn(raw2, user2);\n    c1.join(\"room\"); c2.join(\"room\");\n    c1.broadcast(\"room\", \"presence\", { userId: user1.id, online: true });\n    expect(sent1).toHaveLength(0);     // c1 excluded\n    expect(sent2).toHaveLength(1);     // c2 receives\n    // cleanup\n    c1.leave(\"room\"); c2.leave(\"room\");\n  });\n});\n\ndescribe(\"emitTo deduplication\", () => {\n  it(\"delivers once when conn is in multiple target rooms\", () => {\n    const { raw, sent } = makeSocket();\n    const conn = new Conn(raw, makeUser());\n    conn.join(\"r1\"); conn.join(\"r2\");\n    emitTo([\"r1\", \"r2\"], \"presence\", { userId: \"u\", online: true });\n    expect(sent).toHaveLength(1); // deduped\n    conn.leave(\"r1\"); conn.leave(\"r2\");\n  });\n});\n\ndescribe(\"connectionCount / onlineUserIds\", () => {\n  it(\"tracks online state across register/unregister\", () => {\n    const user = makeUser();\n    const conn = new Conn(makeSocket().raw, user);\n    register(conn);\n    expect(connectionCount(user.id)).toBe(1);\n    expect(onlineUserIds().has(user.id)).toBe(true);\n    unregister(conn);\n    expect(connectionCount(user.id)).toBe(0);\n    expect(onlineUserIds().has(user.id)).toBe(false);\n  });\n\n  it(\"count stays > 0 until last connection closes (multi-tab)\", () => {\n    const user = makeUser();\n    const c1 = new Conn(makeSocket().raw, user);\n    const c2 = new Conn(makeSocket().raw, user);\n    register(c1); register(c2);\n    expect(connectionCount(user.id)).toBe(2);\n    unregister(c1);\n    expect(connectionCount(user.id)).toBe(1);\n    expect(onlineUserIds().has(user.id)).toBe(true);\n    unregister(c2);\n    expect(connectionCount(user.id)).toBe(0);\n  });\n});\n\ndescribe(\"joinUserToRoom / removeUserFromRoom\", () => {\n  it(\"joins all connections of a user to a new room\", () => {\n    const user = makeUser();\n    const { raw: r1, sent: s1 } = makeSocket();\n    const { raw: r2, sent: s2 } = makeSocket();\n    const c1 = new Conn(r1, user); const c2 = new Conn(r2, user);\n    register(c1); register(c2);\n    joinUserToRoom(user.id, \"group:x\");\n    emitToRoom(\"group:x\", \"group:changed\", { groupId: \"x\" });\n    expect(s1).toHaveLength(1);\n    expect(s2).toHaveLength(1);\n    unregister(c1); unregister(c2);\n  });\n});\n\ndescribe(\"clearRoom\", () => {\n  it(\"removes all connections from a room\", () => {\n    const u1 = makeUser(); const u2 = makeUser();\n    const c1 = new Conn(makeSocket().raw, u1);\n    const c2 = new Conn(makeSocket().raw, u2);\n    c1.join(\"call:z\"); c2.join(\"call:z\");\n    clearRoom(\"call:z\");\n    expect(c1.rooms.has(\"call:z\")).toBe(false);\n    expect(c2.rooms.has(\"call:z\")).toBe(false);\n  });\n});"
      },
