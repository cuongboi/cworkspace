ation when userId !== actorId\", async () => {\n    const creates: unknown[] = [];\n    mock.module(\"../src/lib/db\", () => ({\n      db: { notification: { create: async (args: unknown) => { creates.push(args); } } },\n    }));\n    const { notify } = await import(\"../src/server/notify\");\n    await notify([{ organizationId: \"o1\", userId: \"u2\", actorId: \"u1\", type: \"MENTION\" }]);\n    expect(creates).toHaveLength(1);\n  });\n\n  it(\"filters only self-notifications in a batch\", async () => {\n    const creates: unknown[] = [];\n    mock.module(\"../src/lib/db\", () => ({\n      db: { notification: { create: async (args: unknown) => { creates.push(args); } } },\n    }));\n    const { notify } = await import(\"../src/server/notify\");\n    await notify([\n      { organizationId: \"o\", userId: \"u1\", actorId: \"u1\", type: \"MENTION\" }, // filtered\n      { organizationId: \"o\", userId: \"u2\", actorId: \"u1\", type: \"MENTION\" }, // kept\n      { organizationId: \"o\", userId: \"u3\", actorId: null, type: \"EVENT_REMINDER\" }, // kept\n    ]);\n    expect(creates).toHaveLength(2);\n  });\n\n  it(\"is a no-op for empty array\", async () => {\n    // should not throw, no db calls\n    const { notify } = await import(\"../src/server/notify\");\n    await expect(notify([])).resolves.toBeUndefined();\n  });\n});\n```\n\n---\n\n### 8. `src/server/org.ts` — `createDefaultGroup` / `joinDefaultGroup` / `removeFromOrganization` — **Zero tests**\n\n```ts\n// apps/api/tests/org.test.ts  (integration — real DB)\ndescribe(\"createDefaultGroup\", () => {\n  it(\"creates an 'All company' group with isDefault=true\", async () => {\n    const { group } = await setupOrg();\n    expect(group.isDefault).toBe(true);\n    expect(group.slug).toBe(\"all-company\");\n    expect(group.privacy).toBe(\"PUBLIC\");\n  });\n\n  it(\"is idempotent — second call returns existing group\", async () => {\n    const { orgId, ownerId } = await setupOrg();\n    const second = await createDefaultGroup(orgId, ownerId);\n    const count = await db.group.count({ where: { organizationId: orgId, isDefault: true } });\n    expect(count).toBe(1);\n    expect(second.id).toBe(firstGroupId);\n  });\n});\n\ndescribe(\"joinDefaultGroup\", () => {\n  it(\"creates ACTIVE membership for new member\", async () => {\n    const { orgId, groupId } = await setupOrg();\n    const newUser = await createUser();\n    await joinDefaultGroup(orgId, newUser.id);\n    const member = await db.groupMember.findUnique({\n      where: { groupId_userId: { groupId, userId: newUser.id } },\n    });\n    expect(member?.status).toBe(\"ACTIVE\");\n  });\n\n  it(\"reactivates a PENDING membership (upsert)\", async () => {\n    // Create member with status PENDING, then joinDefaultGroup should set ACTIVE\n    // ...\n  });\n\n  it(\"is a no-op when org has no default group\", async () => {\n    await expect(joinDefaultGroup(\"nonexistent-org\", \"some-user\")).resolves.not.toThrow();\n  });\n});\n\ndescribe(\"removeFromOrganization\", () => {\n  it(\"removes group, conversation, and event memberships\", async () => {\n    // alice joins org groups and conversations, then removeFromOrganization\n    // ...\n    const groupMemberships = await db.groupMember.count({ where: { userId: alice.id, group: { organizationId: orgId } } });\n    const convMemberships = await db.conversationMember.count({ where: { userId: alice.id, conversation: { organizationId: orgId } } });\n    const eventMemberships = await db.eventAttendee.count({ where: { userId: alice.id, event: { organizationId: orgId } } });\n    expect(groupMemberships).toBe(0);\n    expect(convMemberships).toBe(0);\n    expect(eventMemberships).toBe(0);\n  });\n});\n```\n\n---\n\n### 9. `src/websocket/calls.ts` — `sanitizeMedia()` + call lifecycle — **Zero tests**\n\n```ts\n// apps/api/tests/calls-unit.test.ts\n\n// sanitizeMedia is not exported — test via a thin wrapper or extract it:\ndescribe(\"sanitizeMedia\", () => {\n  it(\"coerces undefined to { audio: false, video: false, screen: false }\", () => {\n    // extract the function or test via call:media event dispatch\n    expect(sanitizeMedia(undefined)).toEqual({ audio: false, video: false, screen: false });\n  });\n\n  it(\"preserves true values\", () => {\n    expect(sanitizeMedia({ audio: true, video: false, screen: true }))\n      .toEqual({ audio: true, video: false, screen: true });\n  });\n\n  it(\"coerces truthy non-boolean to true\", () => {\n    expect(sanitizeMedia({ audio: 1 as any, video: null as any, screen: 0 as any }))\n      .toEqual({ audio: true, video: false, screen: false });\n  });\n});\n\n// Integration tests for call lifecycle (need real DB + WebSocket test harness):\ndescribe(\"call:start\", () => {\n  it(\"requires conversationId or eventId\", async () => {\n    const ack = await dispatch(aliceConn, \"call:start\", { type: \"VIDEO\" });\n    expect(ack.ok).toBe(false);\n    expect(ack.error).toMatch(/conversationId or eventId/);\n  });\n\n  it(\"rejects invalid call type\", async () => {\n    const ack = await dispatch(aliceConn, \"call:start\", { conversationId: convId, type: \"BOTH\" });\n    expect(ack.ok).toBe(false);\n  });\n\n  it(\"returns existing live callId if call already active\", async () => {\n    const first = await dispatch(aliceConn, \"call:start\", { conversationId: convId, type: \"AUDIO\" });\n    const second = await dispatch(aliceConn, \"call:start\", { conversationId: convId, type: \"AUDIO\" });\n    expect(second.data.callId).toBe(first.data.callId);\n  });\n});\n\ndescribe(\"call:join participant cap\", () => {\n  it(\"rejects >6 distinct users\", async () => {\n    // Put 6 users in a call, then try to add a 7th\n    const ack = await dispatch(seventhConn, \"call:join\", { callId, media: {} });\n    expect(ack.ok).toBe(false);\n    expect(ack.error).toMatch(/limited to/);\n  });\n\n  it(\"allows same user joining from second tab (same userId, new socketId)\", async () => {\n    const ack = await dispatch(aliceTab2, \"call:join\", { callId, media: {} });\n    expect(ack.ok).toBe(true);\n  });\n});\n\ndescribe(\"call:leave triggers endCall when last peer leaves\", () => {\n  it(\"sets call status=ENDED and emits call:ended\", async () => {\n    await dispatch(aliceConn, \"call:join\", { callId, media: {} });\n    await dispatch(aliceConn, \"call:leave\", { callId });\n    const call = await db.call.findUnique({ where: { id: callId } });\n    expect(call?.status).toBe(\"ENDED\");\n  });\n});\n\ndescribe(\"rtc:signal relay\", () => {\n  it(\"relays signal only between peers in the same call\", async () => {\n    // alice and bob in call; carol is not\n    // alice signals to carol → no delivery\n    // alice signals to bob → delivered\n  });\n\n  it(\"does not relay if sender is not in the call peers map\", async () => {\n    // outsider tries to send signal to a call peer\n  });\n});\n```\n\n---\n\n### 10. `guardExecute()` — Missing edge cases in existing tests\n\n```ts\n// Add to execute.test.ts\n\ndescribe(\"guardExecute — missing coverage\", () => {\n  it(\"preserves negative take for backward pagination\", () => {\n    const result = guardExecute(\"post\", \"findMany\", { take: -50 });\n    expect(result.take).toBe(-50); // negative sign preserved\n  });\n\n  it(\"caps negative take at -MAX_TAKE\", () => {\n    const result = guardExecute(\"post\", \"findMany\", { take: -999 });\n    expect(result.take).toBe(-100);\n  });\n\n  it(\"defaults take to MAX_TAKE when not provided\", () => {\n    const result = guardExecute(\"post\", \"findMany\", {});\n    expect((result as any).take).toBe(100);\n  });\n\n  it(\"allows all 28 CRUD operators\", () => {\n    const allowed = [\n      \"findMany\", \"findUnique\", \"findUniqueOrThrow\", \"findFirst\", \"findFirstOrThrow\",\n      \"exists\", \"count\", \"aggregate\", \"groupBy\",\n      \"create\", \"createMany\", \"createManyAndReturn\",\n      \"update\", \"updateMany\", \"updateManyAndReturn\",\n      \"upsert\", \"delete\", \"deleteMany\",\n    ];\n    for (const op of allowed) {\n      expect(() => guardExecute(\"post\", op, {})).not.toThrow();\n    }\n  });\n\n  it(\"blocks prototype pollution operators\", () => {\n    for (const op of [\"constructor\", \"__proto__\", \"$queryRaw\", \"$transaction\"]) {\n      expect(() => guardExecute(\"post\", op, {})).toThrow();\n    }\n  });\n\n  it(\"blocks internal models even if not in ZenStack schema\", () => {\n    for (const m of [\"session\", \"account\", \"verification\", \"jwks\"]) {\n      expect(() => guardExecute(m, \"findMany\", {})).toThrow();\n    }\n  });\n});\n```\n\n---\n\n### 11. Integration test gaps in `policies.test.ts`\n\nSeveral scenarios exist in the data model but have no policy coverage:\n\n```ts\n// apps/api/tests/policies.test.ts — additional describe blocks\n\ndescribe(\"reminders (event reminder policy)\", () => {\n  it(\"EVENT_REMINDER notification is readable by its recipient\", async () => {\n    // Create an event, manually set remindedAt, create notification of type EVENT_REMINDER\n    // Verify recipient can read, non-recipient cannot\n  });\n});\n\ndescribe(\"message reactions\", () => {\n  it(\"only conversation members can react to messages\", async () => {\n    // alice creates message in a direct conv between alice and bob\n    // carol (not a member) cannot add MessageReaction\n    // bob can\n  });\n});\n\ndescribe(\"post immutability\", () => {\n  it(\"post.type cannot be changed after creation\", async () => {\n    const post = await aliceDb.post.create({ data: { type: \"TEXT\", ... } });\n    await expect(aliceDb.post.update({ where: { id: post.id }, data: { type: \"POLL\" } }))\n      .rejects.toThrow(); // @deny('update', true) on type field\n  });\n});\n\ndescribe(\"group: CLOSED — non-member cannot see posts\", () => {\n  it(\"member with PENDING status cannot read posts\", async () => {\n    // Already partially tested, but verify specific post.findMany returns empty\n  });\n});\n\ndescribe(\"conversation type immutability\", () => {\n  it(\"conversation.type cannot be changed after creation\", async () => {\n    // verify @deny('update', true) on type field\n  });\n});\n\ndescribe(\"eventAttendee cross-org invite\", () => {\n  it(\"cannot invite cross-org user to an event\", async () => {\n    const event = await aliceDb.event.create({ ... }); // org A event\n    await expect(\n      aliceDb.eventAttendee.create({ data: { eventId: event.id, userId: carol.id } })\n    ).rejects.toThrow(); // carol is in org B\n  });\n});\n```\n\n---\n\n### Summary of Gaps by Priority\n\n| Priority | Gap | Why it matters |\n|---|---|---|\n| **High** | `toErrorResponse()` (errors.ts) | Entire error contract; PG error code branches completely untested |\n| **High** | `Conn` class + hub functions | Core realtime infrastructure; pure in-memory, zero external deps |\n| **High** | `rateLimit()` | Token bucket math; replenishment edge cases |\n| **High** | `conversations.ts` route | Race condition handler uses bypass `db` — only path where `db` is used for user input |\n| **Medium** | `notify()` self-filter | Silent filtering bug would cause actors to see their own notifications |\n| **Medium** | `guardExecute()` negative take, defaults | Backward pagination correctness |\n| **Medium** | `uploads.ts` BLOCKED regex + `orgVisible` validation | Security: XSS via SVG if regex has gaps |\n| **Medium** | `rtc.ts` HMAC credential | TURN secret never verified in test |\n| **Medium** | `org.ts` lifecycle hooks | `createDefaultGroup` idempotency, `removeFromOrganization` cascade |\n| **Low** | `calls.ts` `sanitizeMedia()` | Easy to extract and unit test |\n| **Low** | Missing policy scenarios (message reactions, event RSVP cross-org, type immutability) | ZenStack `@deny('update', true)` never exercised |\n\nThe highest-value additions would be **errors.test.ts** (pure unit, no DB needed), **hub.test.ts** (pure unit, no DB needed), and **conversations.test.ts** (integration, covers the only route with a bypass-`db` code path).\n",
