        "code": "// Additions to apps/api/tests/execute.test.ts\n\ntest(\"args: null is treated as {} (no crash)\", async () => {\n  // POST with \"args\": null in JSON body\n  const res = await app.handle(\n    authed(new Request(\"http://localhost/api/execute\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify({ model: \"user\", operator: \"findMany\", args: null }),\n    })),\n  );\n  // Should succeed or fail with a policy error, not a 500\n  expect(res.status).not.toBe(500);\n});\n\ntest(\"rate limit: 301st execute in a minute → 429\", async () => {\n  // exhaust the 300/min bucket\n  for (let i = 0; i < 300; i++) {\n    await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  }\n  const res = await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  expect(res.status).toBe(429);\n});\n\ntest(\"findMany take:0 → clamped to MAX_TAKE (sign of 0 is treated as +1)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: 0 });\n  expect(result.take).toBe(MAX_TAKE);\n});\n\ntest(\"findMany take:-200 → take:-100 (negative preserved, magnitude capped)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: -200 });\n  expect(result.take).toBe(-MAX_TAKE);\n});\n\ntest(\"wrong model casing is rejected\", () => {\n  expect(() => guardExecute(\"Post\", \"findMany\", {})).toThrow();\n  expect(() => guardExecute(\"post\", \"findMany\", {})).not.toThrow();\n});"
