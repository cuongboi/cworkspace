        "language": "ts",
        "code": "// apps/api/tests/conversations.test.ts\n// Integration test — requires a seeded database and running app (same pattern as policies.test.ts)\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { seedOrg } from \"./helpers/seed\"; // create two members in an org\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: \"o1\", userId: \"u2\" }),\n      }),\n    );\n    expect(res.status).toBe(401);\n  });\n\n  test(\"rejects self-message\", async () => {\n    const { cookie, user } = await seedOrg();\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: user.organizationId, userId: user.id }),\n      }),\n    );\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"creates a new direct conversation (201) and deduplicates on repeat (200)\", async () => {\n    const { cookie, user, other, orgId } = await seedOrg();\n\n    const res1 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res1.status).toBe(201);\n    const { data: conv1 } = await res1.json();\n\n    const res2 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res2.status).toBe(200);\n    const { data: conv2 } = await res2.json();\n    expect(conv2.id).toBe(conv1.id);\n  });\n\n  test(\"directKey is order-independent: (A,B) and (B,A) share the same conversation\", async () => {\n    const { cookieA, cookieB, orgId, userA, userB } = await seedOrg();\n    const res1 = await app.handle(postDirect(cookieA, orgId, userB.id));\n    const res2 = await app.handle(postDirect(cookieB, orgId, userA.id));\n    const { data: c1 } = await res1.json();\n    const { data: c2 } = await res2.json();\n    expect(c1.id).toBe(c2.id);\n  });\n});\n\nfunction postDirect(cookie: string, organizationId: string, userId: string) {\n  return new Request(\"http://localhost/api/conversations/direct\", {\n    method: \"POST\",\n    headers: { cookie, \"content-type\": \"application/json\" },\n    body: JSON.stringify({ organizationId, userId }),\n  });\n}"
