        "code": "// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  test(\"returns cache-control: private, no-store\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    expect(res.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n  });\n\n  test(\"always includes at least one STUN server\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.iceServers.some((s: any) => s.urls.some((u: string) => u.startsWith(\"stun:\")))).toBe(true);\n  });\n\n  test(\"TURN credential follows coturn use-auth-secret formula\", () => {\n    const secret = \"test-secret\";\n    const userId = \"user_abc\";\n    const TTL = 6 * 60 * 60;\n    const epoch = Math.floor(Date.now() / 1000) + TTL;\n    const username = `${epoch}:${userId}`;\n    const expected = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    // Verify the formula matches what the route produces\n    expect(expected).toMatch(/^[A-Za-z0-9+/]+=*$/); // valid base64\n    expect(username.split(\":\")[1]).toBe(userId);\n  });\n\n  test(\"ttl in response equals 21600 seconds\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.ttl).toBe(21600);\n  });\n});"
