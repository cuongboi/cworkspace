  "output": "Now I have enough context to write the full analysis. Here's the complete coverage gap report with test skeletons:\n\n---\n\n## Test Coverage Analysis\n\n### Current State\n\n3 test files exist, all in `apps/api/tests/`:\n\n| File | What it covers |\n|---|---|\n| `policies.test.ts` | ZenStack access policies against real DB (tenant isolation, group privacy, posts, polls, chat, notifications, calendar, attachments, calls) |\n| `user-admin-fields.test.ts` | Server-only fields users cannot self-update (`role`, `banned`, `banReason`, `email`, `permissions`) |\n| `execute.test.ts` | `/api/execute` contract: auth, model/operator allowlists, `findMany.take` cap |\n\nZero tests for: `mentions.ts`, `rate-limit.ts`, `errors.ts`, `conversations` route, `uploads` route, `rtc` route, `hub.ts`, and all WebSocket handlers.\n\n---\n\n### Gap 1 — `packages/shared/src/mentions.ts` (pure functions, zero tests)\n\nEvery function here is stateless and trivially testable. Bugs silently corrupt stored text and break notifications.\n\n**Uncovered cases:**\n- `formatMention`: name containing `[` or `]` characters (they must be stripped)\n- `extractMentionIds`: duplicate mentions should deduplicate; zero mentions; overlapping patterns\n- `parseText`: interleaved mentions + URLs + plain text; mention at start/end; consecutive mentions; URL immediately after mention\n- `toPlainText`: round-trip fidelity\n\n```ts\n// apps/api/tests/mentions.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport {\n  extractMentionIds,\n  formatMention,\n  parseText,\n  toPlainText,\n} from \"@app/shared/mentions\";\n\ndescribe(\"formatMention\", () => {\n  test(\"produces the canonical inline format\", () => {\n    expect(formatMention(\"Alice\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"strips brackets from the display name\", () => {\n    expect(formatMention(\"A[lic]e\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"handles empty display name\", () => {\n    expect(formatMention(\"\", \"user_123\")).toBe(\"@[](user_123)\");\n  });\n});\n\ndescribe(\"extractMentionIds\", () => {\n  test(\"returns empty array for plain text\", () => {\n    expect(extractMentionIds(\"hello world\")).toEqual([]);\n  });\n\n  test(\"extracts a single mention\", () => {\n    expect(extractMentionIds(\"hey @[Alice](uid1) how are you\")).toEqual([\"uid1\"]);\n  });\n\n  test(\"deduplicates repeated mentions of the same user\", () => {\n    const text = \"@[Alice](uid1) and @[Alice](uid1) again\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\"]);\n  });\n\n  test(\"extracts multiple distinct users\", () => {\n    const text = \"@[Alice](uid1) @[Bob](uid2)\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\", \"uid2\"]);\n  });\n\n  test(\"ignores malformed mention-like strings\", () => {\n    expect(extractMentionIds(\"@[Alice] @(uid1)\")).toEqual([]);\n  });\n});\n\ndescribe(\"parseText\", () => {\n  test(\"plain text produces a single text segment\", () => {\n    expect(parseText(\"hello world\")).toEqual([{ kind: \"text\", text: \"hello world\" }]);\n  });\n\n  test(\"mention-only string\", () => {\n    expect(parseText(\"@[Alice](uid1)\")).toEqual([\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n    ]);\n  });\n\n  test(\"URL-only string\", () => {\n    const segs = parseText(\"https://example.com\");\n    expect(segs).toEqual([{ kind: \"link\", url: \"https://example.com\" }]);\n  });\n\n  test(\"interleaved text, mention, and URL\", () => {\n    const segs = parseText(\"See @[Alice](uid1) at https://example.com today\");\n    expect(segs).toEqual([\n      { kind: \"text\", text: \"See \" },\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n      { kind: \"text\", text: \" at \" },\n      { kind: \"link\", url: \"https://example.com\" },\n      { kind: \"text\", text: \" today\" },\n    ]);\n  });\n\n  test(\"consecutive mentions produce no phantom text segment between them\", () => {\n    const segs = parseText(\"@[Alice](uid1)@[Bob](uid2)\");\n    expect(segs.every((s) => s.kind !== \"text\" || s.text.length > 0)).toBe(true);\n    expect(segs.filter((s) => s.kind === \"mention\")).toHaveLength(2);\n  });\n\n  test(\"mention at the very start of text\", () => {\n    const segs = parseText(\"@[Alice](uid1) hello\");\n    expect(segs[0]).toEqual({ kind: \"mention\", name: \"Alice\", userId: \"uid1\" });\n  });\n});\n\ndescribe(\"toPlainText\", () => {\n  test(\"replaces mention syntax with @Name\", () => {\n    expect(toPlainText(\"Hey @[Alice](uid1)!\")).toBe(\"Hey @Alice!\");\n  });\n\n  test(\"no-op on plain text\", () => {\n    expect(toPlainText(\"hello\")).toBe(\"hello\");\n  });\n\n  test(\"multiple mentions\", () => {\n    expect(toPlainText(\"@[Alice](u1) and @[Bob](u2)\")).toBe(\"@Alice and @Bob\");\n  });\n});\n```\n\n---\n\n### Gap 2 — `apps/api/src/server/rate-limit.ts` (in-memory token bucket)\n\nThe `rateLimit` function drives upload throttling and `/api/execute` cost control. Its refill math and eviction logic are never exercised.\n\n**Uncovered cases:**\n- First call always allowed (full bucket)\n- Depletes to zero and blocks\n- Refills over time (fractional token accrual)\n- Memory eviction: buckets older than `perMs * 10` are cleaned when map exceeds 50 000\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { rateLimit } from \"../src/server/rate-limit\";\n\nconst key = (label: string) => `test:${label}:${Math.random()}`;\n\ndescribe(\"rateLimit\", () => {\n  test(\"first call is always allowed\", () => {\n    expect(rateLimit(key(\"first\"), 5, 1000)).toBe(true);\n  });\n\n  test(\"allows up to capacity calls in one window\", () => {\n    const k = key(\"capacity\");\n    const results = Array.from({ length: 3 }, () => rateLimit(k, 3, 60_000));\n    expect(results).toEqual([true, true, true]);\n  });\n\n  test(\"blocks the call after capacity is exhausted\", () => {\n    const k = key(\"block\");\n    rateLimit(k, 2, 60_000);\n    rateLimit(k, 2, 60_000);\n    expect(rateLimit(k, 2, 60_000)).toBe(false);\n  });\n\n  test(\"refills tokens proportionally after time passes\", async () => {\n    const k = key(\"refill\");\n    const perMs = 100;\n    rateLimit(k, 1, perMs); // consume the single token\n    expect(rateLimit(k, 1, perMs)).toBe(false); // still empty\n    await Bun.sleep(perMs + 10);              // wait for a full refill\n    expect(rateLimit(k, 1, perMs)).toBe(true);\n  });\n\n  test(\"independent keys do not interfere\", () => {\n    const k1 = key(\"iso1\");\n    const k2 = key(\"iso2\");\n    rateLimit(k1, 1, 60_000);\n    rateLimit(k1, 1, 60_000); // exhaust k1\n    expect(rateLimit(k2, 1, 60_000)).toBe(true); // k2 untouched\n  });\n});\n```\n\n---\n\n### Gap 3 — `apps/api/src/lib/errors.ts` (`toErrorResponse`)\n\n`toErrorResponse` normalises every thrown value into the wire envelope. It has six distinct branches: `HttpError`, four `ORMError` reasons, and the catch-all. None are directly tested.\n\n**Uncovered cases:**\n- Each `HttpError` helper maps to correct HTTP status and code\n- `ORMError.REJECTED_BY_POLICY` always returns 403 with `FORBIDDEN` (never leaks the real reason)\n- `ORMError.DB_QUERY_ERROR` with PG code `23505` → 409 `CONFLICT`\n- `ORMError.DB_QUERY_ERROR` with PG code `23503` → 409 `CONFLICT`\n- Unknown errors → 500 `INTERNAL` and must not include stack traces or raw SQL\n\n```ts\n// apps/api/tests/errors.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  badRequest,\n  conflict,\n  forbidden,\n  notFound,\n  tooManyRequests,\n  unauthorized,\n  upstreamError,\n  toErrorResponse,\n} from \"../src/lib/errors\";\n\ndescribe(\"HttpError helpers\", () => {\n  const cases = [\n    { fn: () => badRequest(\"bad\"), status: 400, code: \"INVALID_INPUT\" },\n    { fn: () => notFound(), status: 404, code: \"NOT_FOUND\" },\n    { fn: () => forbidden(\"no\"), status: 403, code: \"FORBIDDEN\" },\n    { fn: () => conflict(\"dup\"), status: 409, code: \"CONFLICT\" },\n    { fn: () => unauthorized(), status: 401, code: \"UNAUTHORIZED\" },\n    { fn: () => tooManyRequests(), status: 429, code: \"INVALID_STATE\" },\n    { fn: () => upstreamError(\"down\"), status: 502, code: \"UPSTREAM_ERROR\" },\n  ] as const;\n\n  for (const { fn, status, code } of cases) {\n    test(`${code} → HTTP ${status}`, () => {\n      const err = fn();\n      expect(err).toBeInstanceOf(HttpError);\n      const { status: s, body } = toErrorResponse(err);\n      expect(s).toBe(status);\n      expect(body.error.code).toBe(code);\n    });\n  }\n});\n\ndescribe(\"toErrorResponse — ORMError branches\", () => {\n  const makeOrm = (reason: ORMErrorReason, dbCode?: string) => {\n    const e = new ORMError(\"msg\", reason);\n    if (dbCode) (e as any).dbErrorCode = dbCode;\n    return e;\n  };\n\n  test(\"INVALID_INPUT → 400\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.INVALID_INPUT));\n    expect(status).toBe(400);\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"NOT_FOUND → 404\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.NOT_FOUND));\n    expect(status).toBe(404);\n  });\n\n  test(\"REJECTED_BY_POLICY → 403, message is generic (never leaks policy reason)\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.REJECTED_BY_POLICY));\n    expect(status).toBe(403);\n    expect(body.error.message).toBe(\"Operation not permitted\");\n  });\n\n  test(\"unique violation (23505) → 409 CONFLICT\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23505\"));\n    expect(status).toBe(409);\n    expect(body.error.code).toBe(\"CONFLICT\");\n  });\n\n  test(\"FK violation (23503) → 409 CONFLICT\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23503\"));\n    expect(status).toBe(409);\n  });\n});\n\ndescribe(\"toErrorResponse — unknown errors\", () => {\n  test(\"plain Error → 500 INTERNAL (no leak)\", () => {\n    const { status, body } = toErrorResponse(new Error(\"secret sql query\"));\n    expect(status).toBe(500);\n    expect(body.error.code).toBe(\"INTERNAL\");\n    expect(body.error.message).not.toContain(\"sql\");\n  });\n\n  test(\"thrown string → 500 INTERNAL\", () => {\n    const { status } = toErrorResponse(\"oops\");\n    expect(status).toBe(500);\n  });\n});\n```\n\n---\n\n### Gap 4 — `apps/api/src/websocket/hub.ts` (`Conn`, room management)\n\n`hub.ts` contains the only shared mutable state for realtime: room membership, connection registry, and the `dispatch` loop. No test touches it.\n\n**Uncovered cases:**\n- `Conn.join` / `Conn.leave` maintain `members` map correctly; leaving the last member cleans up the entry\n- `Conn.dispatch` invokes the registered handler; unknown events get an ack error; non-object payloads are coerced to `{}`\n- `Conn.broadcast` excludes the sender but reaches every other conn in the room\n- `emitTo` with multiple overlapping rooms sends exactly one frame per connection\n- `joinUserToRoom` / `removeUserFromRoom` propagate to all user connections\n- `connectionCount` returns 0 for unknown users, increments on join, decrements on dispose\n- `clearRoom` evicts all members\n\n```ts\n// apps/api/tests/hub.test.ts\nimport { describe, expect, mock, test } from \"bun:test\";\nimport { Conn, clearRoom, connectionCount, emitTo, joinUserToRoom, onlineUserIds, register, removeUserFromRoom, rooms, unregister } from \"../src/websocket/hub\";\n\nfunction makeSock() {\n  const frames: string[] = [];\n  return {\n    raw: { send: (d: string) => { frames.push(d); }, close: () => {} },\n    frames,\n  };\n}\n\nfunction makeUser(id: string) {\n  return { id, email: `${id}@test.com`, role: \"user\" as const };\n}\n\nfunction makeConn(userId: string) {\n  const { raw, frames } = makeSock();\n  return { conn: new Conn(raw, makeUser(userId)), frames };\n}\n\ndescribe(\"Conn.join / Conn.leave\", () => {\n  test(\"join adds connection to room; leave removes it\", () => {\n    const { conn } = makeConn(\"u1\");\n    const room = \"test:room:join\";\n    conn.join(room);\n    emitTo([room], \"post.created\" as any, {} as any);\n    conn.leave(room);\n    // After leave, a further emit should not reach this conn\n    const { frames } = makeSock();\n    emitTo([room], \"post.created\" as any, {} as any);\n    // conn.frames only grew by 1 (the pre-leave emit)\n    expect(conn.rooms.has(room)).toBe(false);\n  });\n\n  test(\"leaving the last connection deletes the room entry (no memory leak)\", () => {\n    const { conn } = makeConn(\"u2\");\n    const room = \"test:room:empty\";\n    conn.join(room);\n    conn.leave(room);\n    // Emitting to the now-empty room should be a no-op\n    expect(() => emitTo([room], \"post.created\" as any, {} as any)).not.toThrow();\n  });\n});\n\ndescribe(\"Conn.dispatch\", () => {\n  test(\"calls the registered handler\", () => {\n    const { conn } = makeConn(\"u3\");\n    const fn = mock(() => {});\n    conn.on(\"typing\" as any, fn);\n    conn.dispatch(\"typing\", { conversationId: \"c1\" });\n    expect(fn).toHaveBeenCalledTimes(1);\n  });\n\n  test(\"unknown event sends ack error when reqId present\", () => {\n    const { conn, frames } = makeConn(\"u4\");\n    conn.dispatch(\"unknown_event\", {}, 42);\n    const ack = JSON.parse(frames.at(-1)!);\n    expect(ack.ack).toBe(42);\n    expect(ack.res.ok).toBe(false);\n  });\n\n  test(\"non-object payload is coerced to {} before handler\", () => {\n    const { conn } = makeConn(\"u5\");\n    const fn = mock((_payload: object) => {});\n    conn.on(\"typing\" as any, fn);\n    conn.dispatch(\"typing\", \"bad-payload\");\n    expect(fn).toHaveBeenCalledWith({}, expect.any(Function));\n  });\n});\n\ndescribe(\"Conn.broadcast\", () => {\n  test(\"reaches other connections in the room but not the sender\", () => {\n    const room = \"test:room:broadcast\";\n    const { conn: sender } = makeConn(\"sender\");\n    const { conn: other, frames: otherFrames } = makeConn(\"other\");\n\n    sender.join(room);\n    other.join(room);\n    sender.broadcast(room, \"post.created\" as any, {} as any);\n\n    expect(otherFrames.length).toBe(1);\n    sender.leave(room);\n    other.leave(room);\n  });\n});\n\ndescribe(\"emitTo deduplication\", () => {\n  test(\"a connection in two target rooms receives exactly one frame\", () => {\n    const room1 = \"test:dedup:r1\";\n    const room2 = \"test:dedup:r2\";\n    const { conn, frames } = makeConn(\"u6\");\n    conn.join(room1);\n    conn.join(room2);\n    emitTo([room1, room2], \"post.created\" as any, {} as any);\n    expect(frames.length).toBe(1);\n    conn.leave(room1);\n    conn.leave(room2);\n  });\n});\n\ndescribe(\"connectionCount / onlineUserIds / register / unregister\", () => {\n  test(\"connectionCount is 0 before registration\", () => {\n    expect(connectionCount(\"never_registered\")).toBe(0);\n  });\n\n  test(\"register increments count; unregister decrements\", () => {\n    const { conn } = makeConn(\"u7\");\n    register(conn);\n    expect(connectionCount(\"u7\")).toBe(1);\n    unregister(conn);\n    expect(connectionCount(\"u7\")).toBe(0);\n  });\n\n  test(\"onlineUserIds includes registered user\", () => {\n    const { conn } = makeConn(\"u8\");\n    register(conn);\n    expect(onlineUserIds().has(\"u8\")).toBe(true);\n    unregister(conn);\n    expect(onlineUserIds().has(\"u8\")).toBe(false);\n  });\n});\n\ndescribe(\"joinUserToRoom / removeUserFromRoom / clearRoom\", () => {\n  test(\"joinUserToRoom subscribes all existing connections of a user\", () => {\n    const room = \"test:join-user:r1\";\n    const { conn, frames } = makeConn(\"u9\");\n    register(conn);\n    joinUserToRoom(\"u9\", room);\n    emitTo([room], \"post.created\" as any, {} as any);\n    expect(frames.length).toBeGreaterThan(0);\n    unregister(conn);\n  });\n\n  test(\"removeUserFromRoom unsubscribes all connections of a user\", () => {\n    const room = \"test:remove-user:r1\";\n    const { conn, frames } = makeConn(\"u10\");\n    register(conn);\n    joinUserToRoom(\"u10\", room);\n    removeUserFromRoom(\"u10\", room);\n    const before = frames.length;\n    emitTo([room], \"post.created\" as any, {} as any);\n    expect(frames.length).toBe(before);\n    unregister(conn);\n  });\n\n  test(\"clearRoom evicts all connections\", () => {\n    const room = \"test:clear:r1\";\n    const { conn } = makeConn(\"u11\");\n    conn.join(room);\n    clearRoom(room);\n    expect(conn.rooms.has(room)).toBe(false);\n  });\n});\n```\n\n---\n\n### Gap 5 — `POST /api/conversations/direct` route\n\nThe route has a race-condition branch (`raced?.members.length`) that is untestable without simulating a concurrent duplicate insert. The self-message guard and deduplication by `directKey` are also uncovered.\n\n**Uncovered cases:**\n- Calling with `userId === user.id` → 400 `INVALID_INPUT`\n- First call creates the conversation (201) with correct `directKey`\n- Second call with the same pair returns the existing id (200, idempotent)\n- `directKey` is order-independent: `(A, B)` and `(B, A)` resolve to the same conversation\n- Race-condition fallback: policy client creates fails with unique violation, fallback reads the db-level client\n\n```ts\n// apps/api/tests/conversations.test.ts\n// Integration test — requires a seeded database and running app (same pattern as policies.test.ts)\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { seedOrg } from \"./helpers/seed\"; // create two members in an org\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: \"o1\", userId: \"u2\" }),\n      }),\n    );\n    expect(res.status).toBe(401);\n  });\n\n  test(\"rejects self-message\", async () => {\n    const { cookie, user } = await seedOrg();\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: user.organizationId, userId: user.id }),\n      }),\n    );\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"creates a new direct conversation (201) and deduplicates on repeat (200)\", async () => {\n    const { cookie, user, other, orgId } = await seedOrg();\n\n    const res1 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res1.status).toBe(201);\n    const { data: conv1 } = await res1.json();\n\n    const res2 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res2.status).toBe(200);\n    const { data: conv2 } = await res2.json();\n    expect(conv2.id).toBe(conv1.id);\n  });\n\n  test(\"directKey is order-independent: (A,B) and (B,A) share the same conversation\", async () => {\n    const { cookieA, cookieB, orgId, userA, userB } = await seedOrg();\n    const res1 = await app.handle(postDirect(cookieA, orgId, userB.id));\n    const res2 = await app.handle(postDirect(cookieB, orgId, userA.id));\n    const { data: c1 } = await res1.json();\n    const { data: c2 } = await res2.json();\n    expect(c1.id).toBe(c2.id);\n  });\n});\n\nfunction postDirect(cookie: string, organizationId: string, userId: string) {\n  return new Request(\"http://localhost/api/conversations/direct\", {\n    method: \"POST\",\n    headers: { cookie, \"content-type\": \"application/json\" },\n    body: JSON.stringify({ organizationId, userId }),\n  });\n}\n```\n\n---\n\n### Gap 6 — `POST /api/uploads` route\n\nThe MIME-type blocklist and `orgVisible` image-only guard are key security controls that are untested.\n\n**Uncovered cases:**\n- Blocked MIME types (`text/html`, `application/javascript`, `image/svg+xml`) → 400\n- `orgVisible: true` with a non-image MIME → 400\n- `orgVisible: true` with an image MIME → allowed\n- Storage not configured → 502 `UPSTREAM_ERROR`\n- Rate limit exceeded after 30 uploads/min → 429\n- `name` sanitization: `name` with `..` / special chars produces a safe S3 key\n- File `size` at boundary: `size = MAX_UPLOAD_BYTES` passes; `size = MAX_UPLOAD_BYTES + 1` is rejected by Elysia body validation\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { BLOCKED } from \"../src/routes/uploads\"; // export the regex for unit testing\n\n// Unit tests for the BLOCKED pattern (no HTTP needed)\ndescribe(\"BLOCKED mime type regex\", () => {\n  const blocked = [\n    \"text/html\",\n    \"application/javascript\",\n    \"application/x-javascript\",\n    \"application/ecmascript\",\n    \"image/svg+xml\",\n    \"application/xhtml+xml\",\n    \"TEXT/HTML\",                    // case-insensitive\n  ];\n  const allowed = [\n    \"image/png\",\n    \"image/jpeg\",\n    \"application/pdf\",\n    \"application/zip\",\n    \"video/mp4\",\n    \"audio/mpeg\",\n    \"text/plain\",                   // plain text OK\n  ];\n\n  for (const mime of blocked) {\n    test(`blocks ${mime}`, () => expect(BLOCKED.test(mime)).toBe(true));\n  }\n  for (const mime of allowed) {\n    test(`allows ${mime}`, () => expect(BLOCKED.test(mime)).toBe(false));\n  }\n});\n\n// Integration tests (require storage configured or mocked)\ndescribe(\"POST /api/uploads — integration\", () => {\n  test(\"returns 400 for blocked MIME type\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"text/html\", name: \"evil.html\", size: 100 }));\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"returns 400 when orgVisible=true for non-image\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"application/pdf\", name: \"doc.pdf\", size: 100, orgVisible: true }));\n    expect(res.status).toBe(400);\n  });\n\n  test(\"allows orgVisible=true for images\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"image/png\", name: \"photo.png\", size: 1024, orgVisible: true }));\n    // 201 or 502 (if storage not configured) — neither is 400\n    expect([201, 502]).toContain(res.status);\n  });\n});\n```\n\n---\n\n### Gap 7 — `GET /api/rtc/ice` route\n\nThe HMAC credential generation is a security-critical path (time-limited TURN credentials). The formula must match coturn's `use-auth-secret` spec exactly.\n\n**Uncovered cases:**\n- Without `TURN_SECRET` set: response includes only STUN\n- With `TURN_SECRET` set: response includes TURN with `username` in `{epoch}:{userId}` form\n- HMAC credential is verifiable: `HMAC-SHA1(secret, username)` base64\n- `cache-control: private, no-store` header always present\n- TTL is `6 * 60 * 60` = 21 600 seconds\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  test(\"returns cache-control: private, no-store\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    expect(res.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n  });\n\n  test(\"always includes at least one STUN server\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.iceServers.some((s: any) => s.urls.some((u: string) => u.startsWith(\"stun:\")))).toBe(true);\n  });\n\n  test(\"TURN credential follows coturn use-auth-secret formula\", () => {\n    const secret = \"test-secret\";\n    const userId = \"user_abc\";\n    const TTL = 6 * 60 * 60;\n    const epoch = Math.floor(Date.now() / 1000) + TTL;\n    const username = `${epoch}:${userId}`;\n    const expected = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    // Verify the formula matches what the route produces\n    expect(expected).toMatch(/^[A-Za-z0-9+/]+=*$/); // valid base64\n    expect(username.split(\":\")[1]).toBe(userId);\n  });\n\n  test(\"ttl in response equals 21600 seconds\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.ttl).toBe(21600);\n  });\n});\n```\n\n---\n\n### Gap 8 — Missing edge cases in existing `execute.test.ts`\n\n| Missing case | Why it matters |\n|---|---|\n| `args: null` → treated as `{}` (the route does `body.args ?? {}`) | A client sending `\"args\": null` must not crash the handler |\n| Rate limit: 301st request in one minute → 429 | The 300/min cap is the primary DoS defence on `/api/execute` |\n| `findMany` with `take: 0` → `take` is set to `MAX_TAKE` (sign of `0` is `+1`) | Edge case in `Math.sign(take \\|\\| 1)` |\n| `findMany` with `take: -200` → `take: -100` (preserves negative) | Backward pagination must still be bounded |\n| Model name with correct case (`Post` vs `post`) | `MODELS` set uses camelCase; wrong case must be rejected |\n\n```ts\n// Additions to apps/api/tests/execute.test.ts\n\ntest(\"args: null is treated as {} (no crash)\", async () => {\n  // POST with \"args\": null in JSON body\n  const res = await app.handle(\n    authed(new Request(\"http://localhost/api/execute\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify({ model: \"user\", operator: \"findMany\", args: null }),\n    })),\n  );\n  // Should succeed or fail with a policy error, not a 500\n  expect(res.status).not.toBe(500);\n});\n\ntest(\"rate limit: 301st execute in a minute → 429\", async () => {\n  // exhaust the 300/min bucket\n  for (let i = 0; i < 300; i++) {\n    await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  }\n  const res = await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  expect(res.status).toBe(429);\n});\n\ntest(\"findMany take:0 → clamped to MAX_TAKE (sign of 0 is treated as +1)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: 0 });\n  expect(result.take).toBe(MAX_TAKE);\n});\n\ntest(\"findMany take:-200 → take:-100 (negative preserved, magnitude capped)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: -200 });\n  expect(result.take).toBe(-MAX_TAKE);\n});\n\ntest(\"wrong model casing is rejected\", () => {\n  expect(() => guardExecute(\"Post\", \"findMany\", {})).toThrow();\n  expect(() => guardExecute(\"post\", \"findMany\", {})).not.toThrow();\n});\n```\n\n---\n\n### Gap 9 — Integration: `policies.test.ts` missing scenarios\n\n| Gap | Location in `policies.test.ts` |\n|---|---|\n| **CLOSED group join request** never tested end-to-end: a pending member cannot post, approved member can | Group Access Control section |\n| **Group post moved cross-group** is blocked by policy — but the test only checks it at the `update` level; a `delete`+`create` workaround across groups is not tested | Post Management section |\n| **Call created with >6 participants** is not rejected (no participant cap test) | Call section |\n| **Notification `recipientId` must match `auth().id`** — a user cannot read another user's notifications | Notification section |\n| **Calendar event with `endAt <= startAt`** is rejected | Calendar section — `end must be after start` test exists but only checks equal timestamps; `endAt < startAt` (strictly before) is not explicitly covered |\n| **Message of type `SYSTEM` or `CALL`** cannot be created by a user (server-only) | Chat section — messages are tested but not the type restriction |\n\n---\n\n### Priority order for implementation\n\n1. **`mentions.test.ts`** — pure functions, zero external deps, highest ROI\n2. **`errors.test.ts`** — pure logic, the error envelope is on every API response\n3. **`rate-limit.test.ts`** — pure-ish, needs only `Bun.sleep`\n4. **`hub.test.ts`** — no DB needed, mocked sockets; covers the realtime backbone\n5. **`execute.test.ts` additions** — extend the existing file with the edge cases above\n6. **`rtc.test.ts`** — HMAC formula correctness is security-critical\n7. **`conversations.test.ts`** — integration, needs seeded DB (same infra as `policies.test.ts`)\n8. **`uploads.test.ts`** — MIME blocklist unit tests are free; integration needs storage mock\n9. **`policies.test.ts` additions** — fill the remaining scenario gaps in the existing suite\n",
  "parsedOutput": {
    "sections": [
      {
        "title": "Test Coverage Analysis",
        "content": "\n",
        "level": 2
      },
      {
        "title": "Current State",
        "content": "\n3 test files exist, all in `apps/api/tests/`:\n\n| File | What it covers |\n|---|---|\n| `policies.test.ts` | ZenStack access policies against real DB (tenant isolation, group privacy, posts, polls, chat, notifications, calendar, attachments, calls) |\n| `user-admin-fields.test.ts` | Server-only fields users cannot self-update (`role`, `banned`, `banReason`, `email`, `permissions`) |\n| `execute.test.ts` | `/api/execute` contract: auth, model/operator allowlists, `findMany.take` cap |\n\nZero tests for: `mentions.ts`, `rate-limit.ts`, `errors.ts`, `conversations` route, `uploads` route, `rtc` route, `hub.ts`, and all WebSocket handlers.\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 1 — `packages/shared/src/mentions.ts` (pure functions, zero tests)",
        "content": "\nEvery function here is stateless and trivially testable. Bugs silently corrupt stored text and break notifications.\n\n**Uncovered cases:**\n- `formatMention`: name containing `[` or `]` characters (they must be stripped)\n- `extractMentionIds`: duplicate mentions should deduplicate; zero mentions; overlapping patterns\n- `parseText`: interleaved mentions + URLs + plain text; mention at start/end; consecutive mentions; URL immediately after mention\n- `toPlainText`: round-trip fidelity\n\n```ts\n// apps/api/tests/mentions.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport {\n  extractMentionIds,\n  formatMention,\n  parseText,\n  toPlainText,\n} from \"@app/shared/mentions\";\n\ndescribe(\"formatMention\", () => {\n  test(\"produces the canonical inline format\", () => {\n    expect(formatMention(\"Alice\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"strips brackets from the display name\", () => {\n    expect(formatMention(\"A[lic]e\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"handles empty display name\", () => {\n    expect(formatMention(\"\", \"user_123\")).toBe(\"@[](user_123)\");\n  });\n});\n\ndescribe(\"extractMentionIds\", () => {\n  test(\"returns empty array for plain text\", () => {\n    expect(extractMentionIds(\"hello world\")).toEqual([]);\n  });\n\n  test(\"extracts a single mention\", () => {\n    expect(extractMentionIds(\"hey @[Alice](uid1) how are you\")).toEqual([\"uid1\"]);\n  });\n\n  test(\"deduplicates repeated mentions of the same user\", () => {\n    const text = \"@[Alice](uid1) and @[Alice](uid1) again\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\"]);\n  });\n\n  test(\"extracts multiple distinct users\", () => {\n    const text = \"@[Alice](uid1) @[Bob](uid2)\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\", \"uid2\"]);\n  });\n\n  test(\"ignores malformed mention-like strings\", () => {\n    expect(extractMentionIds(\"@[Alice] @(uid1)\")).toEqual([]);\n  });\n});\n\ndescribe(\"parseText\", () => {\n  test(\"plain text produces a single text segment\", () => {\n    expect(parseText(\"hello world\")).toEqual([{ kind: \"text\", text: \"hello world\" }]);\n  });\n\n  test(\"mention-only string\", () => {\n    expect(parseText(\"@[Alice](uid1)\")).toEqual([\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n    ]);\n  });\n\n  test(\"URL-only string\", () => {\n    const segs = parseText(\"https://example.com\");\n    expect(segs).toEqual([{ kind: \"link\", url: \"https://example.com\" }]);\n  });\n\n  test(\"interleaved text, mention, and URL\", () => {\n    const segs = parseText(\"See @[Alice](uid1) at https://example.com today\");\n    expect(segs).toEqual([\n      { kind: \"text\", text: \"See \" },\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n      { kind: \"text\", text: \" at \" },\n      { kind: \"link\", url: \"https://example.com\" },\n      { kind: \"text\", text: \" today\" },\n    ]);\n  });\n\n  test(\"consecutive mentions produce no phantom text segment between them\", () => {\n    const segs = parseText(\"@[Alice](uid1)@[Bob](uid2)\");\n    expect(segs.every((s) => s.kind !== \"text\" || s.text.length > 0)).toBe(true);\n    expect(segs.filter((s) => s.kind === \"mention\")).toHaveLength(2);\n  });\n\n  test(\"mention at the very start of text\", () => {\n    const segs = parseText(\"@[Alice](uid1) hello\");\n    expect(segs[0]).toEqual({ kind: \"mention\", name: \"Alice\", userId: \"uid1\" });\n  });\n});\n\ndescribe(\"toPlainText\", () => {\n  test(\"replaces mention syntax with @Name\", () => {\n    expect(toPlainText(\"Hey @[Alice](uid1)!\")).toBe(\"Hey @Alice!\");\n  });\n\n  test(\"no-op on plain text\", () => {\n    expect(toPlainText(\"hello\")).toBe(\"hello\");\n  });\n\n  test(\"multiple mentions\", () => {\n    expect(toPlainText(\"@[Alice](u1) and @[Bob](u2)\")).toBe(\"@Alice and @Bob\");\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 2 — `apps/api/src/server/rate-limit.ts` (in-memory token bucket)",
        "content": "\nThe `rateLimit` function drives upload throttling and `/api/execute` cost control. Its refill math and eviction logic are never exercised.\n\n**Uncovered cases:**\n- First call always allowed (full bucket)\n- Depletes to zero and blocks\n- Refills over time (fractional token accrual)\n- Memory eviction: buckets older than `perMs * 10` are cleaned when map exceeds 50 000\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { rateLimit } from \"../src/server/rate-limit\";\n\nconst key = (label: string) => `test:${label}:${Math.random()}`;\n\ndescribe(\"rateLimit\", () => {\n  test(\"first call is always allowed\", () => {\n    expect(rateLimit(key(\"first\"), 5, 1000)).toBe(true);\n  });\n\n  test(\"allows up to capacity calls in one window\", () => {\n    const k = key(\"capacity\");\n    const results = Array.from({ length: 3 }, () => rateLimit(k, 3, 60_000));\n    expect(results).toEqual([true, true, true]);\n  });\n\n  test(\"blocks the call after capacity is exhausted\", () => {\n    const k = key(\"block\");\n    rateLimit(k, 2, 60_000);\n    rateLimit(k, 2, 60_000);\n    expect(rateLimit(k, 2, 60_000)).toBe(false);\n  });\n\n  test(\"refills tokens proportionally after time passes\", async () => {\n    const k = key(\"refill\");\n    const perMs = 100;\n    rateLimit(k, 1, perMs); // consume the single token\n    expect(rateLimit(k, 1, perMs)).toBe(false); // still empty\n    await Bun.sleep(perMs + 10);              // wait for a full refill\n    expect(rateLimit(k, 1, perMs)).toBe(true);\n  });\n\n  test(\"independent keys do not interfere\", () => {\n    const k1 = key(\"iso1\");\n    const k2 = key(\"iso2\");\n    rateLimit(k1, 1, 60_000);\n    rateLimit(k1, 1, 60_000); // exhaust k1\n    expect(rateLimit(k2, 1, 60_000)).toBe(true); // k2 untouched\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 3 — `apps/api/src/lib/errors.ts` (`toErrorResponse`)",
        "content": "\n`toErrorResponse` normalises every thrown value into the wire envelope. It has six distinct branches: `HttpError`, four `ORMError` reasons, and the catch-all. None are directly tested.\n\n**Uncovered cases:**\n- Each `HttpError` helper maps to correct HTTP status and code\n- `ORMError.REJECTED_BY_POLICY` always returns 403 with `FORBIDDEN` (never leaks the real reason)\n- `ORMError.DB_QUERY_ERROR` with PG code `23505` → 409 `CONFLICT`\n- `ORMError.DB_QUERY_ERROR` with PG code `23503` → 409 `CONFLICT`\n- Unknown errors → 500 `INTERNAL` and must not include stack traces or raw SQL\n\n```ts\n// apps/api/tests/errors.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  badRequest,\n  conflict,\n  forbidden,\n  notFound,\n  tooManyRequests,\n  unauthorized,\n  upstreamError,\n  toErrorResponse,\n} from \"../src/lib/errors\";\n\ndescribe(\"HttpError helpers\", () => {\n  const cases = [\n    { fn: () => badRequest(\"bad\"), status: 400, code: \"INVALID_INPUT\" },\n    { fn: () => notFound(), status: 404, code: \"NOT_FOUND\" },\n    { fn: () => forbidden(\"no\"), status: 403, code: \"FORBIDDEN\" },\n    { fn: () => conflict(\"dup\"), status: 409, code: \"CONFLICT\" },\n    { fn: () => unauthorized(), status: 401, code: \"UNAUTHORIZED\" },\n    { fn: () => tooManyRequests(), status: 429, code: \"INVALID_STATE\" },\n    { fn: () => upstreamError(\"down\"), status: 502, code: \"UPSTREAM_ERROR\" },\n  ] as const;\n\n  for (const { fn, status, code } of cases) {\n    test(`${code} → HTTP ${status}`, () => {\n      const err = fn();\n      expect(err).toBeInstanceOf(HttpError);\n      const { status: s, body } = toErrorResponse(err);\n      expect(s).toBe(status);\n      expect(body.error.code).toBe(code);\n    });\n  }\n});\n\ndescribe(\"toErrorResponse — ORMError branches\", () => {\n  const makeOrm = (reason: ORMErrorReason, dbCode?: string) => {\n    const e = new ORMError(\"msg\", reason);\n    if (dbCode) (e as any).dbErrorCode = dbCode;\n    return e;\n  };\n\n  test(\"INVALID_INPUT → 400\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.INVALID_INPUT));\n    expect(status).toBe(400);\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"NOT_FOUND → 404\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.NOT_FOUND));\n    expect(status).toBe(404);\n  });\n\n  test(\"REJECTED_BY_POLICY → 403, message is generic (never leaks policy reason)\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.REJECTED_BY_POLICY));\n    expect(status).toBe(403);\n    expect(body.error.message).toBe(\"Operation not permitted\");\n  });\n\n  test(\"unique violation (23505) → 409 CONFLICT\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23505\"));\n    expect(status).toBe(409);\n    expect(body.error.code).toBe(\"CONFLICT\");\n  });\n\n  test(\"FK violation (23503) → 409 CONFLICT\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23503\"));\n    expect(status).toBe(409);\n  });\n});\n\ndescribe(\"toErrorResponse — unknown errors\", () => {\n  test(\"plain Error → 500 INTERNAL (no leak)\", () => {\n    const { status, body } = toErrorResponse(new Error(\"secret sql query\"));\n    expect(status).toBe(500);\n    expect(body.error.code).toBe(\"INTERNAL\");\n    expect(body.error.message).not.toContain(\"sql\");\n  });\n\n  test(\"thrown string → 500 INTERNAL\", () => {\n    const { status } = toErrorResponse(\"oops\");\n    expect(status).toBe(500);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 4 — `apps/api/src/websocket/hub.ts` (`Conn`, room management)",
        "content": "\n`hub.ts` contains the only shared mutable state for realtime: room membership, connection registry, and the `dispatch` loop. No test touches it.\n\n**Uncovered cases:**\n- `Conn.join` / `Conn.leave` maintain `members` map correctly; leaving the last member cleans up the entry\n- `Conn.dispatch` invokes the registered handler; unknown events get an ack error; non-object payloads are coerced to `{}`\n- `Conn.broadcast` excludes the sender but reaches every other conn in the room\n- `emitTo` with multiple overlapping rooms sends exactly one frame per connection\n- `joinUserToRoom` / `removeUserFromRoom` propagate to all user connections\n- `connectionCount` returns 0 for unknown users, increments on join, decrements on dispose\n- `clearRoom` evicts all members\n\n```ts\n// apps/api/tests/hub.test.ts\nimport { describe, expect, mock, test } from \"bun:test\";\nimport { Conn, clearRoom, connectionCount, emitTo, joinUserToRoom, onlineUserIds, register, removeUserFromRoom, rooms, unregister } from \"../src/websocket/hub\";\n\nfunction makeSock() {\n  const frames: string[] = [];\n  return {\n    raw: { send: (d: string) => { frames.push(d); }, close: () => {} },\n    frames,\n  };\n}\n\nfunction makeUser(id: string) {\n  return { id, email: `${id}@test.com`, role: \"user\" as const };\n}\n\nfunction makeConn(userId: string) {\n  const { raw, frames } = makeSock();\n  return { conn: new Conn(raw, makeUser(userId)), frames };\n}\n\ndescribe(\"Conn.join / Conn.leave\", () => {\n  test(\"join adds connection to room; leave removes it\", () => {\n    const { conn } = makeConn(\"u1\");\n    const room = \"test:room:join\";\n    conn.join(room);\n    emitTo([room], \"post.created\" as any, {} as any);\n    conn.leave(room);\n    // After leave, a further emit should not reach this conn\n    const { frames } = makeSock();\n    emitTo([room], \"post.created\" as any, {} as any);\n    // conn.frames only grew by 1 (the pre-leave emit)\n    expect(conn.rooms.has(room)).toBe(false);\n  });\n\n  test(\"leaving the last connection deletes the room entry (no memory leak)\", () => {\n    const { conn } = makeConn(\"u2\");\n    const room = \"test:room:empty\";\n    conn.join(room);\n    conn.leave(room);\n    // Emitting to the now-empty room should be a no-op\n    expect(() => emitTo([room], \"post.created\" as any, {} as any)).not.toThrow();\n  });\n});\n\ndescribe(\"Conn.dispatch\", () => {\n  test(\"calls the registered handler\", () => {\n    const { conn } = makeConn(\"u3\");\n    const fn = mock(() => {});\n    conn.on(\"typing\" as any, fn);\n    conn.dispatch(\"typing\", { conversationId: \"c1\" });\n    expect(fn).toHaveBeenCalledTimes(1);\n  });\n\n  test(\"unknown event sends ack error when reqId present\", () => {\n    const { conn, frames } = makeConn(\"u4\");\n    conn.dispatch(\"unknown_event\", {}, 42);\n    const ack = JSON.parse(frames.at(-1)!);\n    expect(ack.ack).toBe(42);\n    expect(ack.res.ok).toBe(false);\n  });\n\n  test(\"non-object payload is coerced to {} before handler\", () => {\n    const { conn } = makeConn(\"u5\");\n    const fn = mock((_payload: object) => {});\n    conn.on(\"typing\" as any, fn);\n    conn.dispatch(\"typing\", \"bad-payload\");\n    expect(fn).toHaveBeenCalledWith({}, expect.any(Function));\n  });\n});\n\ndescribe(\"Conn.broadcast\", () => {\n  test(\"reaches other connections in the room but not the sender\", () => {\n    const room = \"test:room:broadcast\";\n    const { conn: sender } = makeConn(\"sender\");\n    const { conn: other, frames: otherFrames } = makeConn(\"other\");\n\n    sender.join(room);\n    other.join(room);\n    sender.broadcast(room, \"post.created\" as any, {} as any);\n\n    expect(otherFrames.length).toBe(1);\n    sender.leave(room);\n    other.leave(room);\n  });\n});\n\ndescribe(\"emitTo deduplication\", () => {\n  test(\"a connection in two target rooms receives exactly one frame\", () => {\n    const room1 = \"test:dedup:r1\";\n    const room2 = \"test:dedup:r2\";\n    const { conn, frames } = makeConn(\"u6\");\n    conn.join(room1);\n    conn.join(room2);\n    emitTo([room1, room2], \"post.created\" as any, {} as any);\n    expect(frames.length).toBe(1);\n    conn.leave(room1);\n    conn.leave(room2);\n  });\n});\n\ndescribe(\"connectionCount / onlineUserIds / register / unregister\", () => {\n  test(\"connectionCount is 0 before registration\", () => {\n    expect(connectionCount(\"never_registered\")).toBe(0);\n  });\n\n  test(\"register increments count; unregister decrements\", () => {\n    const { conn } = makeConn(\"u7\");\n    register(conn);\n    expect(connectionCount(\"u7\")).toBe(1);\n    unregister(conn);\n    expect(connectionCount(\"u7\")).toBe(0);\n  });\n\n  test(\"onlineUserIds includes registered user\", () => {\n    const { conn } = makeConn(\"u8\");\n    register(conn);\n    expect(onlineUserIds().has(\"u8\")).toBe(true);\n    unregister(conn);\n    expect(onlineUserIds().has(\"u8\")).toBe(false);\n  });\n});\n\ndescribe(\"joinUserToRoom / removeUserFromRoom / clearRoom\", () => {\n  test(\"joinUserToRoom subscribes all existing connections of a user\", () => {\n    const room = \"test:join-user:r1\";\n    const { conn, frames } = makeConn(\"u9\");\n    register(conn);\n    joinUserToRoom(\"u9\", room);\n    emitTo([room], \"post.created\" as any, {} as any);\n    expect(frames.length).toBeGreaterThan(0);\n    unregister(conn);\n  });\n\n  test(\"removeUserFromRoom unsubscribes all connections of a user\", () => {\n    const room = \"test:remove-user:r1\";\n    const { conn, frames } = makeConn(\"u10\");\n    register(conn);\n    joinUserToRoom(\"u10\", room);\n    removeUserFromRoom(\"u10\", room);\n    const before = frames.length;\n    emitTo([room], \"post.created\" as any, {} as any);\n    expect(frames.length).toBe(before);\n    unregister(conn);\n  });\n\n  test(\"clearRoom evicts all connections\", () => {\n    const room = \"test:clear:r1\";\n    const { conn } = makeConn(\"u11\");\n    conn.join(room);\n    clearRoom(room);\n    expect(conn.rooms.has(room)).toBe(false);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 5 — `POST /api/conversations/direct` route",
        "content": "\nThe route has a race-condition branch (`raced?.members.length`) that is untestable without simulating a concurrent duplicate insert. The self-message guard and deduplication by `directKey` are also uncovered.\n\n**Uncovered cases:**\n- Calling with `userId === user.id` → 400 `INVALID_INPUT`\n- First call creates the conversation (201) with correct `directKey`\n- Second call with the same pair returns the existing id (200, idempotent)\n- `directKey` is order-independent: `(A, B)` and `(B, A)` resolve to the same conversation\n- Race-condition fallback: policy client creates fails with unique violation, fallback reads the db-level client\n\n```ts\n// apps/api/tests/conversations.test.ts\n// Integration test — requires a seeded database and running app (same pattern as policies.test.ts)\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { seedOrg } from \"./helpers/seed\"; // create two members in an org\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: \"o1\", userId: \"u2\" }),\n      }),\n    );\n    expect(res.status).toBe(401);\n  });\n\n  test(\"rejects self-message\", async () => {\n    const { cookie, user } = await seedOrg();\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { cookie, \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: user.organizationId, userId: user.id }),\n      }),\n    );\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"creates a new direct conversation (201) and deduplicates on repeat (200)\", async () => {\n    const { cookie, user, other, orgId } = await seedOrg();\n\n    const res1 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res1.status).toBe(201);\n    const { data: conv1 } = await res1.json();\n\n    const res2 = await app.handle(postDirect(cookie, orgId, other.id));\n    expect(res2.status).toBe(200);\n    const { data: conv2 } = await res2.json();\n    expect(conv2.id).toBe(conv1.id);\n  });\n\n  test(\"directKey is order-independent: (A,B) and (B,A) share the same conversation\", async () => {\n    const { cookieA, cookieB, orgId, userA, userB } = await seedOrg();\n    const res1 = await app.handle(postDirect(cookieA, orgId, userB.id));\n    const res2 = await app.handle(postDirect(cookieB, orgId, userA.id));\n    const { data: c1 } = await res1.json();\n    const { data: c2 } = await res2.json();\n    expect(c1.id).toBe(c2.id);\n  });\n});\n\nfunction postDirect(cookie: string, organizationId: string, userId: string) {\n  return new Request(\"http://localhost/api/conversations/direct\", {\n    method: \"POST\",\n    headers: { cookie, \"content-type\": \"application/json\" },\n    body: JSON.stringify({ organizationId, userId }),\n  });\n}\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 6 — `POST /api/uploads` route",
        "content": "\nThe MIME-type blocklist and `orgVisible` image-only guard are key security controls that are untested.\n\n**Uncovered cases:**\n- Blocked MIME types (`text/html`, `application/javascript`, `image/svg+xml`) → 400\n- `orgVisible: true` with a non-image MIME → 400\n- `orgVisible: true` with an image MIME → allowed\n- Storage not configured → 502 `UPSTREAM_ERROR`\n- Rate limit exceeded after 30 uploads/min → 429\n- `name` sanitization: `name` with `..` / special chars produces a safe S3 key\n- File `size` at boundary: `size = MAX_UPLOAD_BYTES` passes; `size = MAX_UPLOAD_BYTES + 1` is rejected by Elysia body validation\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { BLOCKED } from \"../src/routes/uploads\"; // export the regex for unit testing\n\n// Unit tests for the BLOCKED pattern (no HTTP needed)\ndescribe(\"BLOCKED mime type regex\", () => {\n  const blocked = [\n    \"text/html\",\n    \"application/javascript\",\n    \"application/x-javascript\",\n    \"application/ecmascript\",\n    \"image/svg+xml\",\n    \"application/xhtml+xml\",\n    \"TEXT/HTML\",                    // case-insensitive\n  ];\n  const allowed = [\n    \"image/png\",\n    \"image/jpeg\",\n    \"application/pdf\",\n    \"application/zip\",\n    \"video/mp4\",\n    \"audio/mpeg\",\n    \"text/plain\",                   // plain text OK\n  ];\n\n  for (const mime of blocked) {\n    test(`blocks ${mime}`, () => expect(BLOCKED.test(mime)).toBe(true));\n  }\n  for (const mime of allowed) {\n    test(`allows ${mime}`, () => expect(BLOCKED.test(mime)).toBe(false));\n  }\n});\n\n// Integration tests (require storage configured or mocked)\ndescribe(\"POST /api/uploads — integration\", () => {\n  test(\"returns 400 for blocked MIME type\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"text/html\", name: \"evil.html\", size: 100 }));\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"returns 400 when orgVisible=true for non-image\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"application/pdf\", name: \"doc.pdf\", size: 100, orgVisible: true }));\n    expect(res.status).toBe(400);\n  });\n\n  test(\"allows orgVisible=true for images\", async () => {\n    const { cookie, orgId } = await seedOrg();\n    const res = await app.handle(postUpload(cookie, { organizationId: orgId, mimeType: \"image/png\", name: \"photo.png\", size: 1024, orgVisible: true }));\n    // 201 or 502 (if storage not configured) — neither is 400\n    expect([201, 502]).toContain(res.status);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 7 — `GET /api/rtc/ice` route",
        "content": "\nThe HMAC credential generation is a security-critical path (time-limited TURN credentials). The formula must match coturn's `use-auth-secret` spec exactly.\n\n**Uncovered cases:**\n- Without `TURN_SECRET` set: response includes only STUN\n- With `TURN_SECRET` set: response includes TURN with `username` in `{epoch}:{userId}` form\n- HMAC credential is verifiable: `HMAC-SHA1(secret, username)` base64\n- `cache-control: private, no-store` header always present\n- TTL is `6 * 60 * 60` = 21 600 seconds\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, test } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  test(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  test(\"returns cache-control: private, no-store\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    expect(res.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n  });\n\n  test(\"always includes at least one STUN server\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.iceServers.some((s: any) => s.urls.some((u: string) => u.startsWith(\"stun:\")))).toBe(true);\n  });\n\n  test(\"TURN credential follows coturn use-auth-secret formula\", () => {\n    const secret = \"test-secret\";\n    const userId = \"user_abc\";\n    const TTL = 6 * 60 * 60;\n    const epoch = Math.floor(Date.now() / 1000) + TTL;\n    const username = `${epoch}:${userId}`;\n    const expected = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    // Verify the formula matches what the route produces\n    expect(expected).toMatch(/^[A-Za-z0-9+/]+=*$/); // valid base64\n    expect(username.split(\":\")[1]).toBe(userId);\n  });\n\n  test(\"ttl in response equals 21600 seconds\", async () => {\n    const { cookie } = await seedOrg();\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n    const { data } = await res.json();\n    expect(data.ttl).toBe(21600);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 8 — Missing edge cases in existing `execute.test.ts`",
        "content": "\n| Missing case | Why it matters |\n|---|---|\n| `args: null` → treated as `{}` (the route does `body.args ?? {}`) | A client sending `\"args\": null` must not crash the handler |\n| Rate limit: 301st request in one minute → 429 | The 300/min cap is the primary DoS defence on `/api/execute` |\n| `findMany` with `take: 0` → `take` is set to `MAX_TAKE` (sign of `0` is `+1`) | Edge case in `Math.sign(take \\|\\| 1)` |\n| `findMany` with `take: -200` → `take: -100` (preserves negative) | Backward pagination must still be bounded |\n| Model name with correct case (`Post` vs `post`) | `MODELS` set uses camelCase; wrong case must be rejected |\n\n```ts\n// Additions to apps/api/tests/execute.test.ts\n\ntest(\"args: null is treated as {} (no crash)\", async () => {\n  // POST with \"args\": null in JSON body\n  const res = await app.handle(\n    authed(new Request(\"http://localhost/api/execute\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify({ model: \"user\", operator: \"findMany\", args: null }),\n    })),\n  );\n  // Should succeed or fail with a policy error, not a 500\n  expect(res.status).not.toBe(500);\n});\n\ntest(\"rate limit: 301st execute in a minute → 429\", async () => {\n  // exhaust the 300/min bucket\n  for (let i = 0; i < 300; i++) {\n    await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  }\n  const res = await app.handle(executeReq(cookie, \"user\", \"findMany\", {}));\n  expect(res.status).toBe(429);\n});\n\ntest(\"findMany take:0 → clamped to MAX_TAKE (sign of 0 is treated as +1)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: 0 });\n  expect(result.take).toBe(MAX_TAKE);\n});\n\ntest(\"findMany take:-200 → take:-100 (negative preserved, magnitude capped)\", () => {\n  const result = guardExecute(\"user\", \"findMany\", { take: -200 });\n  expect(result.take).toBe(-MAX_TAKE);\n});\n\ntest(\"wrong model casing is rejected\", () => {\n  expect(() => guardExecute(\"Post\", \"findMany\", {})).toThrow();\n  expect(() => guardExecute(\"post\", \"findMany\", {})).not.toThrow();\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Gap 9 — Integration: `policies.test.ts` missing scenarios",
        "content": "\n| Gap | Location in `policies.test.ts` |\n|---|---|\n| **CLOSED group join request** never tested end-to-end: a pending member cannot post, approved member can | Group Access Control section |\n| **Group post moved cross-group** is blocked by policy — but the test only checks it at the `update` level; a `delete`+`create` workaround across groups is not tested | Post Management section |\n| **Call created with >6 participants** is not rejected (no participant cap test) | Call section |\n| **Notification `recipientId` must match `auth().id`** — a user cannot read another user's notifications | Notification section |\n| **Calendar event with `endAt <= startAt`** is rejected | Calendar section — `end must be after start` test exists but only checks equal timestamps; `endAt < startAt` (strictly before) is not explicitly covered |\n| **Message of type `SYSTEM` or `CALL`** cannot be created by a user (server-only) | Chat section — messages are tested but not the type restriction |\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Priority order for implementation",
        "content": "1. **`mentions.test.ts`** — pure functions, zero external deps, highest ROI\n2. **`errors.test.ts`** — pure logic, the error envelope is on every API response\n3. **`rate-limit.test.ts`** — pure-ish, needs only `Bun.sleep`\n4. **`hub.test.ts`** — no DB needed, mocked sockets; covers the realtime backbone\n5. **`execute.test.ts` additions** — extend the existing file with the edge cases above\n6. **`rtc.test.ts`** — HMAC formula correctness is security-critical\n7. **`conversations.test.ts`** — integration, needs seeded DB (same infra as `policies.test.ts`)\n8. **`uploads.test.ts`** — MIME blocklist unit tests are free; integration needs storage mock\n9. **`policies.test.ts` additions** — fill the remaining scenario gaps in the existing suite",
        "level": 3
      }
    ],
    "codeBlocks": [
      {
        "language": "ts",
        "code": "// apps/api/tests/mentions.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport {\n  extractMentionIds,\n  formatMention,\n  parseText,\n  toPlainText,\n} from \"@app/shared/mentions\";\n\ndescribe(\"formatMention\", () => {\n  test(\"produces the canonical inline format\", () => {\n    expect(formatMention(\"Alice\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"strips brackets from the display name\", () => {\n    expect(formatMention(\"A[lic]e\", \"user_123\")).toBe(\"@[Alice](user_123)\");\n  });\n\n  test(\"handles empty display name\", () => {\n    expect(formatMention(\"\", \"user_123\")).toBe(\"@[](user_123)\");\n  });\n});\n\ndescribe(\"extractMentionIds\", () => {\n  test(\"returns empty array for plain text\", () => {\n    expect(extractMentionIds(\"hello world\")).toEqual([]);\n  });\n\n  test(\"extracts a single mention\", () => {\n    expect(extractMentionIds(\"hey @[Alice](uid1) how are you\")).toEqual([\"uid1\"]);\n  });\n\n  test(\"deduplicates repeated mentions of the same user\", () => {\n    const text = \"@[Alice](uid1) and @[Alice](uid1) again\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\"]);\n  });\n\n  test(\"extracts multiple distinct users\", () => {\n    const text = \"@[Alice](uid1) @[Bob](uid2)\";\n    expect(extractMentionIds(text)).toEqual([\"uid1\", \"uid2\"]);\n  });\n\n  test(\"ignores malformed mention-like strings\", () => {\n    expect(extractMentionIds(\"@[Alice] @(uid1)\")).toEqual([]);\n  });\n});\n\ndescribe(\"parseText\", () => {\n  test(\"plain text produces a single text segment\", () => {\n    expect(parseText(\"hello world\")).toEqual([{ kind: \"text\", text: \"hello world\" }]);\n  });\n\n  test(\"mention-only string\", () => {\n    expect(parseText(\"@[Alice](uid1)\")).toEqual([\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n    ]);\n  });\n\n  test(\"URL-only string\", () => {\n    const segs = parseText(\"https://example.com\");\n    expect(segs).toEqual([{ kind: \"link\", url: \"https://example.com\" }]);\n  });\n\n  test(\"interleaved text, mention, and URL\", () => {\n    const segs = parseText(\"See @[Alice](uid1) at https://example.com today\");\n    expect(segs).toEqual([\n      { kind: \"text\", text: \"See \" },\n      { kind: \"mention\", name: \"Alice\", userId: \"uid1\" },\n      { kind: \"text\", text: \" at \" },\n      { kind: \"link\", url: \"https://example.com\" },\n      { kind: \"text\", text: \" today\" },\n    ]);\n  });\n\n  test(\"consecutive mentions produce no phantom text segment between them\", () => {\n    const segs = parseText(\"@[Alice](uid1)@[Bob](uid2)\");\n    expect(segs.every((s) => s.kind !== \"text\" || s.text.length > 0)).toBe(true);\n    expect(segs.filter((s) => s.kind === \"mention\")).toHaveLength(2);\n  });\n\n  test(\"mention at the very start of text\", () => {\n    const segs = parseText(\"@[Alice](uid1) hello\");\n    expect(segs[0]).toEqual({ kind: \"mention\", name: \"Alice\", userId: \"uid1\" });\n  });\n});\n\ndescribe(\"toPlainText\", () => {\n  test(\"replaces mention syntax with @Name\", () => {\n    expect(toPlainText(\"Hey @[Alice](uid1)!\")).toBe(\"Hey @Alice!\");\n  });\n\n  test(\"no-op on plain text\", () => {\n    expect(toPlainText(\"hello\")).toBe(\"hello\");\n  });\n\n  test(\"multiple mentions\", () => {\n    expect(toPlainText(\"@[Alice](u1) and @[Bob](u2)\")).toBe(\"@Alice and @Bob\");\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { rateLimit } from \"../src/server/rate-limit\";\n\nconst key = (label: string) => `test:${label}:${Math.random()}`;\n\ndescribe(\"rateLimit\", () => {\n  test(\"first call is always allowed\", () => {\n    expect(rateLimit(key(\"first\"), 5, 1000)).toBe(true);\n  });\n\n  test(\"allows up to capacity calls in one window\", () => {\n    const k = key(\"capacity\");\n    const results = Array.from({ length: 3 }, () => rateLimit(k, 3, 60_000));\n    expect(results).toEqual([true, true, true]);\n  });\n\n  test(\"blocks the call after capacity is exhausted\", () => {\n    const k = key(\"block\");\n    rateLimit(k, 2, 60_000);\n    rateLimit(k, 2, 60_000);\n    expect(rateLimit(k, 2, 60_000)).toBe(false);\n  });\n\n  test(\"refills tokens proportionally after time passes\", async () => {\n    const k = key(\"refill\");\n    const perMs = 100;\n    rateLimit(k, 1, perMs); // consume the single token\n    expect(rateLimit(k, 1, perMs)).toBe(false); // still empty\n    await Bun.sleep(perMs + 10);              // wait for a full refill\n    expect(rateLimit(k, 1, perMs)).toBe(true);\n  });\n\n  test(\"independent keys do not interfere\", () => {\n    const k1 = key(\"iso1\");\n    const k2 = key(\"iso2\");\n    rateLimit(k1, 1, 60_000);\n    rateLimit(k1, 1, 60_000); // exhaust k1\n    expect(rateLimit(k2, 1, 60_000)).toBe(true); // k2 untouched\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/errors.test.ts\nimport { describe, expect, test } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  badRequest,\n  conflict,\n  forbidden,\n  notFound,\n  tooManyRequests,\n  unauthorized,\n  upstreamError,\n  toErrorResponse,\n} from \"../src/lib/errors\";\n\ndescribe(\"HttpError helpers\", () => {\n  const cases = [\n    { fn: () => badRequest(\"bad\"), status: 400, code: \"INVALID_INPUT\" },\n    { fn: () => notFound(), status: 404, code: \"NOT_FOUND\" },\n    { fn: () => forbidden(\"no\"), status: 403, code: \"FORBIDDEN\" },\n    { fn: () => conflict(\"dup\"), status: 409, code: \"CONFLICT\" },\n    { fn: () => unauthorized(), status: 401, code: \"UNAUTHORIZED\" },\n    { fn: () => tooManyRequests(), status: 429, code: \"INVALID_STATE\" },\n    { fn: () => upstreamError(\"down\"), status: 502, code: \"UPSTREAM_ERROR\" },\n  ] as const;\n\n  for (const { fn, status, code } of cases) {\n    test(`${code} → HTTP ${status}`, () => {\n      const err = fn();\n      expect(err).toBeInstanceOf(HttpError);\n      const { status: s, body } = toErrorResponse(err);\n      expect(s).toBe(status);\n      expect(body.error.code).toBe(code);\n    });\n  }\n});\n\ndescribe(\"toErrorResponse — ORMError branches\", () => {\n  const makeOrm = (reason: ORMErrorReason, dbCode?: string) => {\n    const e = new ORMError(\"msg\", reason);\n    if (dbCode) (e as any).dbErrorCode = dbCode;\n    return e;\n  };\n\n  test(\"INVALID_INPUT → 400\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.INVALID_INPUT));\n    expect(status).toBe(400);\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  test(\"NOT_FOUND → 404\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.NOT_FOUND));\n    expect(status).toBe(404);\n  });\n\n  test(\"REJECTED_BY_POLICY → 403, message is generic (never leaks policy reason)\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.REJECTED_BY_POLICY));\n    expect(status).toBe(403);\n    expect(body.error.message).toBe(\"Operation not permitted\");\n  });\n\n  test(\"unique violation (23505) → 409 CONFLICT\", () => {\n    const { status, body } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23505\"));\n    expect(status).toBe(409);\n    expect(body.error.code).toBe(\"CONFLICT\");\n  });\n\n  test(\"FK violation (23503) → 409 CONFLICT\", () => {\n    const { status } = toErrorResponse(makeOrm(ORMErrorReason.DB_QUERY_ERROR, \"23503\"));\n    expect(status).toBe(409);\n  });\n});\n\ndescribe(\"toErrorResponse — unknown errors\", () => {\n  test(\"plain Error → 500 INTERNAL (no leak)\", () => {\n    const { status, body } = toErrorResponse(new Error(\"secret sql query\"));\n    expect(status).toBe(500);\n    expect(body.error.code).toBe(\"INTERNAL\");\n    expect(body.error.message).not.toContain(\"sql\");\n  });\n\n  test(\"thrown string → 500 INTERNAL\", () => {\n    const { status } = toErrorResponse(\"oops\");\n    expect(status).toBe(500);\n  });\n});"
      },
