      {
        "title": "P1 — High-value missing integration tests",
        "content": "\n**6. Banned user access (routes)**\n\n```ts\n// apps/api/tests/banned-user.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndescribe(\"banned user\", () => {\n  it(\"receives 403 from auth-guarded routes\", async () => {\n    // Create a banned user, sign them in, verify every route returns 403\n    // The auth macro in plugins/auth.ts throws forbidden() when user.banned is true\n    // Implement once test-login helper exists\n    // const cookie = await signInAsBannedUser();\n    // const res = await app.handle(new Request(\"http://localhost/api/execute\", {\n    //   method: \"POST\", headers: { cookie, \"content-type\": \"application/json\" },\n    //   body: JSON.stringify({ model: \"user\", operator: \"findMany\", args: {} }),\n    // }));\n    // expect(res.status).toBe(403);\n    // const b = await res.json();\n    // expect(b.error.code).toBe(\"FORBIDDEN\");\n  });\n});\n```\n\n---\n\n**7. `guardExecute` edge cases not yet covered**\n\n```ts\n// Append to apps/api/tests/execute.test.ts\n\ndescribe(\"guardExecute — additional cases\", () => {\n  it(\"allows all permitted models\", () => {\n    // ensure every MODELS entry passes guard without throwing\n    for (const m of MODELS) {\n      expect(() => guardExecute(m, \"findMany\", {})).not.toThrow();\n    }\n  });\n\n  it(\"allows all permitted CRUD operators\", () => {\n    for (const op of [\"findUnique\", \"findFirst\", \"findMany\", \"create\", \"createMany\", \"update\", \"updateMany\", \"delete\", \"deleteMany\", \"count\", \"aggregate\"]) {\n      expect(() => guardExecute(\"user\", op, {})).not.toThrow();\n    }\n  });\n\n  it(\"does not mutate args object — only wraps take\", () => {\n    const args = { where: { id: \"x\" }, take: 5 };\n    const result = guardExecute(\"post\", \"findMany\", args);\n    expect(result.take).toBe(5);\n    expect(result.where).toEqual({ id: \"x\" });\n  });\n\n  it(\"caps take at MAX_TAKE even for findFirst/findUnique (take has no effect but shouldn't crash)\", () => {\n    // findFirst with take should still be capped rather than throwing\n    expect(() => guardExecute(\"post\", \"findFirst\", { take: 9999 })).not.toThrow();\n  });\n});\n```\n\n---\n\n**8. Policy error-code coverage — missing `@@allow`-less model behaviour**\n\n```ts\n// Append to apps/api/tests/policies.test.ts\n\ndescribe(\"policy enforcement edge cases\", () => {\n  it(\"count returns 0 for rows the caller cannot see\", async () => {\n    // carol is in orgB — she should count 0 for orgA groups\n    const count = await as(\"carol\").group.count({ where: { organizationId: orgA } });\n    expect(count).toBe(0);\n  });\n\n  it(\"aggregate returns zeroed stats for rows the caller cannot see\", async () => {\n    const agg = await as(\"carol\").post.aggregate({\n      where: { groupId: publicGroup },\n      _count: true,\n    });\n    expect(agg._count).toBe(0);\n  });\n\n  it(\"update sees not-found rather than forbidden for cross-tenant rows\", async () => {\n    await rejected(\n      as(\"carol\").post.update({\n        where: { id: postId },\n        data: { content: \"update from another org\" },\n      }),\n    );\n    // The row should still be intact\n    const still = await as(\"alice\").post.findUnique({ where: { id: postId } });\n    expect(still).not.toBeNull();\n  });\n});\n```\n\n---\n\n**9. Attachment policy — post-update immutability (re-use prevention)**\n\n```ts\n// Append to apps/api/tests/policies.test.ts  (inside describe(\"attachments\"))\n\nit(\"cannot re-attach a draft to a different post once used\", async () => {\n  const att = await as(\"alice\").attachment.create({\n    data: {\n      organizationId: orgA,\n      key: `test/${run}/reuse.png`,\n      name: \"reuse.png\",\n      mimeType: \"image/png\",\n      size: 1,\n    },\n  });\n  const p1 = await as(\"alice\").post.create({\n    data: { groupId: publicGroup, content: \"p1\", attachments: { connect: [{ id: att.id }] } },\n  });\n  // try to steal by connecting to a different post\n  await rejected(\n    as(\"alice\").attachment.update({\n      where: { id: att.id },\n      data: { postId: p1.id }, // already attached — moving to another post must be denied\n    }),\n  );\n});\n```\n\n---\n\n**10. Chat — typing to a conversation you're not a member of**\n\n```ts\n// Append to apps/api/tests/policies.test.ts  (inside describe(\"chat\"))\n\nit(\"cannot read messages from a conversation you joined a different org's version of\", async () => {\n  const convoB = await as(\"carol\").conversation.create({\n    data: {\n      organizationId: orgB,\n      type: \"GROUP\",\n      title: \"carol-only\",\n      members: { create: [{ userId: users.carol.id, role: \"ADMIN\" }] },\n    },\n  });\n  // alice has no membership in orgB; she must see nothing\n  expect(await as(\"alice\").message.findMany({ where: { conversationId: convoB.id } })).toEqual([]);\n  await rejected(\n    as(\"alice\").message.create({ data: { conversationId: convoB.id, content: \"infiltrate\" } }),\n  );\n});\n```\n\n---\n\n**11. Multi-choice poll: votes from different users allowed**\n\n```ts\n// Append to apps/api/tests/policies.test.ts  (inside describe(\"polls\"))\n\nit(\"multiple users can each vote once on the same option\", async () => {\n  const post = await as(\"alice\").post.create({\n    data: {\n      groupId: publicGroup,\n      type: \"POLL\",\n      poll: {\n        create: {\n          question: \"Tea?\",\n          options: { create: [{ text: \"Yes\" }] },\n        },\n      },\n    },\n    include: { poll: { include: { options: true } } },\n  });\n  const [opt] = post.poll?.options ?? [];\n  if (!opt) throw new Error(\"poll option missing\");\n  await as(\"alice\").pollVote.create({ data: { pollId: post.poll!.id, optionId: opt.id } });\n  await as(\"bob\").pollVote.create({ data: { pollId: post.poll!.id, optionId: opt.id } });\n  const count = await as(\"alice\").pollVote.count({ where: { pollId: post.poll!.id } });\n  expect(count).toBe(2);\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "P2 — Coverage hardening",
        "content": "\n**12. Error envelope shape — ensure all codes map correctly**\n\n```ts\n// apps/api/tests/error-envelope.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndescribe(\"error envelope\", () => {\n  it(\"404 for unknown API route\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/does-not-exist\"));\n    expect(res.status).toBe(404);\n    const b = await res.json() as { error: { code: string; message: string } };\n    expect(b.error.code).toBe(\"NOT_FOUND\");\n    expect(typeof b.error.message).toBe(\"string\");\n  });\n\n  it(\"400 for malformed JSON body\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/execute\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: \"{ not valid json\",\n    }));\n    expect([400, 401]).toContain(res.status);\n  });\n\n  it(\"successful response always wraps in { data: ... }\", async () => {\n    // Use any public, no-auth endpoint if one exists; otherwise skip\n    // const res = await app.handle(new Request(\"http://localhost/health\"));\n    // const b = await res.json();\n    // expect(\"data\" in b || \"error\" in b).toBe(true);\n  });\n});\n```\n\n---\n\n",
