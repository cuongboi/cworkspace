        "language": "ts",
        "code": "// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows requests up to capacity\", () => {\n    const key = `test:${Math.random()}`;\n    for (let i = 0; i < 5; i++) expect(rateLimit(key, 5, 60_000)).toBe(true);\n    expect(rateLimit(key, 5, 60_000)).toBe(false); // 6th is denied\n  });\n\n  it(\"different keys are isolated\", () => {\n    const a = `test:${Math.random()}`;\n    const b = `test:${Math.random()}`;\n    // exhaust a\n    for (let i = 0; i < 3; i++) rateLimit(a, 3, 60_000);\n    expect(rateLimit(a, 3, 60_000)).toBe(false);\n    // b is unaffected\n    expect(rateLimit(b, 3, 60_000)).toBe(true);\n  });\n\n  it(\"refills tokens over time\", async () => {\n    const key = `test:${Math.random()}`;\n    rateLimit(key, 1, 50); // consume the only token\n    expect(rateLimit(key, 1, 50)).toBe(false);\n    await Bun.sleep(60);\n    expect(rateLimit(key, 1, 50)).toBe(true); // refilled after window\n  });\n\n  it(\"exactly at capacity boundary allows and then denies\", () => {\n    const key = `test:${Math.random()}`;\n    expect(rateLimit(key, 1, 60_000)).toBe(true);  // first is always ok\n    expect(rateLimit(key, 1, 60_000)).toBe(false); // immediately after: denied\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/uploads.test.ts\nimport { beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db, authDb } from \"@/lib/db\";\n\n// Re-use the mini fixture pattern from policies.test.ts\nconst run = Math.random().toString(36).slice(2, 8);\nconst userId = `t_${run}_uploader`;\nconst orgId = `t_${run}_org`;\nlet cookie = \"\";\n\nconst post = (body: unknown) =>\n  app.handle(\n    new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify(body),\n    }),\n  );\n\nbeforeAll(async () => {\n  await db.user.create({ data: { id: userId, email: `${userId}@test.local`, name: \"U\" } });\n  await db.organization.create({ data: { id: orgId, name: \"U-Org\", slug: `uorg-${run}`, createdAt: new Date() } });\n  await db.member.create({ data: { id: `m_${run}`, organizationId: orgId, userId, role: \"member\", createdAt: new Date() } });\n  // Sign in to get a session cookie — or mock the auth macro if easier\n  // (exact mechanism depends on whether you have a test-login helper)\n});\n\ndescribe(\"POST /api/uploads — input validation\", () => {\n  it(\"requires auth\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/uploads\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgId, name: \"f.png\", mimeType: \"image/png\", size: 1 }),\n      }),\n    );\n    expect(res.status).toBe(401);\n  });\n\n  it(\"rejects text/html\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.html\", mimeType: \"text/html\", size: 100 });\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"rejects application/javascript\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.js\", mimeType: \"application/javascript\", size: 100 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rejects image/svg+xml\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.svg\", mimeType: \"image/svg+xml\", size: 100 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rejects orgVisible with non-image type\", async () => {\n    const res = await post({\n      organizationId: orgId,\n      name: \"doc.pdf\",\n      mimeType: \"application/pdf\",\n      size: 100,\n      orgVisible: true,\n    });\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"allows orgVisible for image/* types\", async () => {\n    // Only when storage is configured; otherwise 502 is the expected response\n    const res = await post({\n      organizationId: orgId,\n      name: \"avatar.png\",\n      mimeType: \"image/png\",\n      size: 1024,\n      orgVisible: true,\n    });\n    // 201 when storage configured, 502 when not — both are non-400\n    expect([201, 502]).toContain(res.status);\n  });\n\n  it(\"returns 502 when storage is not configured\", async () => {\n    // With no S3 env vars the route returns 502 UPSTREAM_ERROR\n    const res = await post({\n      organizationId: orgId,\n      name: \"file.png\",\n      mimeType: \"image/png\",\n      size: 512,\n    });\n    // If S3 is not configured this should be 502\n    if (res.status === 502) {\n      const b = await res.json() as { error: { code: string } };\n      expect(b.error.code).toBe(\"UPSTREAM_ERROR\");\n    }\n  });\n\n  it(\"sanitizes filenames with special chars\", async () => {\n    const res = await post({\n      organizationId: orgId,\n      name: \"../../../etc/passwd\",\n      mimeType: \"image/png\",\n      size: 100,\n    });\n    // key must not contain the traversal; attachment.key should be path-safe\n    if (res.status === 201) {\n      const b = await res.json() as { data: { attachment: { key: string } } };\n      expect(b.data.attachment.key).not.toContain(\"..\");\n    }\n  });\n});"
