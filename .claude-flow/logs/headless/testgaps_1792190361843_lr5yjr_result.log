      {
        "title": "P0 — Zero coverage on critical paths",
        "content": "\n**1. `src/server/rate-limit.ts` — 0% tested**\nToken bucket is shared across all upload/execute/call rate limits. The cleanup heuristic (`> 50_000` entries), boundary at exactly 1 token, and isolation between keys are all untested.\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows requests up to capacity\", () => {\n    const key = `test:${Math.random()}`;\n    for (let i = 0; i < 5; i++) expect(rateLimit(key, 5, 60_000)).toBe(true);\n    expect(rateLimit(key, 5, 60_000)).toBe(false); // 6th is denied\n  });\n\n  it(\"different keys are isolated\", () => {\n    const a = `test:${Math.random()}`;\n    const b = `test:${Math.random()}`;\n    // exhaust a\n    for (let i = 0; i < 3; i++) rateLimit(a, 3, 60_000);\n    expect(rateLimit(a, 3, 60_000)).toBe(false);\n    // b is unaffected\n    expect(rateLimit(b, 3, 60_000)).toBe(true);\n  });\n\n  it(\"refills tokens over time\", async () => {\n    const key = `test:${Math.random()}`;\n    rateLimit(key, 1, 50); // consume the only token\n    expect(rateLimit(key, 1, 50)).toBe(false);\n    await Bun.sleep(60);\n    expect(rateLimit(key, 1, 50)).toBe(true); // refilled after window\n  });\n\n  it(\"exactly at capacity boundary allows and then denies\", () => {\n    const key = `test:${Math.random()}`;\n    expect(rateLimit(key, 1, 60_000)).toBe(true);  // first is always ok\n    expect(rateLimit(key, 1, 60_000)).toBe(false); // immediately after: denied\n  });\n});\n```\n\n---\n\n**2. `src/routes/uploads.ts` — 0% tested**\nBlocked MIME types, `orgVisible` image-only rule, and missing-storage 502 are all code paths with zero tests.\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db, authDb } from \"@/lib/db\";\n\n// Re-use the mini fixture pattern from policies.test.ts\nconst run = Math.random().toString(36).slice(2, 8);\nconst userId = `t_${run}_uploader`;\nconst orgId = `t_${run}_org`;\nlet cookie = \"\";\n\nconst post = (body: unknown) =>\n  app.handle(\n    new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify(body),\n    }),\n  );\n\nbeforeAll(async () => {\n  await db.user.create({ data: { id: userId, email: `${userId}@test.local`, name: \"U\" } });\n  await db.organization.create({ data: { id: orgId, name: \"U-Org\", slug: `uorg-${run}`, createdAt: new Date() } });\n  await db.member.create({ data: { id: `m_${run}`, organizationId: orgId, userId, role: \"member\", createdAt: new Date() } });\n  // Sign in to get a session cookie — or mock the auth macro if easier\n  // (exact mechanism depends on whether you have a test-login helper)\n});\n\ndescribe(\"POST /api/uploads — input validation\", () => {\n  it(\"requires auth\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/uploads\", {\n        method: \"POST\",\n        headers: { \"content-type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgId, name: \"f.png\", mimeType: \"image/png\", size: 1 }),\n      }),\n    );\n    expect(res.status).toBe(401);\n  });\n\n  it(\"rejects text/html\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.html\", mimeType: \"text/html\", size: 100 });\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"rejects application/javascript\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.js\", mimeType: \"application/javascript\", size: 100 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rejects image/svg+xml\", async () => {\n    const res = await post({ organizationId: orgId, name: \"x.svg\", mimeType: \"image/svg+xml\", size: 100 });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rejects orgVisible with non-image type\", async () => {\n    const res = await post({\n      organizationId: orgId,\n      name: \"doc.pdf\",\n      mimeType: \"application/pdf\",\n      size: 100,\n      orgVisible: true,\n    });\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"allows orgVisible for image/* types\", async () => {\n    // Only when storage is configured; otherwise 502 is the expected response\n    const res = await post({\n      organizationId: orgId,\n      name: \"avatar.png\",\n      mimeType: \"image/png\",\n      size: 1024,\n      orgVisible: true,\n    });\n    // 201 when storage configured, 502 when not — both are non-400\n    expect([201, 502]).toContain(res.status);\n  });\n\n  it(\"returns 502 when storage is not configured\", async () => {\n    // With no S3 env vars the route returns 502 UPSTREAM_ERROR\n    const res = await post({\n      organizationId: orgId,\n      name: \"file.png\",\n      mimeType: \"image/png\",\n      size: 512,\n    });\n    // If S3 is not configured this should be 502\n    if (res.status === 502) {\n      const b = await res.json() as { error: { code: string } };\n      expect(b.error.code).toBe(\"UPSTREAM_ERROR\");\n    }\n  });\n\n  it(\"sanitizes filenames with special chars\", async () => {\n    const res = await post({\n      organizationId: orgId,\n      name: \"../../../etc/passwd\",\n      mimeType: \"image/png\",\n      size: 100,\n    });\n    // key must not contain the traversal; attachment.key should be path-safe\n    if (res.status === 201) {\n      const b = await res.json() as { data: { attachment: { key: string } } };\n      expect(b.data.attachment.key).not.toContain(\"..\");\n    }\n  });\n});\n```\n\n---\n\n**3. `src/routes/conversations.ts` — self-message and race-recovery paths**\n\n```ts\n// apps/api/tests/conversations.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\n\nconst run = Math.random().toString(36).slice(2, 8);\nconst mkUser = (name: string) => ({ id: `t_${run}_${name}`, email: `${name}_${run}@test.local`, name });\nconst alice = mkUser(\"alice\");\nconst bob = mkUser(\"bob\");\nconst orgId = `t_${run}_org`;\n\n// Assumes a helper that signs in and returns a cookie; adapt to your auth setup\nasync function signIn(userId: string): Promise<string> {\n  // POST /api/auth/sign-in or use a seeded session — implement per your test infrastructure\n  return `session_cookie_for_${userId}`;\n}\n\nlet aliceCookie = \"\";\nlet bobCookie = \"\";\n\nbeforeAll(async () => {\n  await db.user.createMany({ data: [alice, bob] });\n  await db.organization.create({ data: { id: orgId, name: \"Org\", slug: `org-${run}`, createdAt: new Date() } });\n  await db.member.createMany({\n    data: [\n      { id: `m1_${run}`, organizationId: orgId, userId: alice.id, role: \"owner\", createdAt: new Date() },\n      { id: `m2_${run}`, organizationId: orgId, userId: bob.id, role: \"member\", createdAt: new Date() },\n    ],\n  });\n  aliceCookie = await signIn(alice.id);\n  bobCookie = await signIn(bob.id);\n});\nafterAll(() => db.organization.deleteMany({ where: { id: orgId } }).then(() =>\n  db.user.deleteMany({ where: { id: { in: [alice.id, bob.id] } } }),\n));\n\nconst post = (body: unknown, cookie: string) =>\n  app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\", cookie },\n    body: JSON.stringify(body),\n  }));\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"returns 400 when messaging yourself\", async () => {\n    const res = await post({ organizationId: orgId, userId: alice.id }, aliceCookie);\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"creates a direct conversation on first call\", async () => {\n    const res = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    expect(res.status).toBe(201);\n    const b = await res.json() as { data: { id: string } };\n    expect(typeof b.data.id).toBe(\"string\");\n  });\n\n  it(\"returns existing conversation on second call (idempotent)\", async () => {\n    const r1 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    const r2 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    expect(r2.status).toBe(200); // existing: no 201\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"conversation is the same regardless of which side initiates\", async () => {\n    const r1 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    const r2 = await post({ organizationId: orgId, userId: alice.id }, bobCookie);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"requires auth\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ organizationId: orgId, userId: bob.id }),\n    }));\n    expect(res.status).toBe(401);\n  });\n});\n```\n\n---\n\n**4. `src/routes/rtc.ts` — TURN credential shape and HMAC**\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\nconst get = (cookie = \"\") =>\n  app.handle(new Request(\"http://localhost/api/rtc/ice\", { headers: { cookie } }));\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  it(\"requires auth\", async () => {\n    const res = await get();\n    expect(res.status).toBe(401);\n  });\n\n  it(\"returns at least one STUN server\", async () => {\n    // Assumes a signed-in session cookie — skip or adapt per test infrastructure\n    // const res = await get(validCookie);\n    // const { data: { iceServers } } = await res.json();\n    // expect(iceServers[0].urls.length).toBeGreaterThan(0);\n    // expect(iceServers[0].urls[0]).toMatch(/^stun:/);\n  });\n\n  it(\"TURN credentials have correct HMAC when TURN_SECRET is set\", () => {\n    // Unit-test the credential logic in isolation\n    const secret = \"test-turn-secret\";\n    const userId = \"user123\";\n    const ttl = 6 * 60 * 60;\n    const username = `${Math.floor(Date.now() / 1000) + ttl}:${userId}`;\n    const credential = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    // credential must be a non-empty base64 string\n    expect(credential).toMatch(/^[A-Za-z0-9+/]+=*$/);\n    // username encodes expiry:userId\n    const [expiry, uid] = username.split(\":\");\n    expect(uid).toBe(userId);\n    expect(Number(expiry)).toBeGreaterThan(Math.floor(Date.now() / 1000));\n  });\n\n  it(\"response has cache-control: private, no-store\", async () => {\n    // const res = await get(validCookie);\n    // expect(res.headers.get(\"cache-control\")).toBe(\"private, no-store\");\n  });\n});\n```\n\n---\n\n**5. `src/server/jobs/reminders.ts` — claim-first race and lead-time window**\n\n```ts\n// apps/api/tests/reminders.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { db } from \"@/lib/db\";\n\n/**\n * Tests the reminder worker tick logic WITHOUT starting the interval —\n * call tick() directly (export it from reminders.ts as a named export first).\n *\n * ACTION REQUIRED: export `tick` from reminders.ts:\n *   export async function tick() { ... }\n */\n// import { tick } from \"@/server/jobs/reminders\";\n\nconst run = Math.random().toString(36).slice(2, 8);\nconst orgId = `t_${run}_reminderOrg`;\nconst userId = `t_${run}_reminderUser`;\n\nbeforeAll(async () => {\n  await db.user.create({ data: { id: userId, email: `rem_${run}@test.local`, name: \"Rem\" } });\n  await db.organization.create({ data: { id: orgId, name: \"RemOrg\", slug: `rem-${run}`, createdAt: new Date() } });\n  await db.member.create({ data: { id: `rm_${run}`, organizationId: orgId, userId, role: \"owner\", createdAt: new Date() } });\n});\nafterAll(() =>\n  db.organization.deleteMany({ where: { id: orgId } }).then(() =>\n    db.user.deleteMany({ where: { id: userId } }),\n  ),\n);\n\ndescribe(\"reminder worker tick()\", () => {\n  it(\"creates EVENT_REMINDER notification for event starting within 10 min\", async () => {\n    const startAt = new Date(Date.now() + 5 * 60_000); // 5 min from now\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"Standup\",\n        type: \"MEETING\",\n        startAt,\n        endAt: new Date(startAt.getTime() + 30 * 60_000),\n        creatorId: userId,\n      },\n    });\n    // await tick();\n    const notif = await db.notification.findFirst({\n      where: { eventId: event.id, type: \"EVENT_REMINDER\" },\n    });\n    expect(notif).not.toBeNull();\n    const updated = await db.event.findUnique({ where: { id: event.id } });\n    expect(updated?.remindedAt).not.toBeNull();\n  });\n\n  it(\"does not double-remind: second tick skips already-reminded events\", async () => {\n    const startAt = new Date(Date.now() + 3 * 60_000);\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"Double\",\n        type: \"MEETING\",\n        startAt,\n        endAt: new Date(startAt.getTime() + 60_000),\n        creatorId: userId,\n        remindedAt: new Date(), // already claimed\n      },\n    });\n    // await tick();\n    const count = await db.notification.count({ where: { eventId: event.id, type: \"EVENT_REMINDER\" } });\n    expect(count).toBe(0);\n  });\n\n  it(\"does not remind for events starting > 10 min from now\", async () => {\n    const startAt = new Date(Date.now() + 20 * 60_000); // 20 min — outside window\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"Far Future\",\n        type: \"MEETING\",\n        startAt,\n        endAt: new Date(startAt.getTime() + 60_000),\n        creatorId: userId,\n      },\n    });\n    // await tick();\n    const notif = await db.notification.findFirst({ where: { eventId: event.id } });\n    expect(notif).toBeNull();\n  });\n\n  it(\"does not send reminders for OUT_OF_OFFICE events\", async () => {\n    const startAt = new Date(Date.now() + 5 * 60_000);\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"OOO\",\n        type: \"OUT_OF_OFFICE\",\n        startAt,\n        endAt: new Date(startAt.getTime() + 60_000),\n        creatorId: userId,\n      },\n    });\n    // await tick();\n    const notif = await db.notification.findFirst({ where: { eventId: event.id } });\n    expect(notif).toBeNull();\n  });\n\n  it(\"excludes DECLINED attendees from notifications\", async () => {\n    const startAt = new Date(Date.now() + 5 * 60_000);\n    const declinedUser = `t_${run}_declined`;\n    await db.user.create({ data: { id: declinedUser, email: `dec_${run}@test.local`, name: \"Dec\" } });\n    await db.member.create({ data: { id: `dm_${run}`, organizationId: orgId, userId: declinedUser, role: \"member\", createdAt: new Date() } });\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"Declined\",\n        type: \"MEETING\",\n        startAt,\n        endAt: new Date(startAt.getTime() + 60_000),\n        creatorId: userId,\n        attendees: {\n          create: [{ userId: declinedUser, rsvp: \"DECLINED\" }],\n        },\n      },\n    });\n    // await tick();\n    const notif = await db.notification.findFirst({ where: { eventId: event.id, userId: declinedUser } });\n    expect(notif).toBeNull();\n  });\n});\n```\n\n---\n\n",
