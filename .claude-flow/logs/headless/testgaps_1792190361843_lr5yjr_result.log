        "language": "ts",
        "code": "// apps/api/tests/conversations.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\n\nconst run = Math.random().toString(36).slice(2, 8);\nconst mkUser = (name: string) => ({ id: `t_${run}_${name}`, email: `${name}_${run}@test.local`, name });\nconst alice = mkUser(\"alice\");\nconst bob = mkUser(\"bob\");\nconst orgId = `t_${run}_org`;\n\n// Assumes a helper that signs in and returns a cookie; adapt to your auth setup\nasync function signIn(userId: string): Promise<string> {\n  // POST /api/auth/sign-in or use a seeded session — implement per your test infrastructure\n  return `session_cookie_for_${userId}`;\n}\n\nlet aliceCookie = \"\";\nlet bobCookie = \"\";\n\nbeforeAll(async () => {\n  await db.user.createMany({ data: [alice, bob] });\n  await db.organization.create({ data: { id: orgId, name: \"Org\", slug: `org-${run}`, createdAt: new Date() } });\n  await db.member.createMany({\n    data: [\n      { id: `m1_${run}`, organizationId: orgId, userId: alice.id, role: \"owner\", createdAt: new Date() },\n      { id: `m2_${run}`, organizationId: orgId, userId: bob.id, role: \"member\", createdAt: new Date() },\n    ],\n  });\n  aliceCookie = await signIn(alice.id);\n  bobCookie = await signIn(bob.id);\n});\nafterAll(() => db.organization.deleteMany({ where: { id: orgId } }).then(() =>\n  db.user.deleteMany({ where: { id: { in: [alice.id, bob.id] } } }),\n));\n\nconst post = (body: unknown, cookie: string) =>\n  app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n    method: \"POST\",\n    headers: { \"content-type\": \"application/json\", cookie },\n    body: JSON.stringify(body),\n  }));\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"returns 400 when messaging yourself\", async () => {\n    const res = await post({ organizationId: orgId, userId: alice.id }, aliceCookie);\n    expect(res.status).toBe(400);\n    const b = await res.json() as { error: { code: string } };\n    expect(b.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"creates a direct conversation on first call\", async () => {\n    const res = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    expect(res.status).toBe(201);\n    const b = await res.json() as { data: { id: string } };\n    expect(typeof b.data.id).toBe(\"string\");\n  });\n\n  it(\"returns existing conversation on second call (idempotent)\", async () => {\n    const r1 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    const r2 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    expect(r2.status).toBe(200); // existing: no 201\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"conversation is the same regardless of which side initiates\", async () => {\n    const r1 = await post({ organizationId: orgId, userId: bob.id }, aliceCookie);\n    const r2 = await post({ organizationId: orgId, userId: alice.id }, bobCookie);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"requires auth\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ organizationId: orgId, userId: bob.id }),\n    }));\n    expect(res.status).toBe(401);\n  });\n});"
      },
