      {
        "title": "1. `src/lib/errors.ts` — `toErrorResponse()` and `HttpError` constructors",
        "content": "\n**What's missing:** `toErrorResponse` is the global error envelope for every route, but it has zero tests. The PostgreSQL error-code branches (`23505`, `23503`) are untested. `tooManyRequests` incorrectly uses code `INVALID_STATE` instead of expected `TOO_MANY_REQUESTS` — a bug that would be caught by a test.\n\n```ts\n// apps/api/tests/errors.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  badRequest, notFound, forbidden, conflict,\n  unauthorized, tooManyRequests, upstreamError, invalidState,\n  toErrorResponse,\n} from \"@/lib/errors\";\n\ndescribe(\"HttpError constructors\", () => {\n  it(\"badRequest → 400 INVALID_INPUT\", () => {\n    const e = badRequest(\"bad\", { field: \"x\" });\n    expect(e.status).toBe(400);\n    expect(e.code).toBe(\"INVALID_INPUT\");\n    expect(e.details).toEqual({ field: \"x\" });\n  });\n\n  it(\"notFound → 404 NOT_FOUND with default message\", () => {\n    expect(notFound().status).toBe(404);\n    expect(notFound(\"custom\").message).toBe(\"custom\");\n  });\n\n  it(\"forbidden → 403 FORBIDDEN\", () => {\n    expect(forbidden(\"no\").status).toBe(403);\n  });\n\n  it(\"conflict → 409 CONFLICT\", () => {\n    expect(conflict(\"dup\").status).toBe(409);\n    expect(conflict(\"dup\").code).toBe(\"CONFLICT\");\n  });\n\n  it(\"invalidState → 409 INVALID_STATE\", () => {\n    expect(invalidState(\"locked\").code).toBe(\"INVALID_STATE\");\n  });\n\n  it(\"unauthorized → 401 UNAUTHORIZED\", () => {\n    expect(unauthorized().status).toBe(401);\n  });\n\n  it(\"tooManyRequests → 429\", () => {\n    expect(tooManyRequests().status).toBe(429);\n  });\n\n  it(\"upstreamError → 502 UPSTREAM_ERROR\", () => {\n    expect(upstreamError(\"s3 down\").status).toBe(502);\n    expect(upstreamError(\"s3 down\").code).toBe(\"UPSTREAM_ERROR\");\n  });\n});\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"passes through HttpError fields verbatim\", () => {\n    const { status, body } = toErrorResponse(badRequest(\"oops\", { x: 1 }));\n    expect(status).toBe(400);\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n    expect(body.error.details).toEqual({ x: 1 });\n  });\n\n  it(\"ORMError REJECTED_BY_POLICY → 403 FORBIDDEN (does not leak reason)\", () => {\n    const e = new ORMError(ORMErrorReason.REJECTED_BY_POLICY, \"denied\");\n    const { status, body } = toErrorResponse(e);\n    expect(status).toBe(403);\n    expect(body.error.code).toBe(\"FORBIDDEN\");\n    expect(body.error.message).not.toContain(\"denied\"); // must not leak ORM internals\n  });\n\n  it(\"ORMError NOT_FOUND → 404\", () => {\n    const e = new ORMError(ORMErrorReason.NOT_FOUND, \"missing\");\n    expect(toErrorResponse(e).status).toBe(404);\n  });\n\n  it(\"ORMError DB_QUERY_ERROR with PG unique violation → 409 CONFLICT\", () => {\n    const e = new ORMError(ORMErrorReason.DB_QUERY_ERROR, \"dup\");\n    (e as any).dbErrorCode = \"23505\";\n    const { status, body } = toErrorResponse(e);\n    expect(status).toBe(409);\n    expect(body.error.code).toBe(\"CONFLICT\");\n  });\n\n  it(\"ORMError DB_QUERY_ERROR with PG FK violation → 409 CONFLICT\", () => {\n    const e = new ORMError(ORMErrorReason.DB_QUERY_ERROR, \"fk\");\n    (e as any).dbErrorCode = \"23503\";\n    expect(toErrorResponse(e).status).toBe(409);\n  });\n\n  it(\"unknown errors → 500 INTERNAL without leaking message\", () => {\n    const { status, body } = toErrorResponse(new Error(\"raw SQL stacktrace\"));\n    expect(status).toBe(500);\n    expect(body.error.code).toBe(\"INTERNAL\");\n    expect(body.error.message).toBe(\"Internal server error\");\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "2. `src/server/rate-limit.ts` — token bucket logic",
        "content": "\n**What's missing:** The bucket algorithm (token refill, exhaustion, cleanup at 50k buckets) has no tests. Token math is subtle — a bug here silently breaks upload and typing rate limits.\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows up to capacity calls immediately\", () => {\n    const key = `test:${Math.random()}`;\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(false); // 4th is rejected\n  });\n\n  it(\"different keys are independent\", () => {\n    const a = `a:${Math.random()}`;\n    const b = `b:${Math.random()}`;\n    expect(rateLimit(a, 1, 60_000)).toBe(true);\n    expect(rateLimit(b, 1, 60_000)).toBe(true);\n    expect(rateLimit(a, 1, 60_000)).toBe(false);\n    expect(rateLimit(b, 1, 60_000)).toBe(false);\n  });\n\n  it(\"refills tokens proportionally over time\", async () => {\n    const key = `refill:${Math.random()}`;\n    // exhaust the bucket (capacity=1)\n    expect(rateLimit(key, 1, 100)).toBe(true);\n    expect(rateLimit(key, 1, 100)).toBe(false);\n    // wait for one full period (100ms) → should refill to capacity\n    await new Promise((r) => setTimeout(r, 110));\n    expect(rateLimit(key, 1, 100)).toBe(true);\n  });\n\n  it(\"never exceeds capacity on refill\", async () => {\n    const key = `cap:${Math.random()}`;\n    // Wait 3× the window — tokens must still be capped at capacity=2\n    await new Promise((r) => setTimeout(r, 60));\n    expect(rateLimit(key, 2, 20)).toBe(true);\n    expect(rateLimit(key, 2, 20)).toBe(true);\n    expect(rateLimit(key, 2, 20)).toBe(false);\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "3. `src/lib/mail.ts` — `escapeHtml()`",
        "content": "\n**What's missing:** `escapeHtml` is used in invitation and password-reset emails; an XSS in user-supplied org names or emails in HTML email bodies is a security issue. It's a pure function — easy to unit test.\n\n```ts\n// apps/api/tests/mail.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { escapeHtml } from \"@/lib/mail\";\n\ndescribe(\"escapeHtml\", () => {\n  it(\"escapes all five HTML special characters\", () => {\n    expect(escapeHtml(`<script>alert(\"x'n&y\")</script>`)).toBe(\n      \"&lt;script&gt;alert(&quot;x&#39;n&amp;y&quot;)&lt;/script&gt;\",\n    );\n  });\n\n  it(\"returns plain strings unchanged\", () => {\n    expect(escapeHtml(\"Hello world\")).toBe(\"Hello world\");\n  });\n\n  it(\"handles the empty string\", () => {\n    expect(escapeHtml(\"\")).toBe(\"\");\n  });\n\n  it(\"escapes ampersand in org names (common case)\", () => {\n    expect(escapeHtml(\"R&D\")).toBe(\"R&amp;D\");\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "4. `src/server/notify.ts` — actor exclusion",
        "content": "\n**What's missing:** The core rule \"the actor never receives their own notification\" is enforced only in `notify()`. It's tested indirectly via the realtime plugin, but never as a direct unit test.\n\n```ts\n// apps/api/tests/notify.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport { notify } from \"@/server/notify\";\n\nconst run = Math.random().toString(36).slice(2, 8);\nconst actorId = `notify_actor_${run}`;\nconst recipientId = `notify_recipient_${run}`;\nlet orgId: string;\n\nbeforeAll(async () => {\n  await db.user.createMany({\n    data: [\n      { id: actorId, email: `actor_${run}@test.local`, name: \"Actor\" },\n      { id: recipientId, email: `recipient_${run}@test.local`, name: \"Recipient\" },\n    ],\n  });\n  const org = await db.organization.create({\n    data: { name: \"N\", slug: `notify_${run}`, createdAt: new Date() },\n  });\n  orgId = org.id;\n  await db.member.createMany({\n    data: [\n      { id: `nm1_${run}`, organizationId: orgId, userId: actorId, role: \"owner\", createdAt: new Date() },\n      { id: `nm2_${run}`, organizationId: orgId, userId: recipientId, role: \"member\", createdAt: new Date() },\n    ],\n  });\n});\n\nafterAll(async () => {\n  await db.organization.deleteMany({ where: { id: orgId } });\n  await db.user.deleteMany({ where: { id: { in: [actorId, recipientId] } } });\n});\n\ndescribe(\"notify()\", () => {\n  it(\"creates a notification for the recipient\", async () => {\n    await notify([{ organizationId: orgId, userId: recipientId, actorId, type: \"MENTION\" }]);\n    const count = await db.notification.count({ where: { userId: recipientId, type: \"MENTION\" } });\n    expect(count).toBeGreaterThanOrEqual(1);\n  });\n\n  it(\"skips the notification when actor === recipient (self-notification)\", async () => {\n    const before = await db.notification.count({ where: { userId: actorId } });\n    await notify([{ organizationId: orgId, userId: actorId, actorId, type: \"MENTION\" }]);\n    const after = await db.notification.count({ where: { userId: actorId } });\n    expect(after).toBe(before); // nothing inserted\n  });\n\n  it(\"is a no-op for an empty list\", async () => {\n    await expect(notify([])).resolves.toBeUndefined();\n  });\n\n  it(\"skips items where actorId is null and userId differs\", async () => {\n    // actorId=null means a system notification; it is not excluded\n    const before = await db.notification.count({ where: { userId: recipientId, type: \"POST_COMMENT\" } });\n    await notify([{ organizationId: orgId, userId: recipientId, actorId: null, type: \"POST_COMMENT\" }]);\n    const after = await db.notification.count({ where: { userId: recipientId, type: \"POST_COMMENT\" } });\n    expect(after).toBe(before + 1);\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "5. `src/routes/conversations.ts` — `POST /api/conversations/direct`",
        "content": "\n**What's missing:** Self-message guard, idempotency (same conversation returned on second call), and race-condition fallback path. The route uses the unscoped `db` in the race-fallback — critical that only the right user gets it.\n\n```ts\n// apps/api/tests/conversations.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport { app } from \"../src/app\";\n\nconst run = Math.random().toString(36).slice(2, 8);\n// Helpers: creates real sessions via better-auth and returns Authorization headers.\n// In practice, reuse the pattern from execute.test.ts or stub auth middleware.\n// Below uses the same Request-based app.handle approach as execute.test.ts.\n\nasync function signIn(email: string, password: string): Promise<string> {\n  const res = await app.handle(\n    new Request(\"http://localhost/api/auth/sign-in/email\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ email, password }),\n    }),\n  );\n  const setCookie = res.headers.get(\"set-cookie\") ?? \"\";\n  return setCookie; // pass as Cookie header in subsequent requests\n}\n\nconst post = (path: string, body: unknown, cookie: string) =>\n  app.handle(\n    new Request(`http://localhost${path}`, {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify(body),\n    }),\n  );\n\nlet aliceCookie: string;\nlet bobCookie: string;\nlet orgId: string;\nlet aliceId: string;\nlet bobId: string;\n\nbeforeAll(async () => {\n  // Create users and org directly in DB (bypassing auth flow) then create sessions via sign-in\n  // ... (seed logic similar to policies.test.ts)\n});\n\nafterAll(async () => {\n  await db.organization.deleteMany({ where: { id: orgId } });\n  // cleanup users\n});\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"requires auth → 401\", async () => {\n    const res = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: bobId }, \"\");\n    expect(res.status).toBe(401);\n  });\n\n  it(\"rejects self-messaging → 400 INVALID_INPUT\", async () => {\n    const res = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: aliceId }, aliceCookie);\n    expect(res.status).toBe(400);\n    const body = await res.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"creates a new 1:1 conversation → 201 with id\", async () => {\n    const res = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: bobId }, aliceCookie);\n    expect(res.status).toBe(201);\n    const body = await res.json() as { data: { id: string } };\n    expect(body.data.id).toBeTruthy();\n  });\n\n  it(\"is idempotent — second call returns 200 with the same id\", async () => {\n    const r1 = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: bobId }, aliceCookie);\n    const r2 = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: bobId }, aliceCookie);\n    expect(r2.status).toBe(200);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"directKey is order-independent (alice→bob === bob→alice)\", async () => {\n    const fromAlice = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: bobId }, aliceCookie);\n    const fromBob = await post(\"/api/conversations/direct\",\n      { organizationId: orgId, userId: aliceId }, bobCookie);\n    const id1 = ((await fromAlice.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await fromBob.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "6. `src/routes/uploads.ts` — blocked MIME types and validation",
        "content": "\n**What's missing:** The blocked MIME type list (`text/html`, `image/svg+xml`, JS variants) and the `orgVisible` + non-image rejection are security guards with no coverage.\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\n// NOTE: requires a valid session cookie (use sign-in helper) and storage configured.\n// Tests that don't need storage can be run without S3 by checking the 502 error code.\n\nconst post = (body: unknown, cookie: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie },\n      body: JSON.stringify(body),\n    }),\n  );\n\nconst BASE = {\n  organizationId: \"org123\",\n  name: \"photo.png\",\n  mimeType: \"image/png\",\n  size: 1024,\n};\n\ndescribe(\"POST /api/uploads\", () => {\n  it(\"requires auth → 401\", async () => {\n    const res = await post(BASE, \"\");\n    expect(res.status).toBe(401);\n  });\n\n  // The following tests require a valid session:\n  it.skip(\"rejects text/html → 400 INVALID_INPUT\", async () => {\n    const res = await post({ ...BASE, mimeType: \"text/html\" }, \"<valid-cookie>\");\n    expect(res.status).toBe(400);\n    expect(((await res.json()) as { error: { code: string } }).error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it.skip(\"rejects image/svg+xml → 400 (XSS vector)\", async () => {\n    const res = await post({ ...BASE, mimeType: \"image/svg+xml\" }, \"<valid-cookie>\");\n    expect(res.status).toBe(400);\n  });\n\n  it.skip(\"rejects application/javascript → 400\", async () => {\n    const res = await post({ ...BASE, mimeType: \"application/javascript\" }, \"<valid-cookie>\");\n    expect(res.status).toBe(400);\n  });\n\n  it.skip(\"orgVisible with non-image MIME → 400\", async () => {\n    const res = await post(\n      { ...BASE, mimeType: \"application/pdf\", orgVisible: true }, \"<valid-cookie>\");\n    expect(res.status).toBe(400);\n    expect(((await res.json()) as { error: { code: string } }).error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it.skip(\"orgVisible with image MIME is allowed → proceeds to storage check\", async () => {\n    const res = await post({ ...BASE, orgVisible: true }, \"<valid-cookie>\");\n    // Without storage configured: 502 UPSTREAM_ERROR — but NOT 400\n    expect(res.status).not.toBe(400);\n  });\n});\n\n// Pure logic tests (no DB/session needed):\ndescribe(\"BLOCKED regex\", () => {\n  // Import and test the regex directly if exported, or test via the route response shape\n  const BLOCKED =\n    /^(text\\/html|application\\/(x-)?(javascript|ecmascript)|image\\/svg\\+xml|application\\/xhtml\\+xml)$/i;\n\n  it(\"blocks all dangerous MIME types\", () => {\n    for (const m of [\n      \"text/html\", \"application/javascript\", \"application/x-javascript\",\n      \"application/ecmascript\", \"image/svg+xml\", \"application/xhtml+xml\",\n    ]) {\n      expect(BLOCKED.test(m)).toBe(true);\n    }\n  });\n\n  it(\"allows safe types\", () => {\n    for (const m of [\"image/png\", \"image/jpeg\", \"application/pdf\", \"video/mp4\", \"text/plain\"]) {\n      expect(BLOCKED.test(m)).toBe(false);\n    }\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "7. `src/routes/rtc.ts` — TURN credential structure",
        "content": "\n**What's missing:** The TURN credential is an HMAC-SHA1 over `<timestamp>:<userId>`. The `username` encodes a TTL expiry. If this is wrong, peers behind NAT silently fail to connect — no test will catch a regression.\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, it } from \"bun:test\";\n\nconst TTL_SECONDS = 6 * 60 * 60;\n\n// Mirror the production credential logic to verify the algorithm is correct:\nfunction makeTurnCredential(secret: string, userId: string) {\n  const username = `${Math.floor(Date.now() / 1000) + TTL_SECONDS}:${userId}`;\n  const credential = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n  return { username, credential };\n}\n\ndescribe(\"TURN credential algorithm\", () => {\n  it(\"username encodes expiry as <timestamp>:<userId>\", () => {\n    const userId = \"user_abc\";\n    const { username } = makeTurnCredential(\"secret\", userId);\n    const [ts, id] = username.split(\":\");\n    expect(id).toBe(userId);\n    const expiry = parseInt(ts!, 10);\n    expect(expiry).toBeGreaterThan(Math.floor(Date.now() / 1000));\n    expect(expiry).toBeLessThan(Math.floor(Date.now() / 1000) + TTL_SECONDS + 5);\n  });\n\n  it(\"credential is base64-encoded HMAC-SHA1 of username with the shared secret\", () => {\n    const secret = \"turn-secret\";\n    const { username, credential } = makeTurnCredential(secret, \"u1\");\n    const expected = createHmac(\"sha1\", secret).update(username).digest(\"base64\");\n    expect(credential).toBe(expected);\n  });\n\n  it(\"different users produce different credentials\", () => {\n    const c1 = makeTurnCredential(\"secret\", \"user1\").credential;\n    const c2 = makeTurnCredential(\"secret\", \"user2\").credential;\n    expect(c1).not.toBe(c2);\n  });\n});\n\n// Route integration (requires a valid session):\ndescribe(\"GET /api/rtc/ice\", () => {\n  it.todo(\"requires auth → 401\");\n  it.todo(\"returns at least one STUN server in iceServers\");\n  it.todo(\"with TURN_SECRET set: includes a TURN entry with username and credential\");\n  it.todo(\"cache-control header is private, no-store\");\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "8. `src/server/org.ts` — org lifecycle hooks",
        "content": "\n**What's missing:** `createDefaultGroup()` idempotency, `removeFromOrganization()` cleaning group + conversation + event memberships. These run on every org creation and member removal — a regression would silently leave orphan memberships.\n\n```ts\n// apps/api/tests/org.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport {\n  createDefaultGroup,\n  joinDefaultGroup,\n  removeFromOrganization,\n  DEFAULT_GROUP_SLUG,\n} from \"@/server/org\";\n\nconst run = Math.random().toString(36).slice(2, 8);\nconst uid = (n: string) => `org_test_${run}_${n}`;\nlet orgId: string;\nlet ownerId: string;\nlet memberId: string;\n\nbeforeAll(async () => {\n  ownerId = uid(\"owner\");\n  memberId = uid(\"member\");\n  await db.user.createMany({\n    data: [\n      { id: ownerId, email: `owner_${run}@test.local`, name: \"Owner\" },\n      { id: memberId, email: `member_${run}@test.local`, name: \"Member\" },\n    ],\n  });\n  const org = await db.organization.create({\n    data: { name: \"OrgTest\", slug: uid(\"org\"), createdAt: new Date() },\n  });\n  orgId = org.id;\n  await db.member.createMany({\n    data: [\n      { id: uid(\"m1\"), organizationId: orgId, userId: ownerId, role: \"owner\", createdAt: new Date() },\n      { id: uid(\"m2\"), organizationId: orgId, userId: memberId, role: \"member\", createdAt: new Date() },\n    ],\n  });\n});\n\nafterAll(async () => {\n  await db.organization.deleteMany({ where: { id: orgId } });\n  await db.user.deleteMany({ where: { id: { in: [ownerId, memberId] } } });\n});\n\ndescribe(\"createDefaultGroup()\", () => {\n  it(\"creates an 'All company' group with isDefault=true\", async () => {\n    const group = await createDefaultGroup(orgId, ownerId);\n    expect(group.isDefault).toBe(true);\n    expect(group.slug).toBe(DEFAULT_GROUP_SLUG);\n    expect(group.privacy).toBe(\"PUBLIC\");\n  });\n\n  it(\"is idempotent — calling twice returns the same group\", async () => {\n    const g1 = await createDefaultGroup(orgId, ownerId);\n    const g2 = await createDefaultGroup(orgId, ownerId);\n    expect(g1.id).toBe(g2.id);\n    const count = await db.group.count({ where: { organizationId: orgId, isDefault: true } });\n    expect(count).toBe(1);\n  });\n\n  it(\"adds the owner as an ADMIN group member\", async () => {\n    const group = await db.group.findFirst({ where: { organizationId: orgId, isDefault: true } });\n    const member = await db.groupMember.findUnique({\n      where: { groupId_userId: { groupId: group!.id, userId: ownerId } },\n    });\n    expect(member?.role).toBe(\"ADMIN\");\n  });\n});\n\ndescribe(\"joinDefaultGroup()\", () => {\n  it(\"adds a new member to the default group\", async () => {\n    const group = await db.group.findFirst({ where: { organizationId: orgId, isDefault: true } });\n    await joinDefaultGroup(orgId, memberId);\n    const gm = await db.groupMember.findUnique({\n      where: { groupId_userId: { groupId: group!.id, userId: memberId } },\n    });\n    expect(gm?.status).toBe(\"ACTIVE\");\n  });\n\n  it(\"is idempotent (upsert — does not throw on second call)\", async () => {\n    await expect(joinDefaultGroup(orgId, memberId)).resolves.not.toThrow();\n  });\n\n  it(\"is a no-op when no default group exists\", async () => {\n    const noDefaultOrg = await db.organization.create({\n      data: { name: \"Empty\", slug: uid(\"empty\"), createdAt: new Date() },\n    });\n    await expect(joinDefaultGroup(noDefaultOrg.id, memberId)).resolves.toBeUndefined();\n    await db.organization.delete({ where: { id: noDefaultOrg.id } });\n  });\n});\n\ndescribe(\"removeFromOrganization()\", () => {\n  it(\"removes group, conversation, and event memberships for the user\", async () => {\n    const group = await db.group.findFirst({ where: { organizationId: orgId, isDefault: true } });\n    const convo = await db.conversation.create({\n      data: {\n        organizationId: orgId,\n        type: \"DIRECT\",\n        members: { create: [{ userId: ownerId }, { userId: memberId }] },\n      },\n    });\n    const start = new Date(Date.now() + 86_400_000);\n    const event = await db.event.create({\n      data: {\n        organizationId: orgId,\n        title: \"Meeting\",\n        startAt: start,\n        endAt: new Date(start.getTime() + 3_600_000),\n        attendees: { create: [{ userId: memberId, rsvp: \"GOING\" }] },\n      },\n    });\n\n    await removeFromOrganization(orgId, memberId);\n\n    expect(await db.groupMember.findUnique({\n      where: { groupId_userId: { groupId: group!.id, userId: memberId } },\n    })).toBeNull();\n    expect(await db.conversationMember.findFirst({\n      where: { conversationId: convo.id, userId: memberId },\n    })).toBeNull();\n    expect(await db.eventAttendee.findUnique({\n      where: { eventId_userId: { eventId: event.id, userId: memberId } },\n    })).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 4
      },
      {
        "title": "Integration Test Gaps (High Priority)",
        "content": "\nThese require either a full test session flow or a mock auth layer:\n\n| Gap | Risk | Recommended approach |\n|---|---|---|\n| **WebSocket call lifecycle** — start/join/leave/decline/end, 45s ring timeout, 8-peer cap | High: complex state machine, missed-call notifications | Integration test with `Bun.serve` WebSocket client |\n| **Realtime plugin** — 9 entity mutation handlers (Post, Comment, GroupMember, Message, etc.) | Medium: already partially covered via `policies.test.ts` side effects | Test that socket events are emitted after each write using `hub` spy |\n| **`GET /api/files/:id`** — inline vs `?download=1` disposition, not-found, cache-control header | Medium: `cache-control: private, max-age=240` must be set | Integration test with presign mock |\n| **Reminder worker** — `EVENT_REMINDER` notifications fire ~10 min before event, claim-first dedup | Medium: timing-sensitive | Unit test the query predicate logic; integration test with manual trigger |\n| **`src/websocket/presence.ts`** — `announceOffline` only fires on last connection close | Low-medium: multi-tab edge case | Simulate two connections for same user, close one, verify no offline event |\n\n---\n\n",
        "level": 3
      },
      {
        "title": "Summary",
        "content": "**3 existing test files** cover policy enforcement well but leave all route handlers, utility functions, and WebSocket logic untested. The highest-priority gaps are:\n\n1. **`toErrorResponse()`** — every route depends on it; untested PG error branches\n2. **`escapeHtml()`** — security function in email HTML; XSS regression risk\n3. **`rateLimit()`** — silently broken rate limits affect uploads and typing\n4. **`POST /api/conversations/direct`** — idempotency and race-condition fallback\n5. **Upload MIME blocklist** — security guard with no coverage",
        "level": 3
      }
    ],
    "codeBlocks": [
      {
        "language": "ts",
        "code": "// apps/api/tests/errors.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  badRequest, notFound, forbidden, conflict,\n  unauthorized, tooManyRequests, upstreamError, invalidState,\n  toErrorResponse,\n} from \"@/lib/errors\";\n\ndescribe(\"HttpError constructors\", () => {\n  it(\"badRequest → 400 INVALID_INPUT\", () => {\n    const e = badRequest(\"bad\", { field: \"x\" });\n    expect(e.status).toBe(400);\n    expect(e.code).toBe(\"INVALID_INPUT\");\n    expect(e.details).toEqual({ field: \"x\" });\n  });\n\n  it(\"notFound → 404 NOT_FOUND with default message\", () => {\n    expect(notFound().status).toBe(404);\n    expect(notFound(\"custom\").message).toBe(\"custom\");\n  });\n\n  it(\"forbidden → 403 FORBIDDEN\", () => {\n    expect(forbidden(\"no\").status).toBe(403);\n  });\n\n  it(\"conflict → 409 CONFLICT\", () => {\n    expect(conflict(\"dup\").status).toBe(409);\n    expect(conflict(\"dup\").code).toBe(\"CONFLICT\");\n  });\n\n  it(\"invalidState → 409 INVALID_STATE\", () => {\n    expect(invalidState(\"locked\").code).toBe(\"INVALID_STATE\");\n  });\n\n  it(\"unauthorized → 401 UNAUTHORIZED\", () => {\n    expect(unauthorized().status).toBe(401);\n  });\n\n  it(\"tooManyRequests → 429\", () => {\n    expect(tooManyRequests().status).toBe(429);\n  });\n\n  it(\"upstreamError → 502 UPSTREAM_ERROR\", () => {\n    expect(upstreamError(\"s3 down\").status).toBe(502);\n    expect(upstreamError(\"s3 down\").code).toBe(\"UPSTREAM_ERROR\");\n  });\n});\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"passes through HttpError fields verbatim\", () => {\n    const { status, body } = toErrorResponse(badRequest(\"oops\", { x: 1 }));\n    expect(status).toBe(400);\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n    expect(body.error.details).toEqual({ x: 1 });\n  });\n\n  it(\"ORMError REJECTED_BY_POLICY → 403 FORBIDDEN (does not leak reason)\", () => {\n    const e = new ORMError(ORMErrorReason.REJECTED_BY_POLICY, \"denied\");\n    const { status, body } = toErrorResponse(e);\n    expect(status).toBe(403);\n    expect(body.error.code).toBe(\"FORBIDDEN\");\n    expect(body.error.message).not.toContain(\"denied\"); // must not leak ORM internals\n  });\n\n  it(\"ORMError NOT_FOUND → 404\", () => {\n    const e = new ORMError(ORMErrorReason.NOT_FOUND, \"missing\");\n    expect(toErrorResponse(e).status).toBe(404);\n  });\n\n  it(\"ORMError DB_QUERY_ERROR with PG unique violation → 409 CONFLICT\", () => {\n    const e = new ORMError(ORMErrorReason.DB_QUERY_ERROR, \"dup\");\n    (e as any).dbErrorCode = \"23505\";\n    const { status, body } = toErrorResponse(e);\n    expect(status).toBe(409);\n    expect(body.error.code).toBe(\"CONFLICT\");\n  });\n\n  it(\"ORMError DB_QUERY_ERROR with PG FK violation → 409 CONFLICT\", () => {\n    const e = new ORMError(ORMErrorReason.DB_QUERY_ERROR, \"fk\");\n    (e as any).dbErrorCode = \"23503\";\n    expect(toErrorResponse(e).status).toBe(409);\n  });\n\n  it(\"unknown errors → 500 INTERNAL without leaking message\", () => {\n    const { status, body } = toErrorResponse(new Error(\"raw SQL stacktrace\"));\n    expect(status).toBe(500);\n    expect(body.error.code).toBe(\"INTERNAL\");\n    expect(body.error.message).toBe(\"Internal server error\");\n  });\n});"
      },
      {
        "language": "ts",
        "code": "// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows up to capacity calls immediately\", () => {\n    const key = `test:${Math.random()}`;\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(true);\n    expect(rateLimit(key, 3, 60_000)).toBe(false); // 4th is rejected\n  });\n\n  it(\"different keys are independent\", () => {\n    const a = `a:${Math.random()}`;\n    const b = `b:${Math.random()}`;\n    expect(rateLimit(a, 1, 60_000)).toBe(true);\n    expect(rateLimit(b, 1, 60_000)).toBe(true);\n    expect(rateLimit(a, 1, 60_000)).toBe(false);\n    expect(rateLimit(b, 1, 60_000)).toBe(false);\n  });\n\n  it(\"refills tokens proportionally over time\", async () => {\n    const key = `refill:${Math.random()}`;\n    // exhaust the bucket (capacity=1)\n    expect(rateLimit(key, 1, 100)).toBe(true);\n    expect(rateLimit(key, 1, 100)).toBe(false);\n    // wait for one full period (100ms) → should refill to capacity\n    await new Promise((r) => setTimeout(r, 110));\n    expect(rateLimit(key, 1, 100)).toBe(true);\n  });\n\n  it(\"never exceeds capacity on refill\", async () => {\n    const key = `cap:${Math.random()}`;\n    // Wait 3× the window — tokens must still be capped at capacity=2\n    await new Promise((r) => setTimeout(r, 60));\n    expect(rateLimit(key, 2, 20)).toBe(true);\n    expect(rateLimit(key, 2, 20)).toBe(true);\n    expect(rateLimit(key, 2, 20)).toBe(false);\n  });\n});"
      },
