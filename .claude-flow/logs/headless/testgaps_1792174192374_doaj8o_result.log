        "title": "1. `src/lib/errors.ts` — Zero unit tests",
        "content": "\n**Untested:** `HttpError` constructor, all factory functions (`badRequest`, `notFound`, `conflict`, `forbidden`, `unauthorized`, `tooManyRequests`, `upstreamError`, `invalidState`), `toErrorResponse()` serialization.\n\n**Missing edge cases:** Errors without `details`, `toErrorResponse` on non-`HttpError` errors, HTTP status codes mapping.\n\n```ts\n// apps/api/tests/errors.test.ts\nimport { describe, it, expect } from \"bun:test\";\nimport {\n  HttpError,\n  badRequest, notFound, conflict, forbidden,\n  unauthorized, tooManyRequests, upstreamError, invalidState,\n  toErrorResponse,\n} from \"@/lib/errors\";\n\ndescribe(\"HttpError\", () => {\n  it(\"stores message, status, code, and optional details\", () => {\n    const e = new HttpError(400, \"INVALID_INPUT\", \"bad\", { field: \"x\" });\n    expect(e.status).toBe(400);\n    expect(e.code).toBe(\"INVALID_INPUT\");\n    expect(e.message).toBe(\"bad\");\n    expect(e.details).toEqual({ field: \"x\" });\n  });\n\n  it(\"details defaults to undefined\", () => {\n    const e = new HttpError(404, \"NOT_FOUND\", \"missing\");\n    expect(e.details).toBeUndefined();\n  });\n});\n\ndescribe(\"factory functions\", () => {\n  it.each([\n    [badRequest(\"x\"), 400, \"INVALID_INPUT\"],\n    [notFound(), 404, \"NOT_FOUND\"],\n    [conflict(\"x\"), 409, \"CONFLICT\"],\n    [forbidden(\"x\"), 403, \"FORBIDDEN\"],\n    [unauthorized(), 401, \"UNAUTHORIZED\"],\n    [tooManyRequests(), 429, \"INVALID_STATE\"],\n    [upstreamError(\"x\"), 502, \"UPSTREAM_ERROR\"],\n    [invalidState(\"x\"), 409, \"INVALID_STATE\"],\n  ] as const)(\"returns correct status and code (%#)\", (err, status, code) => {\n    expect(err.status).toBe(status);\n    expect(err.code).toBe(code);\n  });\n});\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"serializes HttpError with details\", () => {\n    const r = toErrorResponse(badRequest(\"bad field\", { field: \"email\" }));\n    expect(r).toMatchObject({ error: { message: \"bad field\", code: \"INVALID_INPUT\", details: { field: \"email\" } } });\n  });\n\n  it(\"serializes HttpError without details (no 'details' key)\", () => {\n    const r = toErrorResponse(notFound());\n    expect(r.error).not.toHaveProperty(\"details\");\n  });\n\n  it(\"converts generic Error to 500 INTERNAL\", () => {\n    const r = toErrorResponse(new Error(\"boom\"));\n    expect(r.error.code).toBe(\"INTERNAL\");\n  });\n\n  it(\"converts unknown throw value to 500 INTERNAL\", () => {\n    const r = toErrorResponse(\"a string\");\n    expect(r.error.code).toBe(\"INTERNAL\");\n  });\n});\n```\n\n---\n\n",
        "level": 3
