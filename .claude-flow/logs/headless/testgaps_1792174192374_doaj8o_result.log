        "language": "ts",
        "code": "// apps/api/tests/conversations.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeOrg, makeSession } from \"./helpers\";\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  let orgId: string, sessionA: string, userA: string, userB: string, sessionB: string;\n\n  beforeAll(async () => {\n    ({ orgId, sessionA, userA, sessionB, userB } = await makeOrg());\n  });\n\n  it(\"creates a 1:1 conversation between two org members\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userB }),\n    }));\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.id).toBeString();\n  });\n\n  it(\"is idempotent — returns same conversation on second call\", async () => {\n    const make = () => app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userB }),\n    }));\n    const [r1, r2] = await Promise.all([make(), make()]);\n    const [d1, d2] = await Promise.all([r1.json(), r2.json()]);\n    expect(d1.data.id).toBe(d2.data.id);\n  });\n\n  it(\"rejects DM with a user from another org (404 or 400)\", async () => {\n    const { userA: outsider } = await makeOrg(); // separate org\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: outsider }),\n    }));\n    expect([400, 403, 404]).toContain(res.status);\n  });\n\n  it(\"rejects self-DM\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userA }),\n    }));\n    expect([400, 403]).toContain(res.status);\n  });\n});"
      },
