        "language": "ts",
        "code": "// apps/api/tests/mail.test.ts\nimport { describe, it, expect, mock, spyOn } from \"bun:test\";\nimport { escapeHtml, sendMail } from \"@/lib/mail\";\n\ndescribe(\"escapeHtml\", () => {\n  it.each([\n    [\"<script>\", \"&lt;script&gt;\"],\n    [\"a & b\", \"a &amp; b\"],\n    ['\"quoted\"', \"&quot;quoted&quot;\"],\n    [\"'apos'\", \"&#x27;apos&#x27;\"],\n    [\"no special chars\", \"no special chars\"],\n    [\"\", \"\"],\n  ])(\"escapes %s → %s\", (input, expected) => {\n    expect(escapeHtml(input)).toBe(expected);\n  });\n\n  it(\"escapes all entities in a mixed string\", () => {\n    expect(escapeHtml('<a href=\"x&y\">O\\'Reilly</a>')).not.toContain(\"<\");\n  });\n});\n\ndescribe(\"sendMail (console fallback)\", () => {\n  it(\"logs to console when RESEND_API_KEY is not set\", async () => {\n    const logged: unknown[] = [];\n    const spy = spyOn(console, \"log\").mockImplementation((...args) => logged.push(args));\n    await sendMail({ to: \"a@b.com\", subject: \"Hello\", html: \"<p>Hi</p>\" });\n    expect(logged.length).toBeGreaterThan(0);\n    spy.mockRestore();\n  });\n});"
