orized(), 401, \"UNAUTHORIZED\"],\n    [tooManyRequests(), 429, \"INVALID_STATE\"],\n    [upstreamError(\"x\"), 502, \"UPSTREAM_ERROR\"],\n    [invalidState(\"x\"), 409, \"INVALID_STATE\"],\n  ] as const)(\"returns correct status and code (%#)\", (err, status, code) => {\n    expect(err.status).toBe(status);\n    expect(err.code).toBe(code);\n  });\n});\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"serializes HttpError with details\", () => {\n    const r = toErrorResponse(badRequest(\"bad field\", { field: \"email\" }));\n    expect(r).toMatchObject({ error: { message: \"bad field\", code: \"INVALID_INPUT\", details: { field: \"email\" } } });\n  });\n\n  it(\"serializes HttpError without details (no 'details' key)\", () => {\n    const r = toErrorResponse(notFound());\n    expect(r.error).not.toHaveProperty(\"details\");\n  });\n\n  it(\"converts generic Error to 500 INTERNAL\", () => {\n    const r = toErrorResponse(new Error(\"boom\"));\n    expect(r.error.code).toBe(\"INTERNAL\");\n  });\n\n  it(\"converts unknown throw value to 500 INTERNAL\", () => {\n    const r = toErrorResponse(\"a string\");\n    expect(r.error.code).toBe(\"INTERNAL\");\n  });\n});\n```\n\n---\n\n### 2. `src/lib/mail.ts` — Zero unit tests\n\n**Untested:** `escapeHtml()` XSS safety, `sendMail()` fallback to console when RESEND_API_KEY is unset, `sendMail()` with Resend configured.\n\n```ts\n// apps/api/tests/mail.test.ts\nimport { describe, it, expect, mock, spyOn } from \"bun:test\";\nimport { escapeHtml, sendMail } from \"@/lib/mail\";\n\ndescribe(\"escapeHtml\", () => {\n  it.each([\n    [\"<script>\", \"&lt;script&gt;\"],\n    [\"a & b\", \"a &amp; b\"],\n    ['\"quoted\"', \"&quot;quoted&quot;\"],\n    [\"'apos'\", \"&#x27;apos&#x27;\"],\n    [\"no special chars\", \"no special chars\"],\n    [\"\", \"\"],\n  ])(\"escapes %s → %s\", (input, expected) => {\n    expect(escapeHtml(input)).toBe(expected);\n  });\n\n  it(\"escapes all entities in a mixed string\", () => {\n    expect(es