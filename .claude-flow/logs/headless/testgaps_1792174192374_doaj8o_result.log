      {
        "title": "2. `src/lib/mail.ts` — Zero unit tests",
        "content": "\n**Untested:** `escapeHtml()` XSS safety, `sendMail()` fallback to console when RESEND_API_KEY is unset, `sendMail()` with Resend configured.\n\n```ts\n// apps/api/tests/mail.test.ts\nimport { describe, it, expect, mock, spyOn } from \"bun:test\";\nimport { escapeHtml, sendMail } from \"@/lib/mail\";\n\ndescribe(\"escapeHtml\", () => {\n  it.each([\n    [\"<script>\", \"&lt;script&gt;\"],\n    [\"a & b\", \"a &amp; b\"],\n    ['\"quoted\"', \"&quot;quoted&quot;\"],\n    [\"'apos'\", \"&#x27;apos&#x27;\"],\n    [\"no special chars\", \"no special chars\"],\n    [\"\", \"\"],\n  ])(\"escapes %s → %s\", (input, expected) => {\n    expect(escapeHtml(input)).toBe(expected);\n  });\n\n  it(\"escapes all entities in a mixed string\", () => {\n    expect(escapeHtml('<a href=\"x&y\">O\\'Reilly</a>')).not.toContain(\"<\");\n  });\n});\n\ndescribe(\"sendMail (console fallback)\", () => {\n  it(\"logs to console when RESEND_API_KEY is not set\", async () => {\n    const logged: unknown[] = [];\n    const spy = spyOn(console, \"log\").mockImplementation((...args) => logged.push(args));\n    await sendMail({ to: \"a@b.com\", subject: \"Hello\", html: \"<p>Hi</p>\" });\n    expect(logged.length).toBeGreaterThan(0);\n    spy.mockRestore();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "3. `src/server/session.ts` — Zero unit tests",
        "content": "\n**Untested:** `toSessionUser()` field extraction, `dbFor()` scoping.\n\n```ts\n// apps/api/tests/session.test.ts\nimport { describe, it, expect } from \"bun:test\";\nimport { toSessionUser } from \"@/server/session\";\n\ndescribe(\"toSessionUser\", () => {\n  it(\"extracts required fields from a full User\", () => {\n    const user = { id: \"u1\", email: \"a@b.com\", name: \"Alice\", image: null, role: \"user\" } as any;\n    const s = toSessionUser(user);\n    expect(s).toEqual({ id: \"u1\", email: \"a@b.com\", name: \"Alice\", image: null, role: \"user\" });\n  });\n\n  it(\"does not leak extra fields (banned, permissions, etc.)\", () => {\n    const user = { id: \"u1\", email: \"a@b.com\", name: \"A\", image: null, role: \"user\", banned: true, permissions: [] } as any;\n    const s = toSessionUser(user);\n    expect(s).not.toHaveProperty(\"banned\");\n    expect(s).not.toHaveProperty(\"permissions\");\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "4. `src/routes/execute.ts` — Partially tested; missing edge cases",
        "content": "\n**Untested edge cases:** `guardExecute` with `take` exactly at the cap (100), negative `take`, `take` as a float, deeply nested `args`, `findMany` without `take` (should default to cap), rate-limit enforcement (300/min), banned user path.\n\n```ts\n// Append to apps/api/tests/execute.test.ts\n\ndescribe(\"guardExecute — take boundary\", () => {\n  it(\"allows take = MAX_TAKE exactly\", () => {\n    expect(() => guardExecute(\"Post\", \"findMany\", { take: 100 })).not.toThrow();\n  });\n\n  it(\"clamps take above MAX_TAKE to MAX_TAKE\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", { take: 9999 });\n    expect(result.args.take).toBe(100);\n  });\n\n  it(\"preserves negative take (reverse cursor pagination)\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", { take: -5 });\n    expect(result.args.take).toBe(-5);\n  });\n\n  it(\"injects default take when absent on findMany\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", {});\n    expect(result.args.take).toBe(100);\n  });\n\n  it(\"does not inject take for non-findMany operators\", () => {\n    const result = guardExecute(\"Post\", \"findFirst\", {});\n    expect(result.args).not.toHaveProperty(\"take\");\n  });\n});\n\ndescribe(\"POST /api/execute — rate limit\", () => {\n  // Integration: fire 301 requests as same user and assert 429 on the 301st\n  it(\"returns 429 after 300 requests per minute\", async () => {\n    // Requires a real session — use the test helpers from policies.test.ts\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "5. `src/routes/uploads.ts` — Zero tests",
        "content": "\n**Untested:** MIME type blocklist, org-visibility rules for images vs non-images, size limit enforcement, `storageConfigured = false` path (502), rate limit (30/min), attachment creation in DB.\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeSession } from \"./helpers\"; // shared test auth helper\n\n// Blocked MIME types: application/x-executable, text/html, etc.\nconst BLOCKED_MIMES = [\n  \"application/x-msdownload\",\n  \"text/html\",\n  \"application/x-sh\",\n];\nconst ALLOWED_MIMES = [\"image/png\", \"application/pdf\", \"video/mp4\", \"audio/mpeg\"];\n\ndescribe(\"POST /api/uploads — MIME validation\", () => {\n  let session: string;\n\n  beforeAll(async () => {\n    session = await makeSession();\n  });\n\n  it.each(BLOCKED_MIMES)(\"rejects blocked MIME %s with 400\", async (mime) => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it.each(ALLOWED_MIMES)(\"allows MIME %s when storage configured\", async (mime) => {\n    // Only meaningful when S3 env vars are set; skip otherwise\n    if (!process.env.S3_ENDPOINT) return;\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(200);\n  });\n\n  it(\"rejects files larger than 25 MB\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 26 * 1024 * 1024, fileName: \"big.png\" }),\n    }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"returns 502 when storage is not configured\", async () => {\n    // Temporarily unset S3_ENDPOINT; requires env mocking or a separate test process\n  });\n\n  it(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 100, fileName: \"a.png\" }),\n    }));\n    expect(res.status).toBe(401);\n  });\n});\n```\n\n---\n\n",
        "level": 3
