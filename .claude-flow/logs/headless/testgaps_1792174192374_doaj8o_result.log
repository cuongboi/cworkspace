        "language": "ts",
        "code": "// apps/api/tests/org.test.ts\nimport { describe, it, expect, beforeEach } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport { createDefaultGroup, joinDefaultGroup, removeFromOrganization, DEFAULT_GROUP_SLUG } from \"@/server/org\";\nimport { makeOrg } from \"./helpers\";\n\ndescribe(\"createDefaultGroup\", () => {\n  it(\"creates the All company group with isDefault=true\", async () => {\n    const { orgId, ownerId } = await makeOrg();\n    const group = await db.group.findFirst({ where: { organizationId: orgId, isDefault: true } });\n    expect(group).not.toBeNull();\n    expect(group!.slug).toBe(DEFAULT_GROUP_SLUG);\n  });\n\n  it(\"is idempotent — calling twice does not create a duplicate\", async () => {\n    const { orgId, ownerId } = await makeOrg();\n    await createDefaultGroup(orgId, ownerId); // second call\n    const count = await db.group.count({ where: { organizationId: orgId, isDefault: true } });\n    expect(count).toBe(1);\n  });\n});\n\ndescribe(\"joinDefaultGroup\", () => {\n  it(\"adds a new member to the default group with ACTIVE status\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    await joinDefaultGroup(orgId, userBId);\n    const member = await db.groupMember.findFirst({ where: { group: { organizationId: orgId, isDefault: true }, userId: userBId } });\n    expect(member?.status).toBe(\"ACTIVE\");\n  });\n\n  it(\"reactivates a previously removed member\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    // Remove then re-add\n    await removeFromOrganization(orgId, userBId);\n    await joinDefaultGroup(orgId, userBId);\n    const member = await db.groupMember.findFirst({ where: { group: { organizationId: orgId, isDefault: true }, userId: userBId } });\n    expect(member?.status).toBe(\"ACTIVE\");\n  });\n});\n\ndescribe(\"removeFromOrganization\", () => {\n  it(\"removes user from all org groups\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    await removeFromOrganization(orgId, userBId);\n    const memberships = await db.groupMember.findMany({ where: { group: { organizationId: orgId }, userId: userBId } });\n    expect(memberships).toHaveLength(0);\n  });\n\n  it(\"removes user from all org conversations\", async () => {\n    const { orgId, userBId, convoId } = await makeOrg({ withSecondUser: true, withConversation: true });\n    await removeFromOrganization(orgId, userBId);\n    const cm = await db.conversationMember.findFirst({ where: { conversationId: convoId, userId: userBId } });\n    expect(cm).toBeNull();\n  });\n});"
