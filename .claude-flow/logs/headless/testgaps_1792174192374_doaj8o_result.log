      {
        "title": "7. `src/routes/rtc.ts` — Zero tests",
        "content": "\n**Untested:** ICE credential structure, STUN-only path (no TURN secret), credential TTL, authentication requirement.\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeSession } from \"./helpers\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  let session: string;\n\n  beforeAll(async () => { session = await makeSession(); });\n\n  it(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  it(\"returns an array of ICE servers\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: session },\n    }));\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(Array.isArray(data)).toBe(true);\n    expect(data.length).toBeGreaterThan(0);\n  });\n\n  it(\"STUN entries have urls field\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: session },\n    }));\n    const { data } = await res.json();\n    const stun = data.filter((s: any) => s.urls?.includes?.(\"stun:\") ?? false);\n    expect(stun.length).toBeGreaterThan(0);\n  });\n\n  it(\"TURN entries include credential and username when TURN_SECRET is set\", async () => {\n    if (!process.env.TURN_SECRET) return; // skip if not configured\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: session },\n    }));\n    const { data } = await res.json();\n    const turn = data.filter((s: any) => s.urls?.includes?.(\"turn:\") ?? false);\n    expect(turn.length).toBeGreaterThan(0);\n    expect(turn[0]).toHaveProperty(\"username\");\n    expect(turn[0]).toHaveProperty(\"credential\");\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "8. `src/server/org.ts` — Zero tests",
        "content": "\n**Untested:** `createDefaultGroup` idempotency, `joinDefaultGroup` re-activation after removal, `removeFromOrganization` cascades (groups, conversations, events), `DEFAULT_GROUP_SLUG` constant.\n\n```ts\n// apps/api/tests/org.test.ts\nimport { describe, it, expect, beforeEach } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport { createDefaultGroup, joinDefaultGroup, removeFromOrganization, DEFAULT_GROUP_SLUG } from \"@/server/org\";\nimport { makeOrg } from \"./helpers\";\n\ndescribe(\"createDefaultGroup\", () => {\n  it(\"creates the All company group with isDefault=true\", async () => {\n    const { orgId, ownerId } = await makeOrg();\n    const group = await db.group.findFirst({ where: { organizationId: orgId, isDefault: true } });\n    expect(group).not.toBeNull();\n    expect(group!.slug).toBe(DEFAULT_GROUP_SLUG);\n  });\n\n  it(\"is idempotent — calling twice does not create a duplicate\", async () => {\n    const { orgId, ownerId } = await makeOrg();\n    await createDefaultGroup(orgId, ownerId); // second call\n    const count = await db.group.count({ where: { organizationId: orgId, isDefault: true } });\n    expect(count).toBe(1);\n  });\n});\n\ndescribe(\"joinDefaultGroup\", () => {\n  it(\"adds a new member to the default group with ACTIVE status\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    await joinDefaultGroup(orgId, userBId);\n    const member = await db.groupMember.findFirst({ where: { group: { organizationId: orgId, isDefault: true }, userId: userBId } });\n    expect(member?.status).toBe(\"ACTIVE\");\n  });\n\n  it(\"reactivates a previously removed member\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    // Remove then re-add\n    await removeFromOrganization(orgId, userBId);\n    await joinDefaultGroup(orgId, userBId);\n    const member = await db.groupMember.findFirst({ where: { group: { organizationId: orgId, isDefault: true }, userId: userBId } });\n    expect(member?.status).toBe(\"ACTIVE\");\n  });\n});\n\ndescribe(\"removeFromOrganization\", () => {\n  it(\"removes user from all org groups\", async () => {\n    const { orgId, userBId } = await makeOrg({ withSecondUser: true });\n    await removeFromOrganization(orgId, userBId);\n    const memberships = await db.groupMember.findMany({ where: { group: { organizationId: orgId }, userId: userBId } });\n    expect(memberships).toHaveLength(0);\n  });\n\n  it(\"removes user from all org conversations\", async () => {\n    const { orgId, userBId, convoId } = await makeOrg({ withSecondUser: true, withConversation: true });\n    await removeFromOrganization(orgId, userBId);\n    const cm = await db.conversationMember.findFirst({ where: { conversationId: convoId, userId: userBId } });\n    expect(cm).toBeNull();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "9. `src/server/notify.ts` — Zero tests",
        "content": "\n**Untested:** Self-notification filtering, `notify()` with empty array, all notification types, DB write verified, duplicate recipients.\n\n```ts\n// apps/api/tests/notify.test.ts\nimport { describe, it, expect } from \"bun:test\";\nimport { db } from \"@/lib/db\";\nimport { notify } from \"@/server/notify\";\nimport { makeOrg } from \"./helpers\";\n\ndescribe(\"notify()\", () => {\n  it(\"creates notification records in the DB\", async () => {\n    const { orgId, ownerUser, userBId } = await makeOrg({ withSecondUser: true });\n    const before = await db.notification.count();\n    await notify([{ type: \"MENTION\", recipientId: userBId, actorId: ownerUser.id, organizationId: orgId }]);\n    const after = await db.notification.count();\n    expect(after).toBe(before + 1);\n  });\n\n  it(\"filters out self-notifications (actor === recipient)\", async () => {\n    const { orgId, ownerUser } = await makeOrg();\n    const before = await db.notification.count();\n    await notify([{ type: \"MENTION\", recipientId: ownerUser.id, actorId: ownerUser.id, organizationId: orgId }]);\n    const after = await db.notification.count();\n    expect(after).toBe(before); // nothing created\n  });\n\n  it(\"no-ops on empty array without throwing\", async () => {\n    await expect(notify([])).resolves.toBeUndefined();\n  });\n\n  it(\"creates multiple notifications atomically\", async () => {\n    const { orgId, ownerUser, userBId, userCId } = await makeOrg({ withThreeUsers: true });\n    await notify([\n      { type: \"MENTION\", recipientId: userBId, actorId: ownerUser.id, organizationId: orgId },\n      { type: \"MENTION\", recipientId: userCId, actorId: ownerUser.id, organizationId: orgId },\n    ]);\n    const count = await db.notification.count({ where: { organizationId: orgId } });\n    expect(count).toBe(2);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "10. `src/websocket/hub.ts` — Zero tests",
        "content": "\n**Untested:** `Conn` lifecycle (`on`, `onClose`, `dispose`), room membership, `emitToUsers`, `emitToRoom`, `emitTo` with exclusions, `connectionCount`, `onlineUserIds`.\n\n```ts\n// apps/api/tests/hub.test.ts\nimport { describe, it, expect, mock } from \"bun:test\";\nimport { Conn, register, unregister, emitToUsers, emitToRoom, connectionCount, onlineUserIds } from \"@/websocket/hub\";\n\nfunction makeRawSocket(id = \"ws-1\") {\n  return {\n    id,\n    send: mock(() => {}),\n    close: mock(() => {}),\n    readyState: 1,\n  } as any;\n}\n\nfunction makeConn(userId = \"user-1\", socketId = \"ws-1\") {\n  const raw = makeRawSocket(socketId);\n  const conn = new Conn(raw, { id: userId, email: \"a@b.com\", name: \"A\", image: null, role: \"user\" });\n  register(conn);\n  return { conn, raw };\n}\n\ndescribe(\"Conn — registration\", () => {\n  it(\"registers and reports connectionCount\", () => {\n    const { conn } = makeConn(\"u-reg-1\", \"ws-reg-1\");\n    expect(connectionCount(\"u-reg-1\")).toBe(1);\n    unregister(conn);\n  });\n\n  it(\"unregister removes connection\", () => {\n    const { conn } = makeConn(\"u-unreg\", \"ws-unreg\");\n    unregister(conn);\n    expect(connectionCount(\"u-unreg\")).toBe(0);\n  });\n});\n\ndescribe(\"Conn — room membership\", () => {\n  it(\"join() and leave() track rooms on the Conn\", () => {\n    const { conn } = makeConn(\"u-room\", \"ws-room\");\n    conn.join(\"group:1\");\n    expect(conn.rooms.has(\"group:1\")).toBe(true);\n    conn.leave(\"group:1\");\n    expect(conn.rooms.has(\"group:1\")).toBe(false);\n    unregister(conn);\n  });\n});\n\ndescribe(\"emitToUsers\", () => {\n  it(\"sends to all connections of a user\", () => {\n    const { conn: c1, raw: r1 } = makeConn(\"u-emit\", \"ws-emit-1\");\n    const { conn: c2, raw: r2 } = makeConn(\"u-emit\", \"ws-emit-2\");\n    emitToUsers([\"u-emit\"], \"post:new\", { id: \"p1\" } as any);\n    expect(r1.send).toHaveBeenCalled();\n    expect(r2.send).toHaveBeenCalled();\n    unregister(c1);\n    unregister(c2);\n  });\n\n  it(\"does not send to a different user\", () => {\n    const { conn, raw } = makeConn(\"u-other\", \"ws-other\");\n    emitToUsers([\"u-target\"], \"post:new\", { id: \"p1\" } as any);\n    expect(raw.send).not.toHaveBeenCalled();\n    unregister(conn);\n  });\n});\n\ndescribe(\"emitToRoom with exclusion\", () => {\n  it(\"excludes the sender's connection\", () => {\n    const { conn: sender, raw: rawSender } = makeConn(\"u-sender\", \"ws-sender\");\n    const { conn: receiver, raw: rawReceiver } = makeConn(\"u-recv\", \"ws-recv\");\n    sender.join(\"group:42\");\n    receiver.join(\"group:42\");\n    emitToRoom(\"group:42\", \"post:new\", { id: \"p1\" } as any, sender.id);\n    expect(rawSender.send).not.toHaveBeenCalled();\n    expect(rawReceiver.send).toHaveBeenCalled();\n    unregister(sender);\n    unregister(receiver);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "11. `src/websocket/presence.ts` — Zero tests",
        "content": "\n**Untested:** Online announcement on connect, offline announcement on last disconnect (not on first of two), typing debounce/relay.\n\n```ts\n// apps/api/tests/presence.test.ts\nimport { describe, it, expect, mock } from \"bun:test\";\n// Integration-level: test via WebSocket upgrade against the real app\n// apps/api/tests/presence.test.ts uses a WebSocket test client\n\nimport { app } from \"@/app\";\n\n// Pseudo-sketch — real implementation uses a WS test client library or Bun's native WS test API\ndescribe(\"presence — online/offline lifecycle\", () => {\n  it(\"emits presence:online when user connects\", async () => {\n    // 1. Connect user A → subscribe with user B's ws to org room\n    // 2. User A connects → assert user B receives presence:online for user A\n  });\n\n  it(\"emits presence:offline only when the last connection closes\", async () => {\n    // 1. User A opens two connections\n    // 2. Close first → user B should NOT receive presence:offline\n    // 3. Close second → user B SHOULD receive presence:offline\n  });\n\n  it(\"relays typing indicators only to conversation members\", async () => {\n    // 1. User A sends typing event for conversationId X\n    // 2. User B (member of X) receives it\n    // 3. User C (non-member) does not receive it\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "12. Missing Integration Tests: app.ts error handling",
        "content": "\n**Untested:** Global error envelope for 404 routes, CORS headers, health check endpoint, ZenStack `PrismaClientKnownRequestError` conversion.\n\n```ts\n// apps/api/tests/app.test.ts\nimport { describe, it, expect } from \"bun:test\";\nimport { app } from \"@/app\";\n\ndescribe(\"GET /health\", () => {\n  it(\"returns 200 with ok status\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/health\"));\n    expect(res.status).toBe(200);\n    const body = await res.json();\n    expect(body.status).toBe(\"ok\");\n  });\n});\n\ndescribe(\"Unknown routes\", () => {\n  it(\"API routes return 404 JSON envelope (not HTML)\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/does-not-exist\"));\n    expect(res.status).toBe(404);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"NOT_FOUND\");\n  });\n\n  it(\"Non-API routes serve the SPA index.html (deep link fallback)\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/my-org/feed\"));\n    expect(res.status).toBe(200);\n    const text = await res.text();\n    expect(text).toContain(\"<!DOCTYPE html>\");\n  });\n});\n\ndescribe(\"CORS headers\", () => {\n  it(\"responds to OPTIONS preflight with Access-Control-Allow-Origin\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/execute\", {\n      method: \"OPTIONS\",\n      headers: { origin: \"http://localhost:5173\", \"access-control-request-method\": \"POST\" },\n    }));\n    expect(res.headers.get(\"access-control-allow-origin\")).not.toBeNull();\n  });\n});\n\ndescribe(\"Elysia validation error → 400 INVALID_INPUT envelope\", () => {\n  it(\"returns structured envelope on schema mismatch\", async () => {\n    // POST /api/execute with wrong shape (not the auth guard, but the Elysia t schema)\n    const res = await app.handle(new Request(\"http://localhost/api/execute\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\", cookie: \"no-session\" },\n      body: JSON.stringify({ bad: \"shape\" }),\n    }));\n    // Either 401 (auth first) or 400 (schema first — depends on middleware order)\n    expect([400, 401]).toContain(res.status);\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
      {
        "title": "13. Missing Policy Tests",
        "content": "\n**Untested policies:** Conversation messages (CALL/SYSTEM type write blocked from client), Poll option immutability after creation, Event `endAt < startAt` enforcement, `MemberPermission` model access.\n\n```ts\n// Append to apps/api/tests/policies.test.ts\n\ndescribe(\"Chat — message type restrictions\", () => {\n  it(\"client cannot create a CALL or SYSTEM message\", async () => {\n    const { sessionA, convoId } = await makeConversation();\n    for (const type of [\"CALL\", \"SYSTEM\"]) {\n      await expect(\n        dbFor(sessionA).message.create({ data: { conversationId: convoId, content: \"\", type } })\n      ).rejects.toThrow();\n    }\n  });\n});\n\ndescribe(\"Polls — immutability after creation\", () => {\n  it(\"poll options cannot be added after the poll is created\", async () => {\n    const { sessionA, postId, pollId } = await makePoll();\n    await expect(\n      dbFor(sessionA).pollOption.create({ data: { pollId, text: \"New option\" } })\n    ).rejects.toThrow();\n  });\n});\n\ndescribe(\"Calls — server-only writes\", () => {\n  it(\"client cannot create a Call record\", async () => {\n    const { sessionA, convoId } = await makeConversation();\n    await expect(\n      dbFor(sessionA).call.create({ data: { conversationId: convoId } })\n    ).rejects.toThrow();\n  });\n\n  it(\"client cannot update a Call record\", async () => {\n    const { sessionA, callId } = await makeCall(); // created by server\n    await expect(\n      dbFor(sessionA).call.update({ where: { id: callId }, data: { endedAt: new Date() } })\n    ).rejects.toThrow();\n  });\n});\n```\n\n---\n\n",
        "level": 3
      },
