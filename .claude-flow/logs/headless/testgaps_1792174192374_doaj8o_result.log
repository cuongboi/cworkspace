        "language": "ts",
        "code": "// apps/api/tests/uploads.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeSession } from \"./helpers\"; // shared test auth helper\n\n// Blocked MIME types: application/x-executable, text/html, etc.\nconst BLOCKED_MIMES = [\n  \"application/x-msdownload\",\n  \"text/html\",\n  \"application/x-sh\",\n];\nconst ALLOWED_MIMES = [\"image/png\", \"application/pdf\", \"video/mp4\", \"audio/mpeg\"];\n\ndescribe(\"POST /api/uploads — MIME validation\", () => {\n  let session: string;\n\n  beforeAll(async () => {\n    session = await makeSession();\n  });\n\n  it.each(BLOCKED_MIMES)(\"rejects blocked MIME %s with 400\", async (mime) => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it.each(ALLOWED_MIMES)(\"allows MIME %s when storage configured\", async (mime) => {\n    // Only meaningful when S3 env vars are set; skip otherwise\n    if (!process.env.S3_ENDPOINT) return;\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(200);\n  });\n\n  it(\"rejects files larger than 25 MB\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 26 * 1024 * 1024, fileName: \"big.png\" }),\n    }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"returns 502 when storage is not configured\", async () => {\n    // Temporarily unset S3_ENDPOINT; requires env mocking or a separate test process\n  });\n\n  it(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 100, fileName: \"a.png\" }),\n    }));\n    expect(res.status).toBe(401);\n  });\n});"
