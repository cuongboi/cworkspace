ardExecute(\"Post\", \"findMany\", { take: 100 })).not.toThrow();\n  });\n\n  it(\"clamps take above MAX_TAKE to MAX_TAKE\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", { take: 9999 });\n    expect(result.args.take).toBe(100);\n  });\n\n  it(\"preserves negative take (reverse cursor pagination)\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", { take: -5 });\n    expect(result.args.take).toBe(-5);\n  });\n\n  it(\"injects default take when absent on findMany\", () => {\n    const result = guardExecute(\"Post\", \"findMany\", {});\n    expect(result.args.take).toBe(100);\n  });\n\n  it(\"does not inject take for non-findMany operators\", () => {\n    const result = guardExecute(\"Post\", \"findFirst\", {});\n    expect(result.args).not.toHaveProperty(\"take\");\n  });\n});\n\ndescribe(\"POST /api/execute — rate limit\", () => {\n  // Integration: fire 301 requests as same user and assert 429 on the 301st\n  it(\"returns 429 after 300 requests per minute\", async () => {\n    // Requires a real session — use the test helpers from policies.test.ts\n  });\n});\n```\n\n---\n\n### 5. `src/routes/uploads.ts` — Zero tests\n\n**Untested:** MIME type blocklist, org-visibility rules for images vs non-images, size limit enforcement, `storageConfigured = false` path (502), rate limit (30/min), attachment creation in DB.\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeSession } from \"./helpers\"; // shared test auth helper\n\n// Blocked MIME types: application/x-executable, text/html, etc.\nconst BLOCKED_MIMES = [\n  \"application/x-msdownload\",\n  \"text/html\",\n  \"application/x-sh\",\n];\nconst ALLOWED_MIMES = [\"image/png\", \"application/pdf\", \"video/mp4\", \"audio/mpeg\"];\n\ndescribe(\"POST /api/uploads — MIME validation\", () => {\n  let session: string;\n\n  beforeAll(async () => {\n    session = await makeSession();\n  });\n\n  it.each(BLOCKED_MIMES)(\"rejects blocked MIME %s with 400\", async (mime) => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(400);\n    const body = await res.json();\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it.each(ALLOWED_MIMES)(\"allows MIME %s when storage configured\", async (mime) => {\n    // Only meaningful when S3 env vars are set; skip otherwise\n    if (!process.env.S3_ENDPOINT) return;\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: mime, size: 1024, fileName: \"test.bin\" }),\n    }));\n    expect(res.status).toBe(200);\n  });\n\n  it(\"rejects files larger than 25 MB\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { cookie: session, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 26 * 1024 * 1024, fileName: \"big.png\" }),\n    }));\n    expect(res.status).toBe(400);\n  });\n\n  it(\"returns 502 when storage is not configured\", async () => {\n    // Temporarily unset S3_ENDPOINT; requires env mocking or a separate test process\n  });\n\n  it(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: { \"content-type\": \"application/json\" },\n      body: JSON.stringify({ mimeType: \"image/png\", size: 100, fileName: \"a.png\" }),\n    }));\n    expect(res.status).toBe(401);\n  });\n});\n```\n\n---\n\n### 6. `src/routes/conversations.ts` — Zero tests\n\n**Untested:** `POST /api/conversations/direct` deduplication (idempotent), cross-org rejection, invalid `userId`, self-DM prevention.\n\n```ts\n// apps/api/tests/conversations.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeOrg, makeSession } from \"./helpers\";\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  let orgId: string, sessionA: string, userA: string, userB: string, sessionB: string;\n\n  beforeAll(async () => {\n    ({ orgId, sessionA, userA, sessionB, userB } = await makeOrg());\n  });\n\n  it(\"creates a 1:1 conversation between two org members\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userB }),\n    }));\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.id).toBeString();\n  });\n\n  it(\"is idempotent — returns same conversation on second call\", async () => {\n    const make = () => app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userB }),\n    }));\n    const [r1, r2] = await Promise.all([make(), make()]);\n    const [d1, d2] = await Promise.all([r1.json(), r2.json()]);\n    expect(d1.data.id).toBe(d2.data.id);\n  });\n\n  it(\"rejects DM with a user from another org (404 or 400)\", async () => {\n    const { userA: outsider } = await makeOrg(); // separate org\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: outsider }),\n    }));\n    expect([400, 403, 404]).toContain(res.status);\n  });\n\n  it(\"rejects self-DM\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: { cookie: sessionA, \"content-type\": \"application/json\" },\n      body: JSON.stringify({ userId: userA }),\n    }));\n    expect([400, 403]).toContain(res.status);\n  });\n});\n```\n\n---\n\n### 7. `src/routes/rtc.ts` — Zero tests\n\n**Untested:** ICE credential structure, STUN-only path (no TURN secret), credential TTL, authentication requirement.\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"@/app\";\nimport { makeSession } from \"./helpers\";\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  let session: string;\n\n  beforeAll(async () => { session = await makeSession(); });\n\n  it(\"requires authentication\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\"));\n    expect(res.status).toBe(401);\n  });\n\n  it(\"returns an array of ICE servers\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: session },\n    }));\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(Array.isArray(data)).toBe(true);\n    expect(data.length).toBeGreaterThan(0);\n  });\n\n  it(\"STUN entries have urls field\", async () => {\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: session },\n    }));\n    const { data } = await res.json();\n    const stun = data.filter((s: any) => s.urls?.includes?.(\"stun:\") ?? false);\n    expect(stun.length).toBeGreaterThan(0);\n  });\n\n  it(\"TURN entries include credential and username when TURN_SECRET is set\", async () => {\n    if (!process.env.TURN_SECRET) return; // skip if not configured\n    const res = await app.handle(new Request(\"http://localhost/api/rtc/ice