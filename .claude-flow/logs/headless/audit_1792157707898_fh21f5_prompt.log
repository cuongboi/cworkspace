import { ZenStackClient, type TransactionClientContract } from "@zenstackhq/orm";
import { PostgresDialect } from "@zenstackhq/orm/dialects/postgres";
import { PolicyPlugin } from "@zenstackhq/plugin-policy";
import { zenstackAdapter } from "@zenstackhq/better-auth";
import { Pool } from "pg";
import { env } from "../env";
import { realtimePlugin } from "../server/plugins/realtime-plugin";
import { schema, type SchemaType } from "../../zenstack/schema";

/**
 * Unscoped client: bypasses access policies. Use only for trusted server code
 * (better-auth adapter, workflow routes, socket handlers, jobs, seed). Never hand it to `/execute`.
 * The realtime plugin sits on the root client so every write (including better-auth's) emits.
 */
export const db = new ZenStackClient(schema, {
  log: env.DB_LOG_QUERIES ? ["query", "error"] : ["error"],
  dialect: new PostgresDialect({
    pool: new Pool({ connectionString: env.DATABASE_URL }),
  }),
}).$use(realtimePlugin);

/** Policy-enforcing client. Always narrow it with `.$setAuth(ctx)` per request (see `dbFor`). */
export const authDb = db.$use(new PolicyPlugin());

export const dbAdapter = zenstackAdapter(db, {
  provider: "postgresql",
});

export type Database = typeof db;
/** Client handed to `$transaction` callbacks. */
export type DatabaseTransaction = TransactionClientContract<
  SchemaType,
  Database["$options"],
  {},
  {}
>;
/** Either the root client or a transaction client — for helpers usable in both. */
export type DbExecutor = Database | DatabaseTransaction;
export type AuthDatabase = typeof authDb;

/** Shape bound to `auth()` in schema.zmodel policies (`email` is used by the Invitation rule). */
export type AuthContext = { id: string; email: string; role: string | null };


--- apps/api/src/lib/errors.ts ---
import { ORMError, ORMErrorReason } from "@zenstackhq/orm";

/** Stable machine-readable codes the web app can translate. */
export type ErrorCode =
  | "UNAUTHORIZED"
  | "FORBIDDEN"
  /** 初回ログイン・再発行後: パスワード変更が必要 (§4.6) */
  | "PASSWORD_CHANGE_REQUIRED"
  | "INVALID_INPUT"
  | "NOT_FOUND"
  | "CONFLICT"
  | "INVALID_STATE"
  | "UPSTREAM_ERROR"
  | "INTERNAL";

export class HttpError extends Error {
  constructor(
    readonly status: number,
    readonly code: ErrorCode,
    message: string,
    readonly details?: unknown,
  ) {
    super(message);
    this.name = "HttpError";
  }
}

export const badRequest = (message: string, details?: unknown) =>
  new HttpError(400, "INVALID_INPUT", message, details);
export const notFound = (message = "Not found") => new HttpError(404, "NOT_FOUND", message);
/** The request is valid but the record is not in a state that allows it (e.g. already assessed). */
export const invalidState = (message: string) => new HttpError(409, "INVALID_STATE", message);
export const forbidden = (message: string) => new HttpError(403, "FORBIDDEN", message);
/** Optimistic-lock mismatch or LY 409 (e.g. 査定結果が確定済み). */
export const conflict = (message: string, details?: unknown) =>
  new HttpError(409, "CONFLICT", message, details);
export const unauthorized = (message = "Sign in required") =>
  new HttpError(401, "UNAUTHORIZED", message);
export const tooManyRequests = (message = "Too many requests, slow down") =>
  new HttpError(429, "INVALID_STATE", message);
export const upstreamError = (message: string, details?: unknown) =>
  new HttpError(502, "UPSTREAM_ERROR", message, details);

const PG_UNIQUE_VIOLATION = "23505";
const PG_FK_VIOLATION = "23503";

/** Normalises any thrown value into the `{ error: { message, code } }` envelope + HTTP status. */
export function toErrorResponse(error: unknown): {
  status: number;
  body: { error: { message: string; code: ErrorCode; details?: unknown } };
} {
  if (error instanceof HttpError) {
    return {
      status: error.status,
      body: { error: { message: error.message, code: error.code, details: error.details } },
    };
  }

  if (error instanceof ORMError) {
    switch (error.reason) {
      case ORMErrorReason.INVALID_INPUT:
        return { status: 400, body: { error: { message: error.message, code: "INVALID_INPUT" } } };
      case ORMErrorReason.NOT_FOUND:
        return { status: 404, body: { error: { message: error.message, code: "NOT_FOUND" } } };
      case ORMErrorReason.REJECTED_BY_POLICY:
        return {
          status: 403,
          body: { error: { message: "Operation not permitted", code: "FORBIDDEN" } },
        };
      case ORMErrorReason.DB_QUERY_ERROR:
        if (error.dbErrorCode === PG_UNIQUE_VIOLATION) {
          return { status: 409, body: { error: { message: "Duplicate value", code: "CONFLICT" } } };
        }
        if (error.dbErrorCode === PG_FK_VIOLATION) {
          return {
            status: 409,
            body: { error: { message: "Record is referenced by other data", code: "CONFLICT" } },
          };
        }
        break;
    }
  }

  console.error(error);
  // Never leak internals (SQL, stack) to the client.
  return { status: 500, body: { error: { message: "Internal server error", code: "INTERNAL" } } };
}


--- apps/api/src/lib/mail.ts ---
import { Resend } from "resend";
import { env } from "@/env";

const resend = env.RESEND_API_KEY ? new Resend(env.RESEND_API_KEY) : null;

export type Mail = { to: string; subject: string; html: string; text?: string };

/** Sends through Resend; without `RESEND_API_KEY` (local dev) the mail is printed instead. */
export async function sendMail(mail: Mail) {
  if (!resend) {
    console.info(`[mail] to=${mail.to} subject="${mail.subject}"\n${mail.text ?? mail.html}`);
    return;
  }
  const { error } = await resend.emails.send({ from: env.MAIL_FROM, ...mail });
  if (error) console.error("[mail]", error);
}

export function escapeHtml(value: string) {
  return value.replace(
    /[&<>"']/g,
    (c) => ({ "&": "&amp;", "<": "&lt;", ">": "&gt;", '"': "&quot;", "'": "&#39;" })[c]!,
  );
}


