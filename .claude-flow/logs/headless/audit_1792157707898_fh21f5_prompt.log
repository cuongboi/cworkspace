import { Elysia, t } from "elysia";
import { notFound } from "@/lib/errors";
import { presignDownload } from "@/server/storage";
import { authMacro } from "../plugins/auth";

const INLINE =
  /^(image\/(png|jpe?g|gif|webp|avif)|video\/(mp4|webm)|audio\/\w+|application\/pdf)$/i;

/**
 * GET /api/files/:id[?download=1] → access check through the policy client, then a redirect to
 * a short-lived presigned URL. Use it directly as `<img src>` / `<a href>`.
 */
export const filesRoute = new Elysia({ name: "routes.files" }).use(authMacro).get(
  "/api/files/:id",
  async ({ params, query, userDb, set, redirect }) => {
    const file = await userDb.attachment.findUnique({
      where: { id: params.id },
      select: { key: true, name: true, mimeType: true },
    });
    if (!file) throw notFound("File not found");
    const inline = !query.download && INLINE.test(file.mimeType);
    const url = await presignDownload(file.key, file.name, inline);
    // private + short: the presigned URL expires in 5 minutes
    set.headers["cache-control"] = "private, max-age=240";
    return redirect(url, 302);
  },
  {
    auth: true,
    params: t.Object({ id: t.String({ minLength: 1, maxLength: 64 }) }),
    query: t.Object({ download: t.Optional(t.String()) }),
    detail: { tags: ["Files"], summary: "Redirect to a short-lived download URL" },
  },
);


--- apps/api/src/routes/rtc.ts ---
import { createHmac } from "node:crypto";
import { Elysia } from "elysia";
import { env } from "@/env";
import { authMacro } from "../plugins/auth";

const TTL_SECONDS = 6 * 60 * 60;

const list = (v: string) =>
  v
    .split(",")
    .map((s) => s.trim())
    .filter(Boolean);

/**
 * GET /api/rtc/ice → RTCIceServer[] for WebRTC. STUN always; TURN when configured, with
 * time-limited credentials (coturn `use-auth-secret` / TURN REST API), so no long-lived TURN
 * password ever reaches the browser. Without TURN, peers behind strict NATs can't connect.
 */
export const rtcRoute = new Elysia({ name: "routes.rtc" }).use(authMacro).get(
  "/api/rtc/ice",
  ({ user, set }) => {
    const stun = list(env.STUN_URLS);
    const iceServers: { urls: string[]; username?: string; credential?: string }[] = [
      { urls: stun.length ? stun : ["stun:stun.l.google.com:19302"] },
    ];
    const turn = list(env.TURN_URLS);
    if (turn.length && env.TURN_SECRET) {
      const username = `${Math.floor(Date.now() / 1000) + TTL_SECONDS}:${user.id}`;
      const credential = createHmac("sha1", env.TURN_SECRET).update(username).digest("base64");
      iceServers.push({ urls: turn, username, credential });
    }
    set.headers["cache-control"] = "private, no-store";
    return { data: { iceServers, ttl: TTL_SECONDS } };
  },
  { auth: true, detail: { tags: ["Calls"], summary: "STUN/TURN servers for WebRTC" } },
);


--- apps/api/src/routes/uploads.ts ---
import { createId } from "@paralleldrive/cuid2";
import { Elysia, t } from "elysia";
import { badRequest, tooManyRequests, upstreamError } from "@/lib/errors";
import { rateLimit } from "@/server/rate-limit";
import { MAX_UPLOAD_BYTES, presignUpload, storageConfigured } from "@/server/storage";
import { authMacro } from "../plugins/auth";

// executable/markup types are never stored: they could be served back from our origin
const BLOCKED =
  /^(text\/html|application\/(x-)?(javascript|ecmascript)|image\/svg\+xml|application\/xhtml\+xml)$/i;

/**
 * POST /api/uploads → creates the Attachment row and returns a presigned POST for the browser
 * to upload the bytes straight to the bucket. Attach it afterwards by connecting it, e.g.
 * `db.post.create({ data: { …, attachments: { connect: [{ id }] } } })`.
 */
export const uploadsRoute = new Elysia({ name: "routes.uploads" }).use(authMacro).post(
  "/api/uploads",
  async ({ body, user, userDb, set }) => {
    if (!storageConfigured) throw upstreamError("File storage is not configured");
    if (!rateLimit(`upload:${user.id}`, 30, 60_000)) throw tooManyRequests("Too many uploads");
    if (BLOCKED.test(body.mimeType)) throw badRequest("This file type is not allowed");
    if (body.orgVisible && !body.mimeType.startsWith("image/"))
      throw badRequest("Only images can be shared organization-wide");

    const id = createId();
    const safeName = body.name.replace(/[^\w.\- ]+/g, "_").slice(-120) || "file";
    // the policy client enforces that the uploader belongs to the organization
    const attachment = await userDb.attachment.create({
      data: {
        id,
        ...body,
        key: `org/${body.organizationId}/${id}/${safeName}`,
        uploaderId: user.id,
      },
    });
    const upload = await presignUpload(attachment.key, attachment.mimeType, attachment.size);
    set.status = 201;
    return { data: { attachment, upload } };
  },
  {
    auth: true,
    body: t.Object({
      organizationId: t.String({ minLength: 1 }),
      name: t.String({ minLength: 1, maxLength: 255 }),
      mimeType: t.String({ minLength: 1, maxLength: 127, pattern: "^[\\w.+-]+/[\\w.+-]+$" }),
      size: t.Integer({ minimum: 1, maximum: MAX_UPLOAD_BYTES }),
      width: t.Optional(t.Integer({ minimum: 1 })),
      height: t.Optional(t.Integer({ minimum: 1 })),
      // avatars and group covers; images only
      orgVisible: t.Optional(t.Boolean()),
    }),
    detail: { tags: ["Files"], summary: "Create an attachment and a presigned upload" },
  },
);


--- apps/api/src/server/jobs/reminders.ts ---
import { db } from "@/lib/db";
import { notify } from "@/server/notify";

/**
 * In-process reminder worker: EVENT_REMINDER notifications ~10 minutes before an event starts.
 * Started once at boot (`src/index.ts`). Recurring events are reminded for their first
 * occurrence only. Move to a real job queue when running more than one instance.
 */

const LEAD_MS = 10 * 60_000;
const TICK_MS = 60_000;

let timer: ReturnType<typeof setInterval> | undefined;

async function tick() {
  const now = new Date();
  const due = await db.event.findMany({
    where: {
      remindedAt: null,
      type: { in: ["MEETING", "EVENT"] },
      startAt: { gt: now, lte: new Date(now.getTime() + LEAD_MS) },
    },
    select: {
      id: true,
      organizationId: true,
      title: true,
      startAt: true,
      creatorId: true,
      attendees: {
        where: { rsvp: { not: "DECLINED" } },
        select: { userId: true },
      },
    },
    take: 200,
  });
  for (const event of due) {
    // claim first so a slow tick never double-notifies
    const { count } = await db.event.updateMany({
      where: { id: event.id, remindedAt: null },
      data: { remindedAt: now },
    });
    if (count === 0) continue;
    const userIds = new Set([event.creatorId, ...event.attendees.map((a) => a.userId)]);
    await notify(
      [...userIds].map((userId) => ({
        organizationId: event.organizationId,
        userId,
        type: "EVENT_REMINDER" as const,
        eventId: event.id,
        data: { title: event.title, startAt: event.startAt.toISOString() },
      })),
    );
  }
}

export function startReminderWorker() {
  if (timer) return;
  timer = setInterval(() => {
    tick().catch((err) => console.error("[reminders]", err));
  }, TICK_MS);
  timer.unref?.();
}


--- apps/api/src/server/notify.ts ---
import type { JsonObject } from "@zenstackhq/orm";
import type { NotificationType } from "../../zenstack/models";

type NotificationInput = {
  organizationId: string;
  userId: string;
  actorId?: string | null;
  type: NotificationType;
  groupId?: string | null;
  postId?: string | null;
  commentId?: string | null;
  eventId?: string | null;
  conversationId?: string | null;
  callId?: string | null;
  data?: JsonObject;
};

/**
 * Creates notifications (never for the actor themself). Delivery to the recipient's sockets
 * happens in the realtime plugin's Notification handler, so every path that creates one is live.
 */
export async function notify(items: NotificationInput[]) {
  const rows = items.filter((n) => n.userId !== n.actorId);
  if (rows.length === 0) return;
  // lazy: db.ts installs the realtime plugin, which imports this module
  const { db } = await import("../lib/db");
  for (const row of rows) await db.notification.create({ data: row });
}


--- apps/api/src/server/org.ts ---
import { db } from "@/lib/db";

/** Slug of the org-wide group every member belongs to. */
export const DEFAULT_GROUP_SLUG = "all-company";

/** Creates the org's "All company" group with the creator as admin. Idempotent. */
export async function createDefaultGroup(organizationId: string, ownerId: string) {
  const existing = await db.group.findFirst({
    where: { organizationId, isDefault: true },
  });
  if (existing) return existing;
  return db.group.create({
    data: {
      organizationId,
      name: "All company",
      slug: DEFAULT_GROUP_SLUG,
      description: "Everyone in the organization.",
      privacy: "PUBLIC",
      isDefault: true,
      createdById: ownerId,
      members: { create: { userId: ownerId, role: "ADMIN" } },
    },
  });
}

/** Adds a new org member to the "All company" group. */
export async function joinDefaultGroup(organizationId: string, userId: string) {
  const group = await db.group.findFirst({
    where: { organizationId, isDefault: true },
  });
  if (!group) return;
  await db.groupMember.upsert({
    where: { groupId_userId: { groupId: group.id, userId } },
    create: { groupId: group.id, userId },
    update: { status: "ACTIVE" },
  });
}

/** Removes a former member's group and conversation memberships in that org. */
export async function removeFromOrganization(organizationId: string, userId: string) {
  await db.groupMember.deleteMany({
    where: { userId, group: { organizationId } },
  });
  await db.conversationMember.deleteMany({
    where: { userId, conversation: { organizationId } },
  });
  await db.eventAttendee.deleteMany({
    where: { userId, event: { organizationId } },
  });
}


