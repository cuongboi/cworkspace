        "language": "ts",
        "code": "// apps/api/tests/conversations.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\n\n// helper: assumes test-helper for auth sessions similar to policies.test.ts\nconst run = Math.random().toString(36).slice(2, 8);\nconst id = (n: string) => `t_${run}_${n}`;\n\nconst users = {\n  alice: { id: id(\"alice\"), email: `alice_${run}@test.local`, name: \"Alice\" },\n  bob:   { id: id(\"bob\"),   email: `bob_${run}@test.local`,   name: \"Bob\" },\n  carol: { id: id(\"carol\"), email: `carol_${run}@test.local`, name: \"Carol\" },\n};\nconst orgA = id(\"orgA\");\nconst orgB = id(\"orgB\");\n\n// replace with however your test suite obtains a session cookie/token per user\ndeclare function sessionFor(userId: string): Promise<string>;\n\nconst post = (body: unknown, token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: {\n        \"content-type\": \"application/json\",\n        cookie: `better-auth.session_token=${token}`,\n      },\n      body: JSON.stringify(body),\n    }),\n  );\n\nbeforeAll(async () => {\n  for (const u of Object.values(users)) await db.user.create({ data: u });\n  const now = new Date();\n  await db.organization.createMany({\n    data: [\n      { id: orgA, name: \"A\", slug: id(\"a\"), createdAt: now },\n      { id: orgB, name: \"B\", slug: id(\"b\"), createdAt: now },\n    ],\n  });\n  await db.member.createMany({\n    data: [\n      { id: id(\"m1\"), organizationId: orgA, userId: users.alice.id, role: \"owner\", createdAt: now },\n      { id: id(\"m2\"), organizationId: orgA, userId: users.bob.id,   role: \"member\", createdAt: now },\n      { id: id(\"m3\"), organizationId: orgB, userId: users.carol.id, role: \"owner\", createdAt: now },\n    ],\n  });\n});\n\nafterAll(async () => {\n  await db.organization.deleteMany({ where: { id: { in: [orgA, orgB] } } });\n  await db.user.deleteMany({ where: { id: { in: Object.values(users).map((u) => u.id) } } });\n});\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await post({ organizationId: orgA, userId: users.bob.id }, \"invalid\");\n    expect(r.status).toBe(401);\n  });\n\n  it(\"rejects self-messaging\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.alice.id }, token);\n    expect(r.status).toBe(400);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"creates a new conversation (201) and returns it\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    expect(r.status).toBe(201);\n    const body = await r.json() as { data: { id: string } };\n    expect(typeof body.data.id).toBe(\"string\");\n  });\n\n  it(\"is idempotent: second call returns the same conversation (200)\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r1 = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    const r2 = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    expect(r2.status).toBe(200);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"directKey is symmetric: bob→alice returns the same conversation\", async () => {\n    const tokenA = await sessionFor(users.alice.id);\n    const tokenB = await sessionFor(users.bob.id);\n    const r1 = await post({ organizationId: orgA, userId: users.bob.id }, tokenA);\n    const r2 = await post({ organizationId: orgA, userId: users.alice.id }, tokenB);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"rejects adding a user from another org (policy rejects the member create)\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.carol.id }, token);\n    // policy or not-found; never 2xx\n    expect([400, 403, 404]).toContain(r.status);\n  });\n});"
