        "language": "ts",
        "code": "// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndeclare function sessionToken(userId: string): Promise<string>;\n\nconst get = (token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: `better-auth.session_token=${token}` },\n    }),\n  );\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await get(\"bad\");\n    expect(r.status).toBe(401);\n  });\n\n  it(\"always returns at least one STUN server\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    expect(r.status).toBe(200);\n    const { data } = await r.json() as { data: { iceServers: { urls: string[] }[]; ttl: number } };\n    expect(data.iceServers.length).toBeGreaterThanOrEqual(1);\n    expect(data.iceServers[0]!.urls.some((u) => u.startsWith(\"stun:\"))).toBe(true);\n  });\n\n  it(\"sets cache-control: private, no-store\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    expect(r.headers.get(\"cache-control\")).toContain(\"no-store\");\n  });\n\n  it(\"returns ttl matching 6-hour window\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    const { data } = await r.json() as { data: { ttl: number } };\n    expect(data.ttl).toBe(6 * 60 * 60);\n  });\n\n  // Only runs when TURN_URLS + TURN_SECRET are set in the env\n  it.skipIf(!process.env.TURN_SECRET)(\n    \"TURN credentials use valid HMAC-SHA1 with coturn format\",\n    async () => {\n      const token = await sessionToken(\"user-id\");\n      const r = await get(token);\n      const { data } = await r.json() as {\n        data: { iceServers: { urls: string[]; username?: string; credential?: string }[] };\n      };\n      const turn = data.iceServers.find((s) => s.urls.some((u) => u.startsWith(\"turn:\")));\n      expect(turn).toBeDefined();\n      const [expiry, userId] = (turn!.username ?? \"\").split(\":\");\n      expect(Number(expiry)).toBeGreaterThan(Math.floor(Date.now() / 1000));\n      expect(userId).toBeTruthy();\n      // recompute expected credential\n      const expected = createHmac(\"sha1\", process.env.TURN_SECRET!)\n        .update(turn!.username!)\n        .digest(\"base64\");\n      expect(turn!.credential).toBe(expected);\n    },\n  );\n});"
