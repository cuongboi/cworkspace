        "language": "ts",
        "code": "// apps/api/tests/execute-ratelimit.test.ts\nimport { describe, expect, it, beforeAll } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\nimport { auth } from \"@/lib/auth\";\n\ndescribe(\"POST /api/execute rate limit\", () => {\n  let sessionToken: string;\n  const uid = `t_rl_${Math.random().toString(36).slice(2, 8)}`;\n\n  beforeAll(async () => {\n    await db.user.create({ data: { id: uid, email: `${uid}@test.local`, name: \"RLUser\" } });\n    // obtain a session token via better-auth sign-in or directly\n    // (implementation depends on how execute.test.ts sets up sessions)\n    const session = await auth.api.createSession({ userId: uid } as any);\n    sessionToken = session.token;\n  });\n\n  afterAll(async () => {\n    await db.user.delete({ where: { id: uid } });\n  });\n\n  it(\"returns 429 after 300 rapid requests from the same user\", async () => {\n    // Fire 301 requests; the last must be rejected\n    // NOTE: the existing `rateLimit` is in-process and resets across test files\n    // since bun:test isolates module state you may need to exhaust within one run\n    const fire = () =>\n      app.handle(\n        new Request(\"http://localhost/api/execute\", {\n          method: \"POST\",\n          headers: {\n            \"content-type\": \"application/json\",\n            cookie: `better-auth.session_token=${sessionToken}`,\n          },\n          body: JSON.stringify({ model: \"user\", operator: \"findMany\" }),\n        }),\n      );\n\n    let last!: Response;\n    for (let i = 0; i <= 300; i++) last = await fire();\n    expect(last.status).toBe(429);\n    const body = await last.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_STATE\");\n  });\n});"
