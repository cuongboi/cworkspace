member of CLOSED group cannot react to its posts\", async () => {\n    // bob is pending on closedGroup: cannot read posts, therefore cannot react\n    const closedPost = await as(\"alice\").post.findFirst({\n      where: { groupId: closedGroup },\n    });\n    await rejected(\n      as(\"bob\").postReaction.create({\n        data: { postId: closedPost!.id, type: \"LIKE\" },\n      }),\n    );\n  });\n\n  it(\"user can delete their own reaction\", async () => {\n    const r = await as(\"bob\").postReaction.create({\n      data: { postId: postId, type: \"HAHA\" },\n    });\n    await expect(\n      as(\"bob\").postReaction.delete({ where: { id: r.id } }),\n    ).resolves.toBeDefined();\n  });\n});"
