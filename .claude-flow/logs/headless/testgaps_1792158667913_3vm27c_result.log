        "language": "ts",
        "code": "// apps/api/tests/errors.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  toErrorResponse,\n  badRequest,\n  notFound,\n  forbidden,\n  conflict,\n  tooManyRequests,\n  upstreamError,\n} from \"@/lib/errors\";\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"maps HttpError fields directly\", () => {\n    const r = toErrorResponse(badRequest(\"bad field\", { field: \"x\" }));\n    expect(r.status).toBe(400);\n    expect(r.body.error.code).toBe(\"INVALID_INPUT\");\n    expect(r.body.error.message).toBe(\"bad field\");\n    expect(r.body.error.details).toEqual({ field: \"x\" });\n  });\n\n  it(\"maps every HttpError factory to its status\", () => {\n    expect(toErrorResponse(notFound()).status).toBe(404);\n    expect(toErrorResponse(forbidden(\"no\")).status).toBe(403);\n    expect(toErrorResponse(conflict(\"dup\")).status).toBe(409);\n    expect(toErrorResponse(tooManyRequests()).status).toBe(429);\n    expect(toErrorResponse(upstreamError(\"s3 down\")).status).toBe(502);\n  });\n\n  it(\"maps ORMError REJECTED_BY_POLICY → 403 FORBIDDEN\", () => {\n    const e = new ORMError(\"denied\", ORMErrorReason.REJECTED_BY_POLICY);\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(403);\n    expect(r.body.error.code).toBe(\"FORBIDDEN\");\n    // must NOT leak the internal ORM message\n    expect(r.body.error.message).not.toContain(\"denied\");\n  });\n\n  it(\"maps ORMError NOT_FOUND → 404\", () => {\n    const e = new ORMError(\"row gone\", ORMErrorReason.NOT_FOUND);\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(404);\n    expect(r.body.error.code).toBe(\"NOT_FOUND\");\n  });\n\n  it(\"maps ORMError INVALID_INPUT → 400\", () => {\n    const e = new ORMError(\"bad arg\", ORMErrorReason.INVALID_INPUT);\n    expect(toErrorResponse(e).status).toBe(400);\n    expect(toErrorResponse(e).body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"maps PG unique-violation (23505) → 409 CONFLICT\", () => {\n    const e = new ORMError(\"dup\", ORMErrorReason.DB_QUERY_ERROR);\n    (e as any).dbErrorCode = \"23505\";\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(409);\n    expect(r.body.error.code).toBe(\"CONFLICT\");\n  });\n\n  it(\"maps PG FK-violation (23503) → 409 CONFLICT\", () => {\n    const e = new ORMError(\"ref\", ORMErrorReason.DB_QUERY_ERROR);\n    (e as any).dbErrorCode = \"23503\";\n    expect(toErrorResponse(e).status).toBe(409);\n  });\n\n  it(\"returns 500 INTERNAL for unknown errors and does not leak details\", () => {\n    const r = toErrorResponse(new Error(\"SQL: secret password=hunter2\"));\n    expect(r.status).toBe(500);\n    expect(r.body.error.code).toBe(\"INTERNAL\");\n    expect(r.body.error.message).not.toMatch(/hunter2|SQL/);\n  });\n\n  it(\"returns 500 for non-Error throws (strings, objects)\", () => {\n    expect(toErrorResponse(\"boom\").status).toBe(500);\n    expect(toErrorResponse({ code: 1 }).status).toBe(500);\n  });\n});"
