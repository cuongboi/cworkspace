        "language": "ts",
        "code": "// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows up to `capacity` calls immediately\", () => {\n    const key = `test:${Math.random()}`;\n    for (let i = 0; i < 5; i++) expect(rateLimit(key, 5, 1000)).toBe(true);\n    expect(rateLimit(key, 5, 1000)).toBe(false);\n  });\n\n  it(\"independent keys do not affect each other\", () => {\n    const a = `rl-a-${Math.random()}`;\n    const b = `rl-b-${Math.random()}`;\n    for (let i = 0; i < 3; i++) rateLimit(a, 3, 1000);\n    expect(rateLimit(a, 3, 1000)).toBe(false);\n    expect(rateLimit(b, 3, 1000)).toBe(true); // b untouched\n  });\n\n  it(\"refills tokens over time (token bucket)\", async () => {\n    const key = `rl-refill-${Math.random()}`;\n    // exhaust\n    rateLimit(key, 1, 50);\n    expect(rateLimit(key, 1, 50)).toBe(false);\n    // wait for one full period\n    await new Promise((r) => setTimeout(r, 60));\n    expect(rateLimit(key, 1, 50)).toBe(true);\n  });\n\n  it(\"a fresh key always gets at least one call\", () => {\n    expect(rateLimit(`fresh-${Math.random()}`, 1, 60_000)).toBe(true);\n  });\n\n  it(\"capacity=0 always rejects\", () => {\n    expect(rateLimit(`zero-${Math.random()}`, 0, 1000)).toBe(false);\n  });\n});"
