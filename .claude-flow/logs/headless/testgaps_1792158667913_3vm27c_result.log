  "output": "Now I have everything I need for a comprehensive analysis. Here is the full report:\n\n---\n\n## Test Coverage Analysis\n\n### Tested today (existing coverage)\n\n| Area | File | What's covered |\n|---|---|---|\n| ZenStack policies | `policies.test.ts` | Tenant isolation, group privacy, polls (single-choice), chat membership, notifications (write-deny + realtime plugin), calendar (visibility, RSVP, validation), attachments (org-visible, cross-tenant), calls (read-only from client) |\n| Admin-field protection | `user-admin-fields.test.ts` | `role`, `banned`, `banReason`, `email`, `permissions` are server-only; `title` is editable |\n| `/api/execute` contract | `execute.test.ts` | Auth required, malformed body, `guardExecute` allowlists, `take` capping |\n\n---\n\n## Coverage Gaps\n\n### 1. `toErrorResponse()` — `src/lib/errors.ts`\n\n**Completely untested.** This is the only normalization path for all API errors. The four `ORMErrorReason` branches, the PG error-code branches, and the internal-error scrubbing are all unverified.\n\n```ts\n// apps/api/tests/errors.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { ORMError, ORMErrorReason } from \"@zenstackhq/orm\";\nimport {\n  HttpError,\n  toErrorResponse,\n  badRequest,\n  notFound,\n  forbidden,\n  conflict,\n  tooManyRequests,\n  upstreamError,\n} from \"@/lib/errors\";\n\ndescribe(\"toErrorResponse\", () => {\n  it(\"maps HttpError fields directly\", () => {\n    const r = toErrorResponse(badRequest(\"bad field\", { field: \"x\" }));\n    expect(r.status).toBe(400);\n    expect(r.body.error.code).toBe(\"INVALID_INPUT\");\n    expect(r.body.error.message).toBe(\"bad field\");\n    expect(r.body.error.details).toEqual({ field: \"x\" });\n  });\n\n  it(\"maps every HttpError factory to its status\", () => {\n    expect(toErrorResponse(notFound()).status).toBe(404);\n    expect(toErrorResponse(forbidden(\"no\")).status).toBe(403);\n    expect(toErrorResponse(conflict(\"dup\")).status).toBe(409);\n    expect(toErrorResponse(tooManyRequests()).status).toBe(429);\n    expect(toErrorResponse(upstreamError(\"s3 down\")).status).toBe(502);\n  });\n\n  it(\"maps ORMError REJECTED_BY_POLICY → 403 FORBIDDEN\", () => {\n    const e = new ORMError(\"denied\", ORMErrorReason.REJECTED_BY_POLICY);\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(403);\n    expect(r.body.error.code).toBe(\"FORBIDDEN\");\n    // must NOT leak the internal ORM message\n    expect(r.body.error.message).not.toContain(\"denied\");\n  });\n\n  it(\"maps ORMError NOT_FOUND → 404\", () => {\n    const e = new ORMError(\"row gone\", ORMErrorReason.NOT_FOUND);\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(404);\n    expect(r.body.error.code).toBe(\"NOT_FOUND\");\n  });\n\n  it(\"maps ORMError INVALID_INPUT → 400\", () => {\n    const e = new ORMError(\"bad arg\", ORMErrorReason.INVALID_INPUT);\n    expect(toErrorResponse(e).status).toBe(400);\n    expect(toErrorResponse(e).body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"maps PG unique-violation (23505) → 409 CONFLICT\", () => {\n    const e = new ORMError(\"dup\", ORMErrorReason.DB_QUERY_ERROR);\n    (e as any).dbErrorCode = \"23505\";\n    const r = toErrorResponse(e);\n    expect(r.status).toBe(409);\n    expect(r.body.error.code).toBe(\"CONFLICT\");\n  });\n\n  it(\"maps PG FK-violation (23503) → 409 CONFLICT\", () => {\n    const e = new ORMError(\"ref\", ORMErrorReason.DB_QUERY_ERROR);\n    (e as any).dbErrorCode = \"23503\";\n    expect(toErrorResponse(e).status).toBe(409);\n  });\n\n  it(\"returns 500 INTERNAL for unknown errors and does not leak details\", () => {\n    const r = toErrorResponse(new Error(\"SQL: secret password=hunter2\"));\n    expect(r.status).toBe(500);\n    expect(r.body.error.code).toBe(\"INTERNAL\");\n    expect(r.body.error.message).not.toMatch(/hunter2|SQL/);\n  });\n\n  it(\"returns 500 for non-Error throws (strings, objects)\", () => {\n    expect(toErrorResponse(\"boom\").status).toBe(500);\n    expect(toErrorResponse({ code: 1 }).status).toBe(500);\n  });\n});\n```\n\n---\n\n### 2. `rateLimit()` — `src/server/rate-limit.ts`\n\n**Completely untested.** The token bucket refill math, the sign-preserving clamp, and the 50 k-bucket cleanup are unverified.\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { rateLimit } from \"@/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows up to `capacity` calls immediately\", () => {\n    const key = `test:${Math.random()}`;\n    for (let i = 0; i < 5; i++) expect(rateLimit(key, 5, 1000)).toBe(true);\n    expect(rateLimit(key, 5, 1000)).toBe(false);\n  });\n\n  it(\"independent keys do not affect each other\", () => {\n    const a = `rl-a-${Math.random()}`;\n    const b = `rl-b-${Math.random()}`;\n    for (let i = 0; i < 3; i++) rateLimit(a, 3, 1000);\n    expect(rateLimit(a, 3, 1000)).toBe(false);\n    expect(rateLimit(b, 3, 1000)).toBe(true); // b untouched\n  });\n\n  it(\"refills tokens over time (token bucket)\", async () => {\n    const key = `rl-refill-${Math.random()}`;\n    // exhaust\n    rateLimit(key, 1, 50);\n    expect(rateLimit(key, 1, 50)).toBe(false);\n    // wait for one full period\n    await new Promise((r) => setTimeout(r, 60));\n    expect(rateLimit(key, 1, 50)).toBe(true);\n  });\n\n  it(\"a fresh key always gets at least one call\", () => {\n    expect(rateLimit(`fresh-${Math.random()}`, 1, 60_000)).toBe(true);\n  });\n\n  it(\"capacity=0 always rejects\", () => {\n    expect(rateLimit(`zero-${Math.random()}`, 0, 1000)).toBe(false);\n  });\n});\n```\n\n---\n\n### 3. `/api/execute` rate limiting (HTTP-level)\n\nThe route enforces 300 req/min but that path is never exercised in tests.\n\n```ts\n// apps/api/tests/execute-ratelimit.test.ts\nimport { describe, expect, it, beforeAll } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\nimport { auth } from \"@/lib/auth\";\n\ndescribe(\"POST /api/execute rate limit\", () => {\n  let sessionToken: string;\n  const uid = `t_rl_${Math.random().toString(36).slice(2, 8)}`;\n\n  beforeAll(async () => {\n    await db.user.create({ data: { id: uid, email: `${uid}@test.local`, name: \"RLUser\" } });\n    // obtain a session token via better-auth sign-in or directly\n    // (implementation depends on how execute.test.ts sets up sessions)\n    const session = await auth.api.createSession({ userId: uid } as any);\n    sessionToken = session.token;\n  });\n\n  afterAll(async () => {\n    await db.user.delete({ where: { id: uid } });\n  });\n\n  it(\"returns 429 after 300 rapid requests from the same user\", async () => {\n    // Fire 301 requests; the last must be rejected\n    // NOTE: the existing `rateLimit` is in-process and resets across test files\n    // since bun:test isolates module state you may need to exhaust within one run\n    const fire = () =>\n      app.handle(\n        new Request(\"http://localhost/api/execute\", {\n          method: \"POST\",\n          headers: {\n            \"content-type\": \"application/json\",\n            cookie: `better-auth.session_token=${sessionToken}`,\n          },\n          body: JSON.stringify({ model: \"user\", operator: \"findMany\" }),\n        }),\n      );\n\n    let last!: Response;\n    for (let i = 0; i <= 300; i++) last = await fire();\n    expect(last.status).toBe(429);\n    const body = await last.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_STATE\");\n  });\n});\n```\n\n---\n\n### 4. `POST /api/conversations/direct` — `src/routes/conversations.ts`\n\n**Completely untested.** The idempotency guarantee and self-message guard are critical invariants with zero coverage.\n\n```ts\n// apps/api/tests/conversations.test.ts\nimport { afterAll, beforeAll, describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { db } from \"@/lib/db\";\n\n// helper: assumes test-helper for auth sessions similar to policies.test.ts\nconst run = Math.random().toString(36).slice(2, 8);\nconst id = (n: string) => `t_${run}_${n}`;\n\nconst users = {\n  alice: { id: id(\"alice\"), email: `alice_${run}@test.local`, name: \"Alice\" },\n  bob:   { id: id(\"bob\"),   email: `bob_${run}@test.local`,   name: \"Bob\" },\n  carol: { id: id(\"carol\"), email: `carol_${run}@test.local`, name: \"Carol\" },\n};\nconst orgA = id(\"orgA\");\nconst orgB = id(\"orgB\");\n\n// replace with however your test suite obtains a session cookie/token per user\ndeclare function sessionFor(userId: string): Promise<string>;\n\nconst post = (body: unknown, token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/conversations/direct\", {\n      method: \"POST\",\n      headers: {\n        \"content-type\": \"application/json\",\n        cookie: `better-auth.session_token=${token}`,\n      },\n      body: JSON.stringify(body),\n    }),\n  );\n\nbeforeAll(async () => {\n  for (const u of Object.values(users)) await db.user.create({ data: u });\n  const now = new Date();\n  await db.organization.createMany({\n    data: [\n      { id: orgA, name: \"A\", slug: id(\"a\"), createdAt: now },\n      { id: orgB, name: \"B\", slug: id(\"b\"), createdAt: now },\n    ],\n  });\n  await db.member.createMany({\n    data: [\n      { id: id(\"m1\"), organizationId: orgA, userId: users.alice.id, role: \"owner\", createdAt: now },\n      { id: id(\"m2\"), organizationId: orgA, userId: users.bob.id,   role: \"member\", createdAt: now },\n      { id: id(\"m3\"), organizationId: orgB, userId: users.carol.id, role: \"owner\", createdAt: now },\n    ],\n  });\n});\n\nafterAll(async () => {\n  await db.organization.deleteMany({ where: { id: { in: [orgA, orgB] } } });\n  await db.user.deleteMany({ where: { id: { in: Object.values(users).map((u) => u.id) } } });\n});\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await post({ organizationId: orgA, userId: users.bob.id }, \"invalid\");\n    expect(r.status).toBe(401);\n  });\n\n  it(\"rejects self-messaging\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.alice.id }, token);\n    expect(r.status).toBe(400);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"creates a new conversation (201) and returns it\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    expect(r.status).toBe(201);\n    const body = await r.json() as { data: { id: string } };\n    expect(typeof body.data.id).toBe(\"string\");\n  });\n\n  it(\"is idempotent: second call returns the same conversation (200)\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r1 = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    const r2 = await post({ organizationId: orgA, userId: users.bob.id }, token);\n    expect(r2.status).toBe(200);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"directKey is symmetric: bob→alice returns the same conversation\", async () => {\n    const tokenA = await sessionFor(users.alice.id);\n    const tokenB = await sessionFor(users.bob.id);\n    const r1 = await post({ organizationId: orgA, userId: users.bob.id }, tokenA);\n    const r2 = await post({ organizationId: orgA, userId: users.alice.id }, tokenB);\n    const id1 = ((await r1.json()) as { data: { id: string } }).data.id;\n    const id2 = ((await r2.json()) as { data: { id: string } }).data.id;\n    expect(id1).toBe(id2);\n  });\n\n  it(\"rejects adding a user from another org (policy rejects the member create)\", async () => {\n    const token = await sessionFor(users.alice.id);\n    const r = await post({ organizationId: orgA, userId: users.carol.id }, token);\n    // policy or not-found; never 2xx\n    expect([400, 403, 404]).toContain(r.status);\n  });\n});\n```\n\n---\n\n### 5. `POST /api/uploads` — `src/routes/uploads.ts`\n\n**Completely untested.** The MIME-type blocklist, `orgVisible` image-only guard, and filename sanitization are all unverified.\n\n```ts\n// apps/api/tests/uploads.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\n// shared helper — replace with test auth mechanism\ndeclare function sessionToken(userId: string): Promise<string>;\n\nconst post = (body: unknown, token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: {\n        \"content-type\": \"application/json\",\n        cookie: `better-auth.session_token=${token}`,\n      },\n      body: JSON.stringify(body),\n    }),\n  );\n\ndescribe(\"POST /api/uploads\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await post({ organizationId: \"x\", name: \"f.png\", mimeType: \"image/png\", size: 1 }, \"\");\n    expect(r.status).toBe(401);\n  });\n\n  // Storage is not configured in test env → 502\n  it(\"returns 502 when storage is not configured\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"f.png\", mimeType: \"image/png\", size: 1 },\n      token,\n    );\n    expect(r.status).toBe(502);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"UPSTREAM_ERROR\");\n  });\n\n  it(\"blocks executable MIME types\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    for (const mimeType of [\n      \"text/html\",\n      \"application/javascript\",\n      \"application/x-javascript\",\n      \"image/svg+xml\",\n      \"application/xhtml+xml\",\n    ]) {\n      const r = await post({ organizationId: \"org1\", name: \"evil\", mimeType, size: 1 }, token);\n      expect([400, 502]).toContain(r.status); // 400 if blocked before storage check\n      if (r.status === 400) {\n        const body = await r.json() as { error: { code: string } };\n        expect(body.error.code).toBe(\"INVALID_INPUT\");\n      }\n    }\n  });\n\n  it(\"rejects orgVisible=true for non-image MIME types\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"doc.pdf\", mimeType: \"application/pdf\", size: 1, orgVisible: true },\n      token,\n    );\n    expect(r.status).toBe(400);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"accepts orgVisible=true for image MIME types (would 502 on storage in test env)\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"avatar.png\", mimeType: \"image/png\", size: 1, orgVisible: true },\n      token,\n    );\n    // 502 = passed MIME guard, failed on storage; 400 = MIME guard fired (wrong)\n    expect(r.status).not.toBe(400);\n  });\n});\n```\n\n---\n\n### 6. `GET /api/rtc/ice` — `src/routes/rtc.ts`\n\n**Completely untested.** The HMAC-SHA1 credential generation and `no-store` cache header are unverified.\n\n```ts\n// apps/api/tests/rtc.test.ts\nimport { createHmac } from \"node:crypto\";\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\ndeclare function sessionToken(userId: string): Promise<string>;\n\nconst get = (token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/rtc/ice\", {\n      headers: { cookie: `better-auth.session_token=${token}` },\n    }),\n  );\n\ndescribe(\"GET /api/rtc/ice\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await get(\"bad\");\n    expect(r.status).toBe(401);\n  });\n\n  it(\"always returns at least one STUN server\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    expect(r.status).toBe(200);\n    const { data } = await r.json() as { data: { iceServers: { urls: string[] }[]; ttl: number } };\n    expect(data.iceServers.length).toBeGreaterThanOrEqual(1);\n    expect(data.iceServers[0]!.urls.some((u) => u.startsWith(\"stun:\"))).toBe(true);\n  });\n\n  it(\"sets cache-control: private, no-store\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    expect(r.headers.get(\"cache-control\")).toContain(\"no-store\");\n  });\n\n  it(\"returns ttl matching 6-hour window\", async () => {\n    const token = await sessionToken(\"user-id\");\n    const r = await get(token);\n    const { data } = await r.json() as { data: { ttl: number } };\n    expect(data.ttl).toBe(6 * 60 * 60);\n  });\n\n  // Only runs when TURN_URLS + TURN_SECRET are set in the env\n  it.skipIf(!process.env.TURN_SECRET)(\n    \"TURN credentials use valid HMAC-SHA1 with coturn format\",\n    async () => {\n      const token = await sessionToken(\"user-id\");\n      const r = await get(token);\n      const { data } = await r.json() as {\n        data: { iceServers: { urls: string[]; username?: string; credential?: string }[] };\n      };\n      const turn = data.iceServers.find((s) => s.urls.some((u) => u.startsWith(\"turn:\")));\n      expect(turn).toBeDefined();\n      const [expiry, userId] = (turn!.username ?? \"\").split(\":\");\n      expect(Number(expiry)).toBeGreaterThan(Math.floor(Date.now() / 1000));\n      expect(userId).toBeTruthy();\n      // recompute expected credential\n      const expected = createHmac(\"sha1\", process.env.TURN_SECRET!)\n        .update(turn!.username!)\n        .digest(\"base64\");\n      expect(turn!.credential).toBe(expected);\n    },\n  );\n});\n```\n\n---\n\n### 7. Policy gaps — comments and reactions\n\n**No tests at all** for Comment and PostReaction/CommentReaction policies.\n\n```ts\n// extend policies.test.ts (or a new comments-reactions.test.ts)\ndescribe(\"comments\", () => {\n  it(\"non-member of a CLOSED group cannot comment on its posts\", async () => {\n    // bob is pending (before approval) — cannot post, so cannot comment either\n    await rejected(\n      as(\"bob\").comment.create({\n        data: { postId: closedGroupPostId, content: \"sneak\" },\n      }),\n    );\n  });\n\n  it(\"non-author cannot edit another's comment\", async () => {\n    const c = await as(\"alice\").comment.create({\n      data: { postId: postId, content: \"original\" },\n    });\n    await rejected(\n      as(\"bob\").comment.update({\n        where: { id: c.id },\n        data: { content: \"tampered\" },\n      }),\n    );\n  });\n\n  it(\"comment cannot be moved to a different post (post-update deny)\", async () => {\n    const c = await as(\"alice\").comment.create({\n      data: { postId: postId, content: \"here\" },\n    });\n    // any other post id in the same group\n    const other = await as(\"alice\").post.create({\n      data: { groupId: publicGroup, content: \"other\" },\n    });\n    await rejected(\n      as(\"alice\").comment.update({\n        where: { id: c.id },\n        data: { postId: other.id },\n      }),\n    );\n  });\n\n  it(\"post author can delete any comment on their post\", async () => {\n    const c = await as(\"bob\").comment.create({\n      data: { postId: postId, content: \"unwanted\" },\n    });\n    // alice is the post author\n    await expect(\n      as(\"alice\").comment.delete({ where: { id: c.id } }),\n    ).resolves.toBeDefined();\n  });\n});\n\ndescribe(\"post reactions\", () => {\n  it(\"user cannot react twice to the same post\", async () => {\n    await as(\"alice\").postReaction.create({\n      data: { postId: postId, type: \"LIKE\" },\n    });\n    await rejected(\n      as(\"alice\").postReaction.create({\n        data: { postId: postId, type: \"LOVE\" },\n      }),\n    );\n  });\n\n  it(\"non-member of CLOSED group cannot react to its posts\", async () => {\n    // bob is pending on closedGroup: cannot read posts, therefore cannot react\n    const closedPost = await as(\"alice\").post.findFirst({\n      where: { groupId: closedGroup },\n    });\n    await rejected(\n      as(\"bob\").postReaction.create({\n        data: { postId: closedPost!.id, type: \"LIKE\" },\n      }),\n    );\n  });\n\n  it(\"user can delete their own reaction\", async () => {\n    const r = await as(\"bob\").postReaction.create({\n      data: { postId: postId, type: \"HAHA\" },\n    });\n    await expect(\n      as(\"bob\").postReaction.delete({ where: { id: r.id } }),\n    ).resolves.toBeDefined();\n  });\n});\n```\n\n---\n\n### 8. Policy gap — closed poll after `closesAt`\n\n```ts\ndescribe(\"polls (closesAt)\", () => {\n  it(\"rejects votes on a closed poll\", async () => {\n    const post = await as(\"alice\").post.create({\n      data: {\n        groupId: publicGroup,\n        type: \"POLL\",\n        poll: {\n          create: {\n            question: \"Expired?\",\n            closesAt: new Date(Date.now() - 1000), // already past\n            options: { create: [{ text: \"Yes\" }] },\n          },\n        },\n      },\n      include: { poll: { include: { options: true } } },\n    });\n    const opt = post.poll!.options[0]!;\n    await rejected(\n      as(\"bob\").pollVote.create({\n        data: { pollId: post.poll!.id, optionId: opt.id },\n      }),\n    );\n  });\n\n  it(\"allows multiple votes on allowMultiple polls\", async () => {\n    const post = await as(\"alice\").post.create({\n      data: {\n        groupId: publicGroup,\n        type: \"POLL\",\n        poll: {\n          create: {\n            question: \"Multi?\",\n            allowMultiple: true,\n            options: { create: [{ text: \"A\" }, { text: \"B\" }] },\n          },\n        },\n      },\n      include: { poll: { include: { options: true } } },\n    });\n    const [optA, optB] = post.poll!.options;\n    await expect(\n      as(\"bob\").pollVote.create({ data: { pollId: post.poll!.id, optionId: optA!.id } }),\n    ).resolves.toBeDefined();\n    await expect(\n      as(\"bob\").pollVote.create({ data: { pollId: post.poll!.id, optionId: optB!.id } }),\n    ).resolves.toBeDefined();\n  });\n});\n```\n\n---\n\n### 9. Policy gap — Group deletion and `isDefault` immutability\n\n```ts\ndescribe(\"group deletion + isDefault\", () => {\n  it(\"non-admin cannot delete a group\", async () => {\n    await rejected(as(\"bob\").group.delete({ where: { id: publicGroup } }));\n  });\n\n  it(\"cannot delete the default group even as org admin\", async () => {\n    // need a group with isDefault=true — created by org hooks\n    // find it first\n    const def = await as(\"alice\").group.findFirst({\n      where: { organizationId: orgA, isDefault: true },\n    });\n    if (!def) return; // no default group in this test run\n    await rejected(as(\"alice\").group.delete({ where: { id: def.id } }));\n  });\n\n  it(\"isDefault field cannot be changed via update\", async () => {\n    await rejected(\n      as(\"alice\").group.update({\n        where: { id: publicGroup },\n        data: { isDefault: true },\n      }),\n    );\n  });\n});\n```\n\n---\n\n### 10. `guardExecute` — untested edge cases\n\n```ts\n// extend execute.test.ts (guardExecute describe block)\ndescribe(\"guardExecute edge cases\", () => {\n  it(\"take: 0 is treated as positive MAX_TAKE (sign of 0 defaults to 1)\", () => {\n    // Math.sign(0 || 1) === 1, so take=0 → MAX_TAKE (documents the current behavior)\n    expect(guardExecute(\"post\", \"findMany\", { take: 0 }).take).toBe(MAX_TAKE);\n  });\n\n  it(\"non-numeric take is replaced with MAX_TAKE\", () => {\n    expect(guardExecute(\"post\", \"findMany\", { take: \"all\" }).take).toBe(MAX_TAKE);\n    expect(guardExecute(\"post\", \"findMany\", { take: null }).take).toBe(MAX_TAKE);\n  });\n\n  it(\"does not modify take for non-findMany operators\", () => {\n    const args = guardExecute(\"post\", \"count\", { take: 999 });\n    // count doesn't cap: take passes through unmodified\n    expect(args.take).toBe(999);\n  });\n\n  it(\"allows all valid CRUD operators without throwing\", () => {\n    for (const op of [\"findMany\", \"findUnique\", \"findFirst\", \"create\", \"update\", \"delete\",\n                       \"count\", \"aggregate\", \"upsert\", \"deleteMany\", \"updateMany\"]) {\n      expect(() => guardExecute(\"post\", op, {})).not.toThrow();\n    }\n  });\n\n  it(\"all application models are in MODELS (spot-check)\", () => {\n    for (const m of [\"post\", \"comment\", \"group\", \"groupMember\", \"conversation\", \"message\",\n                     \"notification\", \"event\", \"attachment\", \"pollVote\"]) {\n      expect(MODELS.has(m)).toBe(true);\n    }\n  });\n});\n```\n\n---\n\n## Summary table\n\n| Gap | Severity | Type | Skeleton above |\n|---|---|---|---|\n| `toErrorResponse()` — all branches | **High** | Unit | Gap 1 |\n| `rateLimit()` — token bucket logic | **High** | Unit | Gap 2 |\n| `/api/execute` rate-limit HTTP path | Medium | Integration | Gap 3 |\n| `POST /api/conversations/direct` | **High** | Integration | Gap 4 |\n| `POST /api/uploads` MIME/orgVisible guards | **High** | Integration | Gap 5 |\n| `GET /api/rtc/ice` HMAC + headers | Medium | Integration | Gap 6 |\n| Comment policies (edit, move, non-member) | **High** | Policy | Gap 7 |\n| PostReaction/CommentReaction policies | **High** | Policy | Gap 7 |\n| Poll `closesAt` enforcement | Medium | Policy | Gap 8 |\n| Poll `allowMultiple` behavior | Medium | Policy | Gap 8 |\n| Group deletion and `isDefault` guard | Medium | Policy | Gap 9 |\n| `guardExecute` — `take:0`, non-numeric, non-findMany | Low | Unit | Gap 10 |\n| `MODELS` set completeness | Low | Unit | Gap 10 |\n\n**Highest-impact additions to make first:** Gaps 1 (error normalization), 4 (conversations route), 7 (comment/reaction policies) — these guard security-relevant invariants that are currently exercised only in production code paths.\n",
