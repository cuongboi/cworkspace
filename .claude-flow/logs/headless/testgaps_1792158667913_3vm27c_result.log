        "code": "// apps/api/tests/uploads.test.ts\nimport { describe, expect, it } from \"bun:test\";\nimport { app } from \"../src/app\";\n\n// shared helper — replace with test auth mechanism\ndeclare function sessionToken(userId: string): Promise<string>;\n\nconst post = (body: unknown, token: string) =>\n  app.handle(\n    new Request(\"http://localhost/api/uploads\", {\n      method: \"POST\",\n      headers: {\n        \"content-type\": \"application/json\",\n        cookie: `better-auth.session_token=${token}`,\n      },\n      body: JSON.stringify(body),\n    }),\n  );\n\ndescribe(\"POST /api/uploads\", () => {\n  it(\"requires authentication\", async () => {\n    const r = await post({ organizationId: \"x\", name: \"f.png\", mimeType: \"image/png\", size: 1 }, \"\");\n    expect(r.status).toBe(401);\n  });\n\n  // Storage is not configured in test env → 502\n  it(\"returns 502 when storage is not configured\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"f.png\", mimeType: \"image/png\", size: 1 },\n      token,\n    );\n    expect(r.status).toBe(502);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"UPSTREAM_ERROR\");\n  });\n\n  it(\"blocks executable MIME types\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    for (const mimeType of [\n      \"text/html\",\n      \"application/javascript\",\n      \"application/x-javascript\",\n      \"image/svg+xml\",\n      \"application/xhtml+xml\",\n    ]) {\n      const r = await post({ organizationId: \"org1\", name: \"evil\", mimeType, size: 1 }, token);\n      expect([400, 502]).toContain(r.status); // 400 if blocked before storage check\n      if (r.status === 400) {\n        const body = await r.json() as { error: { code: string } };\n        expect(body.error.code).toBe(\"INVALID_INPUT\");\n      }\n    }\n  });\n\n  it(\"rejects orgVisible=true for non-image MIME types\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"doc.pdf\", mimeType: \"application/pdf\", size: 1, orgVisible: true },\n      token,\n    );\n    expect(r.status).toBe(400);\n    const body = await r.json() as { error: { code: string } };\n    expect(body.error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"accepts orgVisible=true for image MIME types (would 502 on storage in test env)\", async () => {\n    const token = await sessionToken(\"some-user-id\");\n    const r = await post(\n      { organizationId: \"org1\", name: \"avatar.png\", mimeType: \"image/png\", size: 1, orgVisible: true },\n      token,\n    );\n    // 502 = passed MIME guard, failed on storage; 400 = MIME guard fired (wrong)\n    expect(r.status).not.toBe(400);\n  });\n});"
      },
