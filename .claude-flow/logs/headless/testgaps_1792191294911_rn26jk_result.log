        "content": "\n**`apps/api/src/websocket/hub.ts`** has zero test coverage. Room membership, broadcast deduplication, sender exclusion, and connection cleanup are all critical but never verified.\n\n```ts\n// apps/api/tests/websocket-hub.test.ts\nimport { describe, it, expect, beforeEach } from \"bun:test\";\nimport { Conn, emitTo, emitToUsers, emitToConn, joinUserToRoom, removeUserFromRoom, connectionCount, onlineUserIds, clearRoom } from \"../src/websocket/hub\";\n\n// Mock WebSocket — the real Bun.ServerWebSocket isn't available in test context\nfunction mockWs() {\n  const sent: string[] = [];\n  return { send: (msg: string) => sent.push(msg), sent };\n}\n\ndescribe(\"hub: room broadcasting\", () => {\n  it(\"does not deliver to sender's own socket\", () => {\n    const ws = mockWs();\n    const conn = new Conn(ws as any, { id: \"u1\", email: \"u1@test.com\", name: \"U1\", image: null, role: \"user\" });\n    conn.join(\"org:o1\");\n    const ws2 = mockWs();\n    const conn2 = new Conn(ws2 as any, { id: \"u2\", email: \"u2@test.com\", name: \"U2\", image: null, role: \"user\" });\n    conn2.join(\"org:o1\");\n\n    emitTo([\"org:o1\"], \"test:event\", { x: 1 }, conn);\n\n    expect(ws.sent).toHaveLength(0);   // sender excluded\n    expect(ws2.sent).toHaveLength(1);\n  });\n\n  it(\"deduplicates delivery for sockets in multiple matching rooms\", () => {\n    const ws = mockWs();\n    const conn = new Conn(ws as any, { id: \"u1\", email: \"u@t.com\", name: \"U\", image: null, role: \"user\" });\n    conn.join(\"group:g1\");\n    conn.join(\"user:u1\");\n\n    const sender = new Conn(mockWs() as any, { id: \"u2\", email: \"s@t.com\", name: \"S\", image: null, role: \"user\" });\n    sender.join(\"group:g1\");\n    sender.join(\"user:u1\");\n\n    emitTo([\"group:g1\", \"user:u1\"], \"test:event\", {}, sender);\n\n    expect(ws.sent).toHaveLength(1); // delivered once even though in both rooms\n  });\n\n  it(\"connectionCount returns 0 when no sockets in user room\", () => {\n    expect(connectionCount(\"u999\")).toBe(0);\n  });\n\n  it(\"connectionCount counts all sockets for a user\", () => {\n    const user = { id: \"u-multi\", email: \"m@t.com\", name: \"M\", image: null, role: \"user\" };\n    const c1 = new Conn(mockWs() as any, user as any);\n    const c2 = new Conn(mockWs() as any, user as any);\n    c1.join(`user:${user.id}`);\n    c2.join(`user:${user.id}`);\n    expect(connectionCount(user.id)).toBe(2);\n  });\n\n  it(\"onlineUserIds only includes users with active connections\", () => {\n    const user = { id: \"u-online\", email: \"o@t.com\", name: \"O\", image: null, role: \"user\" };\n    const conn = new Conn(mockWs() as any, user as any);\n    conn.join(\"org:o-online\");\n    conn.join(`user:${user.id}`);\n    const ids = onlineUserIds(\"o-online\");\n    expect(ids).toContain(user.id);\n  });\n\n  it(\"clearRoom empties the room without affecting other rooms\", () => {\n    // TODO: join two rooms, clearRoom on one, verify second room intact\n  });\n});\n```\n\n---\n\n",
        "level": 2
      },
      {
        "title": "2. Rate Limiter — Completely Untested",
        "content": "\n**`apps/api/src/server/rate-limit.ts`** has no tests. Capacity, refill, and the 50k bucket eviction are untested.\n\n```ts\n// apps/api/tests/rate-limit.test.ts\nimport { describe, it, expect } from \"bun:test\";\nimport { rateLimit } from \"../src/server/rate-limit\";\n\ndescribe(\"rateLimit\", () => {\n  it(\"allows requests up to capacity\", () => {\n    for (let i = 0; i < 5; i++) {\n      expect(rateLimit(\"test-key-1\", 5, 60_000)).toBe(true);\n    }\n  });\n\n  it(\"blocks request when over capacity\", () => {\n    for (let i = 0; i < 5; i++) rateLimit(\"test-key-2\", 5, 60_000);\n    expect(rateLimit(\"test-key-2\", 5, 60_000)).toBe(false);\n  });\n\n  it(\"different keys are independent\", () => {\n    for (let i = 0; i < 5; i++) rateLimit(\"key-a\", 5, 60_000);\n    expect(rateLimit(\"key-b\", 5, 60_000)).toBe(true); // key-b unaffected\n  });\n\n  it(\"tokens refill over time\", async () => {\n    const key = \"test-refill\";\n    for (let i = 0; i < 3; i++) rateLimit(key, 3, 100); // exhaust 100ms window\n    expect(rateLimit(key, 3, 100)).toBe(false);\n    await Bun.sleep(110);\n    expect(rateLimit(key, 3, 100)).toBe(true); // refilled after window\n  });\n\n  it(\"evicts buckets when count exceeds 50k\", () => {\n    // Stress-fill to trigger eviction; ensure no crash and new keys still work\n    for (let i = 0; i < 50_005; i++) rateLimit(`evict-${i}`, 1, 60_000);\n    expect(rateLimit(\"post-evict\", 1, 60_000)).toBe(true);\n  });\n});\n```\n\n---\n\n",
        "level": 2
