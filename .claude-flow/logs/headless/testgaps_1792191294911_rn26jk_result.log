      {
        "title": "3a. `POST /api/conversations/direct`",
        "content": "\n```ts\n// apps/api/tests/routes-conversations.test.ts\nimport { describe, it, expect, beforeAll } from \"bun:test\";\nimport { app } from \"../src/app\";\nimport { seedTestOrg } from \"./helpers/seed\"; // create if absent\n\ndescribe(\"POST /api/conversations/direct\", () => {\n  let session: string, orgId: string, userId: string, otherUserId: string;\n\n  beforeAll(async () => {\n    ({ session, orgId, userId, otherUserId } = await seedTestOrg());\n  });\n\n  it(\"creates a direct conversation\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", Cookie: session },\n        body: JSON.stringify({ organizationId: orgId, userId: otherUserId }),\n      })\n    );\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.id).toBeDefined();\n  });\n\n  it(\"is idempotent — returns same conversation on second call\", async () => {\n    const call = () =>\n      app.handle(\n        new Request(\"http://localhost/api/conversations/direct\", {\n          method: \"POST\",\n          headers: { \"Content-Type\": \"application/json\", Cookie: session },\n          body: JSON.stringify({ organizationId: orgId, userId: otherUserId }),\n        })\n      ).then((r) => r.json());\n\n    const [a, b] = await Promise.all([call(), call()]); // race condition test\n    expect(a.data.id).toBe(b.data.id);\n  });\n\n  it(\"rejects if target user is not in the org\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", Cookie: session },\n        body: JSON.stringify({ organizationId: orgId, userId: \"non-member-id\" }),\n      })\n    );\n    expect(res.status).toBe(403);\n  });\n\n  it(\"returns 401 without session\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/conversations/direct\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\" },\n        body: JSON.stringify({ organizationId: orgId, userId: otherUserId }),\n      })\n    );\n    expect(res.status).toBe(401);\n  });\n});\n```\n\n",
        "level": 3
