        "title": "3b. `POST /api/uploads`",
        "content": "\n```ts\n// apps/api/tests/routes-uploads.test.ts\ndescribe(\"POST /api/uploads\", () => {\n  it(\"rejects blocked mime type (text/html)\", async () => {\n    const res = await app.handle(\n      new Request(\"http://localhost/api/uploads\", {\n        method: \"POST\",\n        headers: { \"Content-Type\": \"application/json\", Cookie: session },\n        body: JSON.stringify({\n          organizationId: orgId,\n          name: \"payload.html\",\n          mimeType: \"text/html\",\n          size: 1024,\n        }),\n      })\n    );\n    expect(res.status).toBe(400);\n    const { error } = await res.json();\n    expect(error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"rejects file exceeding 25MB\", async () => {\n    const res = await app.handle(/* … size: 26 * 1024 * 1024 … */);\n    expect(res.status).toBe(400);\n  });\n\n  it(\"rejects image/svg+xml (blocked type)\", async () => { /* … */ });\n\n  it(\"accepts valid image upload and returns presigned fields\", async () => {\n    // Requires S3 env vars or mock; skip if SKIP_S3=1\n    const res = await app.handle(/* valid image/png, size: 1024 */);\n    expect(res.status).toBe(200);\n    const { data } = await res.json();\n    expect(data.attachment.id).toBeDefined();\n    expect(data.upload.url).toBeDefined();\n    expect(data.upload.fields).toBeDefined();\n  });\n\n  it(\"enforces rate limit (30/60s)\", async () => {\n    // exhaust 30 calls, 31st should 429\n  });\n});\n```\n\n",
