      {
        "title": "6. Realtime Plugin — Side Effects Untested",
        "content": "\nThe plugin's socket emissions and notification creation are only indirectly tested. Direct unit tests are missing.\n\n```ts\n// apps/api/tests/realtime-plugin.test.ts\nimport { describe, it, expect, mock } from \"bun:test\";\nimport { emitToRoom } from \"../src/websocket/hub\";\n\n// Intercept hub calls to verify broadcasts without needing real WS\nconst emitSpy = mock(emitToRoom);\n\ndescribe(\"realtime-plugin: Post mutations\", () => {\n  it(\"emits post:changed to group room on create\", async () => {\n    emitSpy.mockClear();\n    await db.post.create({ data: { groupId, authorId: userId, content: \"hello\" } });\n    expect(emitSpy).toHaveBeenCalledWith(\n      `group:${groupId}`,\n      \"post:changed\",\n      expect.objectContaining({ action: \"create\" })\n    );\n  });\n\n  it(\"notifies mentioned users on post create\", async () => {\n    const notifsBefore = await db.notification.count({ where: { userId: mentionedUserId } });\n    await db.post.create({ data: { /* content with @mention */ } });\n    const notifsAfter = await db.notification.count({ where: { userId: mentionedUserId } });\n    expect(notifsAfter).toBe(notifsBefore + 1);\n  });\n\n  it(\"does NOT notify self-mentions\", async () => {\n    // Post mentioning the author themselves — notification count unchanged\n  });\n});\n\ndescribe(\"realtime-plugin: GroupMember mutations\", () => {\n  it(\"joins user to group room on ACTIVE membership creation\", async () => { /* … */ });\n  it(\"removes user from group room on membership deletion\", async () => { /* … */ });\n  it(\"creates GROUP_JOIN_REQUEST notification for group admins\", async () => { /* … */ });\n  it(\"creates GROUP_JOIN_APPROVED notification for the approved user\", async () => { /* … */ });\n});\n```\n\n---\n\n",
