        "title": "5a. Execute endpoint error paths",
        "content": "\n```ts\n// Extend execute.test.ts\ndescribe(\"execute — error handling\", () => {\n  it(\"returns INVALID_INPUT for unknown model\", async () => {\n    const res = await executeAs(session, { model: \"secretTable\", operator: \"findMany\", args: {} });\n    expect(res.status).toBe(400);\n    const { error } = await res.json();\n    expect(error.code).toBe(\"INVALID_INPUT\");\n  });\n\n  it(\"returns INVALID_INPUT for unknown operator\", async () => {\n    const res = await executeAs(session, { model: \"post\", operator: \"rawQuery\", args: {} });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"returns INVALID_INPUT when args is not an object\", async () => {\n    const res = await executeAs(session, { model: \"post\", operator: \"findMany\", args: [1, 2, 3] });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"returns INVALID_INPUT when findMany.take is negative beyond MAX_TAKE\", async () => {\n    const res = await executeAs(session, {\n      model: \"post\",\n      operator: \"findMany\",\n      args: { take: -101 }, // below -MAX_TAKE\n    });\n    expect(res.status).toBe(400);\n  });\n\n  it(\"caps positive take at MAX_TAKE silently\", async () => {\n    const res = await executeAs(session, {\n      model: \"post\",\n      operator: \"findMany\",\n      args: { take: 999 },\n    });\n    expect(res.status).toBe(200); // succeeds but capped\n  });\n\n  it(\"returns 403 for banned user\", async () => {\n    // ban user via admin API, then attempt execute\n  });\n\n  it(\"returns 429 after 300 requests in 60s\", async () => {\n    // exhaust rate limit, verify 429 with RATE_LIMITED code\n  });\n});\n```\n\n",
