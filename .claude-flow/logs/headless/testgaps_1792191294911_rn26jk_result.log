        "title": "9. Storage Module — Untested",
        "content": "\n```ts\n// apps/api/tests/storage.test.ts\nimport { presignUpload, presignDownload, MAX_UPLOAD_BYTES } from \"../src/server/storage\";\n\n// These tests require a real or mock S3 endpoint — skip with SKIP_S3=1\n\ndescribe(\"storage.presignUpload\", () => {\n  it(\"rejects file above MAX_UPLOAD_BYTES\", async () => {\n    await expect(\n      presignUpload({ key: \"x\", mimeType: \"image/png\", size: MAX_UPLOAD_BYTES + 1 })\n    ).rejects.toThrow();\n  });\n\n  it(\"returns a url and fields object for valid input\", async () => {\n    const result = await presignUpload({ key: \"test/x.png\", mimeType: \"image/png\", size: 1024 });\n    expect(result.url).toMatch(/^https?:\\/\\//);\n    expect(result.fields).toBeDefined();\n  });\n});\n\ndescribe(\"storage.presignDownload\", () => {\n  it(\"returns inline disposition for image mime type\", async () => {\n    const url = await presignDownload({ key: \"x.png\", mimeType: \"image/png\", download: false });\n    expect(url).toContain(\"response-content-disposition=inline\");\n  });\n\n  it(\"returns attachment disposition when download=true\", async () => {\n    const url = await presignDownload({ key: \"x.pdf\", mimeType: \"application/pdf\", download: true });\n    expect(url).toContain(\"attachment\");\n  });\n});\n```\n\n---\n\n",
