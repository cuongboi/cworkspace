# ── Server / docker-compose ───────────────────────────
# public domain (setup.sh): Caddy site address and coturn realm
# DOMAIN=
# host address the MiniStack / StackPort ports bind to (default 127.0.0.1)
# BIND_ADDR=127.0.0.1

# ── Database ─────────────────────────────────────────────
# MiniStack RDS instance created by `ministack-init` (it prints the endpoint: docker compose logs ministack-init)
DATABASE_URL=postgresql://cworkplace:cworkplace@localhost:15432/cworkplace
# credentials docker-compose gives the RDS instance on first creation (keep in sync with DATABASE_URL)
POSTGRES_USER=cworkplace
POSTGRES_PASSWORD=cworkplace
POSTGRES_DB=cworkplace
# DB_LOG_QUERIES=true

# ── Auth (better-auth) ───────────────────────────────────
# generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_BASE_PATH=/api/auth
# allowed CORS / trusted origins (comma-separated); the first one is the web app's public URL
WEB_ORIGIN=http://localhost:5173

# ── Branding ─────────────────────────────────────────────
# shown in the tab title, link previews (Open Graph), the installed PWA and across the app
# APP_NAME="Acme Workplace"
# optional details as JSON: shortName, description, themeColor, backgroundColor (#hex),
# ogImage (path or URL, 1200x630), locale (en_US), twitterSite (@handle)
# APP_INFO='{"shortName":"Acme","description":"Groups, chat and calls for Acme","themeColor":"#09090b","ogImage":"/og.png"}'

# ── Email (Resend) ───────────────────────────────────────
# without a key, invitation / password-reset emails are printed to the API console
RESEND_API_KEY=
# MAIL_FROM="cworkplace <noreply@your-domain.com>"

# ── File storage (any S3-compatible: AWS S3, Cloudflare R2, MiniStack) ──
# uploads are disabled while these are empty
S3_ENDPOINT=http://localhost:4566
# browser-facing base for presigned URLs when S3 sits behind a reverse proxy (setup.sh: https://<domain>/s3)
# S3_PUBLIC_URL=
S3_REGION=us-east-1
S3_BUCKET=cworkplace
S3_ACCESS_KEY_ID=test
S3_SECRET_ACCESS_KEY=test

# ── WebRTC ───────────────────────────────────────────────
# STUN_URLS=stun:stun.l.google.com:19302
# TURN with time-limited credentials (coturn: use-auth-secret + static-auth-secret)
TURN_URLS=turn:localhost:3478?transport=udp,turn:localhost:3478?transport=tcp
TURN_SECRET=change-me-turn-secret
# coturn only (docker-compose): public IP advertised in relay candidates (setup.sh detects it) and relay port range
TURN_EXTERNAL_IP=
TURN_MIN_PORT=49152
TURN_MAX_PORT=65535

# ── Live call captions (Gemini Live) ─────────────────────
# without a key the CC button is disabled; model ids are overridable
GEMINI_API_KEY=
# GEMINI_TRANSCRIBE_MODEL=gemini-3.5-transcribe-live
# GEMINI_TRANSLATE_MODEL=gemini-3.8-live

# ── Push notifications (Firebase Cloud Messaging) ──
# Service account (Project settings → Service accounts → Generate key)
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
# Web app config (Project settings → General) and Web Push key pair (Cloud Messaging)
FIREBASE_API_KEY=
FIREBASE_APP_ID=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_VAPID_KEY=

# Channel integrations (webhooks / bot tokens)
# Trust X-Forwarded-For for IP allowlists (only behind your own reverse proxy)
TRUST_PROXY=false
# Allow outgoing webhooks to private/loopback hosts (local development only)
ALLOW_PRIVATE_WEBHOOKS=false
