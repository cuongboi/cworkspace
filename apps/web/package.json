{
  "name": "@app/web",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "dotenv -e ../../.env -- vite",
    "build": "tsc -b && rimraf ../api/src/public && dotenv -e ../../.env -- vite build && mkdir -p ../api/src/public && cp -rf dist/* $_",
    "lint": "eslint .",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "preview": "dotenv -e ../../.env -- vite preview",
    "check-types": "tsc --noEmit -p tsconfig.app.json"
  },
  "dependencies": {
    "@app/api": "*",
    "@app/shared": "workspace:*",
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@shadcn/react": "^0.3.1",
    "@tailwindcss/vite": "^4",
    "@tanstack/react-query": "^5.104.3",
    "better-auth": "^1.7.10",
    "class-variance-authority": "^0.7.1",
    "cmdk": "^1.1.1",
    "cn": "^0.4.0",
    "date-fns": "^4.4.0",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.5.0",
    "lucide-react": "^1.57.0",
    "next-themes": "^0.4.6",
    "nuqs": "^2.10.2",
    "radix-ui": "^1.8.1",
    "react": "^19.3.0",
    "react-day-picker": "^10.0.2",
    "react-dom": "^19.3.0",
    "react-resizable-panels": "^4.14.5",
    "react-router-dom": "^7.18.4",
    "recharts": "3.8.0",
    "rrule": "^2.8.1",
    "shadcn": "^4.21.5",
    "shiki": "^4.5.0",
    "sonner": "^2.0.8",
    "tailwindcss": "^4",
    "tw-animate-css": "^1.4.0",
    "vaul": "^1.1.2"
  },
  "devDependencies": {
    "@eslint/js": "^10",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitejs/plugin-react": "^6",
    "eslint": "^10",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "rimraf": "^6.1.3",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8",
    "vite": "^8"
  }
}
